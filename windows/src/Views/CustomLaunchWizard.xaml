<Window x:Class="YTray.Views.CustomLaunchWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="自定义启动" Width="720" Height="570"
        Background="White" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="22,22,22,0">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="自定义启动" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="本次参数独立生效；浏览器选择可在确认页记住" Foreground="#888" FontSize="11"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="Cancel_Click" Background="Transparent" BorderThickness="0" FontSize="16"/>
            </DockPanel>
        </Border>

        <!-- Step bar -->
        <StackPanel x:Name="StepPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="28,18,28,12">
            <StackPanel Orientation="Horizontal" x:Name="Step0Panel">
                <Ellipse x:Name="Step0Dot" Width="28" Height="28" Fill="#F28B44"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="运行时" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="选择浏览器" FontSize="9" Foreground="#AAA"/>
                </StackPanel>
            </StackPanel>
            <Rectangle Height="2" Width="30" Fill="#E0E0E0" VerticalAlignment="Center" Margin="8,0"/>
            <StackPanel Orientation="Horizontal" x:Name="Step1Panel">
                <Ellipse x:Name="Step1Dot" Width="28" Height="28" Fill="#E0E0E0"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="启动参数" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="调试与参数" FontSize="9" Foreground="#AAA"/>
                </StackPanel>
            </StackPanel>
            <Rectangle Height="2" Width="30" Fill="#E0E0E0" VerticalAlignment="Center" Margin="8,0"/>
            <StackPanel Orientation="Horizontal" x:Name="Step2Panel">
                <Ellipse x:Name="Step2Dot" Width="28" Height="28" Fill="#E0E0E0"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="插件" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="本地扩展" FontSize="9" Foreground="#AAA"/>
                </StackPanel>
            </StackPanel>
            <Rectangle Height="2" Width="30" Fill="#E0E0E0" VerticalAlignment="Center" Margin="8,0"/>
            <StackPanel Orientation="Horizontal" x:Name="Step3Panel">
                <Ellipse x:Name="Step3Dot" Width="28" Height="28" Fill="#E0E0E0"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="确认" FontSize="11" Foreground="#888"/>
                    <TextBlock Text="启动实例" FontSize="9" Foreground="#AAA"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Separator DockPanel.Dock="Top"/>

        <Grid x:Name="ContentArea" Margin="28,20"/>
        <Separator DockPanel.Dock="Bottom"/>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="20">
            <DockPanel>
                <Button Content="取消" DockPanel.Dock="Left" Padding="8,4" Click="Cancel_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PrevBtn" Content="上一步" Padding="8,4" Margin="0,0,8,0" Click="Prev_Click"/>
                    <Button x:Name="NextBtn" Content="下一步" Padding="8,4" Click="Next_Click" Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>