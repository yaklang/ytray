<Window x:Class="YTray.Views.BrowserEngineSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择浏览器接入目标" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="{DynamicResource AppBackgroundBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="浏览器启动后接入哪个应用？" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="请选择接入的应用，也可沿用插件现有的连接设置。YTray 会记住此实例的选择，恢复时沿用。" TextWrapping="Wrap" Margin="0,10,0,18"/>
        <ListBox x:Name="Targets" MaxHeight="320" SelectedIndex="0">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8">
                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" Opacity="0.65"/>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="所选应用离线时，插件会等待它，不会接入其他引擎。" Margin="0,14,0,18" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="76" Margin="0,0,10,0"/>
            <Button Content="确认并启动" IsDefault="True" Click="Confirm_Click" MinWidth="110" Style="{StaticResource YTrayPrimaryButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
