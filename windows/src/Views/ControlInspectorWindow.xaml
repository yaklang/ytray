<Window x:Class="YTray.Views.ControlInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTray · 本机应用分析 (UIA Inspector)" Width="1160" Height="760" MinWidth="790" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="InspectorButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="33"/>
            <Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="InspectorPrimaryButton" TargetType="Button" BasedOn="{StaticResource YTrayPrimaryButton}">
            <Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="33"/>
            <Setter Property="Padding" Value="16,0"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="InspectorAccentButton" TargetType="Button" BasedOn="{StaticResource OutlinedAccentButton}">
            <Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="33"/>
            <Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="InspectorPanel" TargetType="Border" BasedOn="{StaticResource SurfaceBorder}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
        <Style x:Key="CanvasButton" TargetType="Button" BasedOn="{StaticResource InspectorButton}">
            <Setter Property="Padding" Value="8,0"/><Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
        <Style x:Key="InspectorTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding Selected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Focusable="False" Width="16" Height="25" Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="Chevron" Data="M 0,0 L 4,3.5 L 0,7" StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Stroke="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="HeaderSurface" Grid.Column="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="6" Padding="6,3" MinHeight="25" Margin="0,1" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger SourceName="HeaderSurface" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Studio Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Path Data="M 2 4 L 8 1.5 L 14 4 L 8 6.5 Z M 2 8 L 8 10.5 L 14 8 M 2 11.8 L 8 14.3 L 14 11.8"
                      Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.5" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="本机应用分析 (UIA Inspector)" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="探测本机桌面窗口的原生 UI Automation 控件层级、屏幕坐标包围盒与实时截图"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RecentFailureButton" Click="RecentFailure_Click" Style="{StaticResource InspectorButton}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource DangerBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="最近失败"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource InspectorButton}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Path Data="M 2 5 C 3.6 2.4 6.8 1.5 9.5 2.8 M 9 0.8 L 10 3 L 7.6 3.5 M 14 11 C 12.4 13.6 9.2 14.5 6.5 13.2 M 7 15.2 L 6 13 L 8.4 12.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.45" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                        <TextBlock Text="刷新窗口列表"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Failure / Checkpoint Diagnostic Callout Banner -->
        <Border Grid.Row="1" x:Name="FailurePanel" Visibility="Collapsed" Style="{StaticResource InspectorPanel}"
                BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Margin="0,0,0,12" Padding="14,11">
            <StackPanel>
                <ListBox x:Name="TaskCalls" Visibility="Collapsed" SelectionChanged="TaskCall_Selected"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         Background="Transparent" BorderThickness="0" Margin="-3,0,-3,8" AutomationProperties.Name="任务步骤">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource YTrayControlListItem}">
                            <Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="3,0,3,4"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
                            <Setter Property="ToolTip" Value="{Binding Details}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel>
                    <Button x:Name="ViewTraceButton" DockPanel.Dock="Right" Content="查看调用" Click="ViewTrace_Click"
                            Visibility="Collapsed" Style="{StaticResource InspectorAccentButton}" Height="28" Padding="11,0" FontSize="11.5" Margin="10,0,0,0"/>
                    <TextBlock x:Name="FailureTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="FailureReason" Margin="0,5,0,0" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" MaxHeight="52"/>
                <TextBlock x:Name="FailureOutcome" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <ItemsControl x:Name="FailureSteps" Margin="0,7,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,3" Margin="0,2,6,0" CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding Label}" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Main Inspector Workbench -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*" MinWidth="506"/></Grid.ColumnDefinitions>

            <!-- Left Column: Desktop Windows List -->
            <Border Style="{StaticResource InspectorPanel}" Padding="10,12,10,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="6,0,6,9">
                        <Border DockPanel.Dock="Right" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}">
                            <TextBlock x:Name="WindowCountText" Text="0" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="当前桌面窗口" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="WindowList" Grid.Row="1" SelectionChanged="Window_Selected"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False"
                             ItemContainerStyle="{DynamicResource YTrayControlListItem}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10.5" Margin="7,10,4,4"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Details}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Visibility="{Binding FallbackIconVisibility}"/>
                                            <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Column: Target Toolbar + Split UIA Tree / Wireframe Canvas + Selected Element Inspector -->
            <Border Grid.Column="2" Style="{StaticResource InspectorPanel}" Padding="15,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <!-- Target Window Toolbar -->
                    <Border Style="{StaticResource SubtleCardBorder}" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="WindowTitleText" Text="选择窗口" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ObservationText" Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="AnalysisButton" Content="分析" Click="Analyze_Click" Style="{StaticResource InspectorPrimaryButton}"/>
                                <Button x:Name="ScreenshotButton" Content="查看截图" Click="Screenshot_Click" Style="{StaticResource InspectorButton}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Split Tree & Wireframe Canvas -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="254" MinWidth="164"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="230"/></Grid.ColumnDefinitions>

                        <!-- Left Sub-pane: UIA Control Layer Tree -->
                        <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="11,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="编号" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="UIA 控件图层树" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <TreeView x:Name="ControlTree" Grid.Row="1" SelectedItemChanged="Control_Selected" BorderThickness="0"
                                          Padding="6,6,4,6" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False">
                                    <TreeView.Resources><Style TargetType="TreeViewItem" BasedOn="{StaticResource InspectorTreeItem}"/></TreeView.Resources>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Grid ToolTip="{Binding Label}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Path Data="{Binding LayerIcon}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2"
                                                      Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LayerName}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Border Grid.Column="2" CornerRadius="4" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="5,1" Margin="8,0,2,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LayerNumber}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Border>

                        <!-- Drag-Resize Splitter with Visible Grip Pill -->
                        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="Transparent" Cursor="SizeWE" ResizeBehavior="PreviousAndNext">
                            <GridSplitter.Template>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Grid Background="Transparent">
                                        <Border x:Name="Grip" Width="3" Height="32" CornerRadius="1.5" Background="{DynamicResource HairlineBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource BrandOrangeBrush}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <!-- Right Sub-pane: Interactive Wireframe / Screenshot Viewport -->
                        <Grid x:Name="LayoutSlot" Grid.Column="2">
                            <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                                    BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource SurfaceMutedBrush}" Padding="11,0">
                                        <DockPanel>
                                            <StackPanel x:Name="CanvasControls" Orientation="Horizontal" DockPanel.Dock="Right" IsEnabled="False" VerticalAlignment="Center"
                                                        ToolTip="左键拖动画布，Ctrl + 滚轮缩放">
                                                <Button Content="−" Click="ZoomOut_Click" Style="{StaticResource CanvasButton}" AutomationProperties.Name="缩小"/>
                                                <Button x:Name="ZoomPercentButton" Content="100%" Click="ActualSize_Click" Style="{StaticResource CanvasButton}"
                                                        FontFamily="Cascadia Mono, Consolas" ToolTip="恢复 100% 原始比例" MinWidth="50" Margin="3,0"/>
                                                <Button Content="+" Click="ZoomIn_Click" Style="{StaticResource CanvasButton}" AutomationProperties.Name="放大"/>
                                                <Button x:Name="FitLayoutButton" Content="适应" Click="Fit_Click" Style="{StaticResource CanvasButton}" Margin="6,0,0,0"/>
                                                <Button x:Name="ExpandLayoutButton" Click="ExpandLayout_Click" Style="{StaticResource CanvasButton}"
                                                        ToolTip="放大查看布局" AutomationProperties.Name="放大查看布局" Margin="5,0,0,0">
                                                    <TextBlock x:Name="ExpandLayoutGlyph" Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="LayoutTitle" Text="窗口布局" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <Canvas x:Name="LayoutViewport" ClipToBounds="True" Cursor="Hand" SizeChanged="Viewport_SizeChanged"
                                                PreviewMouseWheel="Viewport_Wheel" PreviewMouseDown="Viewport_MouseDown"
                                                PreviewMouseMove="Viewport_MouseMove" PreviewMouseUp="Viewport_MouseUp" LostMouseCapture="Viewport_LostCapture">
                                            <Canvas.Background>
                                                <DrawingBrush TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,16,16"
                                                              ViewboxUnits="Absolute" Viewbox="0,0,16,16">
                                                    <DrawingBrush.Drawing>
                                                        <GeometryDrawing Brush="{DynamicResource HairlineBrush}">
                                                            <GeometryDrawing.Geometry><EllipseGeometry Center="2,2" RadiusX=".9" RadiusY=".9"/></GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Canvas.Background>
                                            <Grid x:Name="LayoutWorld" ClipToBounds="True" Visibility="Collapsed">
                                                <Canvas x:Name="LayoutCanvas"/>
                                                <Image x:Name="CaptureImage" Visibility="Collapsed" Stretch="Fill" AutomationProperties.Name="目标窗口截图"/>
                                            </Grid>
                                        </Canvas>

                                        <StackPanel x:Name="LayoutPlaceholderPanel" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260"
                                                    Visibility="{Binding Visibility, ElementName=LayoutPlaceholder}">
                                            <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource SurfaceRaisedBrush}"
                                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                                <Viewbox Width="20" Height="20">
                                                    <Path Data="M 2 3 L 14 3 L 14 13 L 2 13 Z M 2 6.5 L 14 6.5 M 6 6.5 L 6 13"
                                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.35" Fill="Transparent" StrokeLineJoin="Round"/>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock x:Name="LayoutPlaceholder" Text="选择窗口后点击「分析」。" Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="支持 Ctrl + 滚轮缩放、左键平移画布及单击线框定位控件" Margin="0,4,0,0" FontSize="11.5"
                                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Bottom Selected Node Property Bar -->
                    <Border Grid.Row="2" Margin="0,11,0,0" x:Name="SelectedPanel" Visibility="Collapsed"
                            Style="{StaticResource SubtleCardBorder}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SelectedTitle" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="SelectedMetadata" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="SelectedValue" FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource BrandOrangeBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="HighlightButton" Grid.Column="1" Content="在窗口高亮" Click="Highlight_Click" VerticalAlignment="Center" Style="{StaticResource InspectorAccentButton}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Visibility="{Binding Visibility, ElementName=InspectorStatus}" Style="{StaticResource SubtleCardBorder}" Padding="12,7" Margin="0,10,0,0">
            <TextBlock x:Name="InspectorStatus" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
