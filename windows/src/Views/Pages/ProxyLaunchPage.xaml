<Page x:Class="YTray.Views.Pages.ProxyLaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="25,20,25,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="代理与启动" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理预设代理、默认启动行为与浏览器网络隔离" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="SaveStatus" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                <Button Content="保存设置" MinWidth="110" Height="40" Click="Save_Click" Style="{StaticResource YTrayPrimaryButton}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="116"/><ColumnDefinition Width="12"/><ColumnDefinition Width="178"/><ColumnDefinition Width="12"/><ColumnDefinition Width="116"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="快速启动" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="RuntimeCombo" Grid.Column="1" Height="38" VerticalAlignment="Center"
                          DisplayMemberPath="DisplayTitle"/>
                <Button Grid.Column="3" Content="无代理启动" Click="Direct_Click"/>
                <Button Grid.Column="5" Content="使用 HTTP 代理启动" Click="Proxy_Click" Style="{StaticResource YTrayPrimaryButton}"/>
                <Button Grid.Column="7" Content="自定义启动" Click="Wizard_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceBorder}" Padding="18,17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/><RowDefinition Height="1"/><RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="预设 HTTP 代理" Style="{StaticResource SectionTitle}"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="协议" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SchemeCombo"><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="HTTPS"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="主机" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HostBox"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PortBox"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="用户名（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameBox"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="密码（可选）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PasswordBox"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="14"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="1" x:Name="CheckButton" Content="检测连接" Click="Check_Click"/>
                        <Button Grid.Column="3" Content="保存代理" Click="SaveProxy_Click" Style="{StaticResource YTrayPrimaryButton}"/>
                    </Grid>
                    <StackPanel Grid.Row="8" Orientation="Horizontal">
                        <Ellipse x:Name="ProxyDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0"/>
                        <TextBlock x:Name="ProxyStatus" Text="等待检测" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Row="10" Background="{DynamicResource HairlineBrush}"/>
                    <TextBlock Grid.Row="12" Text="最近使用" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="RecentProxyList" Grid.Row="13" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="10,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="HTTP" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button Grid.Column="1" Tag="{Binding}" Click="SelectProxy_Click" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left">
                                            <TextBlock Text="{Binding Server}" FontSize="12"/>
                                        </Button>
                                        <TextBlock Grid.Column="2" Text="›" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="18,17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="1"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="104"/><RowDefinition Height="9"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="默认启动" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="2"><TextBlock Text="启动地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HomeUrlBox"/></StackPanel>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="调试端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DebugPortBox"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="端口策略" Style="{StaticResource FieldLabel}"/><ComboBox SelectedIndex="0"><ComboBoxItem Content="占用时自动递增"/></ComboBox></StackPanel>
                    </Grid>
                    <Border Grid.Row="6" Background="{DynamicResource HairlineBrush}"/>
                    <StackPanel Grid.Row="8">
                        <TextBlock Text="浏览器网络行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="WebRtcCheck" Content="限制 WebRTC 非代理 UDP 与本地 IP 暴露" Margin="0,0,0,9"/>
                        <CheckBox x:Name="NotificationsCheck" Content="关闭浏览器通知" Margin="0,0,0,9"/>
                        <CheckBox x:Name="CertCheck" Content="忽略证书错误"/>
                    </StackPanel>
                    <Grid Grid.Row="9" Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="附加 Chrome 参数" Style="{StaticResource SectionTitle}"/><TextBlock Text="每行一个 --flag" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/></DockPanel>
                        <TextBox x:Name="FlagsBox" Grid.Row="2" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="11,9" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
                    </Grid>
                    <TextBlock Grid.Row="11" Text="实例隔离、调试端口、代理和插件参数由 YTray 管理" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
