<Page x:Class="YTray.Views.Pages.BrowserEnvironmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="新建模板" Click="New_Click" Style="{StaticResource YTrayPrimaryButton}"/>
                <TextBlock Text="浏览器环境" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ListBox x:Name="Templates" Style="{StaticResource YTraySurfaceListBox}" DisplayMemberPath="Name"
                         SelectionChanged="Templates_SelectionChanged" MinHeight="112" VerticalAlignment="Top"/>
                <Border Grid.Column="2" Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="模板名称" Margin="0,0,0,5"/>
                        <TextBox x:Name="NameBox" MaxLength="80" Margin="0,0,0,12"/>
                        <TextBlock Text="浏览器" Margin="0,0,0,5"/>
                        <ComboBox x:Name="RuntimeBox" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="语言" Margin="0,0,0,5"/><TextBox x:Name="LanguageBox" ToolTip="例如 zh-CN 或 en-US。留空使用浏览器默认语言。"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="时区" Margin="0,0,0,5"/><TextBox x:Name="TimeZoneBox" ToolTip="例如 Asia/Shanghai。留空使用系统时区。"/></StackPanel>
                        </Grid>
                        <TextBlock Text="窗口大小（像素，留空使用默认值）" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="WindowWidthBox" AutomationProperties.Name="窗口宽度"/>
                            <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="WindowHeightBox" AutomationProperties.Name="窗口高度"/>
                        </Grid>
                        <TextBlock Text="页面视口（像素，留空随窗口变化）" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ViewportWidthBox" AutomationProperties.Name="页面视口宽度"/>
                            <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="ViewportHeightBox" AutomationProperties.Name="页面视口高度"/>
                        </Grid>
                        <TextBlock Text="网络" Margin="0,0,0,5"/>
                        <ComboBox x:Name="NetworkBox" Margin="0,0,0,16"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="保存模板" Click="Save_Click" Style="{StaticResource YTrayPrimaryButton}"/>
                            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="删除" Click="Delete_Click" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="实例生效值" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="ReadButton" Content="读取当前标签页" Margin="8,0,0,0" Click="Read_Click"/>
                        <ComboBox x:Name="InstanceBox" DropDownOpened="InstanceBox_DropDownOpened"/>
                    </DockPanel>
                    <TextBlock x:Name="Observed" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
