<Page x:Class="YTray.Views.Pages.QuickLaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="OverviewFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="OverviewTableHeader" TargetType="TextBlock" BasedOn="{StaticResource TableHeaderText}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="OverviewTableCell" TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="OverviewButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="OverviewPrimaryButton" TargetType="Button" BasedOn="{StaticResource YTrayPrimaryButton}">
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
    </Page.Resources>
    <Grid Margin="25,21,25,20">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="350"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="运行中心" Style="{StaticResource PageTitle}" FontSize="27"/>
            <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                <Ellipse x:Name="LaunchStatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0"/>
                <TextBlock x:Name="LaunchStatusLabel" Text="0 个实例运行中" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.98*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceBorder}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="18,0">
                        <TextBlock Text="运行中的实例" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RunningCountLabel" Text="共 0 个实例" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>
                    <Border Grid.Row="1" Margin="7,0" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,1,1,1">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="64"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="82"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
                            <TextBlock Text="浏览器" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="1" Text="实例" Style="{StaticResource OverviewTableHeader}"/>
                            <TextBlock Grid.Column="2" Text="页面标题 / 地址" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="3" Text="网络模式" Style="{StaticResource OverviewTableHeader}"/>
                            <TextBlock Grid.Column="4" Text="调试端口" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="5" Text="运行时长" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="6" Text="操作" Style="{StaticResource OverviewTableHeader}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <StackPanel x:Name="RunningEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="暂无运行中的实例" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="从右侧创建第一个独立浏览器实例" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="RunningList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="7,0" MinHeight="70" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,1,1">
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="64"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="82"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
                                                <Image Source="{Binding RuntimeIconSource}" Width="32" Height="32" HorizontalAlignment="Left"/>
                                                <Border Grid.Column="1" Width="31" Height="31" HorizontalAlignment="Left" CornerRadius="5" BorderBrush="{DynamicResource BrandOrangeBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding DockBadge}" Foreground="{DynamicResource BrandOrangeBrush}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding PageTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PageUrl}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding NetworkMode}" FontSize="12.5"/><TextBlock Text="{Binding NetworkAddress}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"/></StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding DebugPort, StringFormat=端口 {0}}" Style="{StaticResource OverviewTableCell}"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Duration}" Style="{StaticResource OverviewTableCell}"/>
                                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="聚焦" Padding="10,0" Height="32" Margin="0,0,7,0" Tag="{Binding Instance}" Click="Focus_Click" Style="{StaticResource OverviewButton}"/><Button Content="停止" Padding="10,0" Height="32" Tag="{Binding Instance}" Click="Stop_Click" Style="{StaticResource OutlinedAccentButton}" FontSize="13"/></StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="18,15">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="Auto"/><RowDefinition Height="9"/><RowDefinition Height="Auto"/><RowDefinition Height="9"/><RowDefinition Height="Auto"/><RowDefinition Height="13"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                    <TextBlock Text="新建实例" Style="{StaticResource SectionTitle}" FontSize="15"/>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="浏览器" Style="{StaticResource OverviewFieldLabel}"/>
                        <ComboBox x:Name="RuntimeCombo" Height="42"
                                  PreviewMouseLeftButtonDown="ChoiceCombo_PreviewMouseLeftButtonDown"
                                  SelectionChanged="RuntimeCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="28">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Image Source="{Binding IconSource}" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Version}" Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="4">
                        <TextBlock Text="网络" Style="{StaticResource OverviewFieldLabel}"/>
                        <ComboBox x:Name="NetworkCombo" Height="46" SelectedIndex="1"
                                  PreviewMouseLeftButtonDown="ChoiceCombo_PreviewMouseLeftButtonDown">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="6"><TextBlock Text="启动地址" Style="{StaticResource OverviewFieldLabel}"/><TextBox x:Name="HomeUrlBox" Height="42" Text="https://example.com" FontSize="13" FontWeight="SemiBold" Padding="12,6"/></StackPanel>
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.28*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                        <Button x:Name="LaunchButton" Content="启动实例" Click="Launch_Click" Style="{StaticResource OverviewPrimaryButton}"/>
                        <Button x:Name="WizardBtn" Grid.Column="2" Content="自定义配置" Click="Wizard_Click" Style="{StaticResource OverviewButton}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SurfaceBorder}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="17,0"><TextBlock Text="最近会话" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center"/><Button Content="清除全部" Click="ClearAll_Click" Style="{StaticResource YTrayGhostButton}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}"/></Grid>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1">
                    <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <TextBlock Text="最近使用" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="1" Text="浏览器" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="2" Text="实例" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="3" Text="页面标题 / 地址" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="4" Text="网络模式" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="5" Text="调试端口" Style="{StaticResource OverviewTableHeader}"/><TextBlock Grid.Column="6" Text="操作" Style="{StaticResource OverviewTableHeader}"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <TextBlock x:Name="HistoryEmpty" Text="暂无最近会话" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border MinHeight="54" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="90"/><ColumnDefinition Width="75"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LastUsed}" Style="{StaticResource OverviewTableCell}" Foreground="{DynamicResource TextSecondaryBrush}"/><Image Grid.Column="1" Source="{Binding RuntimeIconSource}" Width="30" Height="30" HorizontalAlignment="Left"/>
                                    <Border Grid.Column="2" Width="28" Height="28" HorizontalAlignment="Left" CornerRadius="5" BorderBrush="{DynamicResource BrandOrangeBrush}" BorderThickness="1"><TextBlock Text="{Binding DockBadge}" Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="{Binding PageTitle}" FontSize="12.5" FontWeight="SemiBold"/><TextBlock Text="{Binding PageUrl}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"/></StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="{Binding NetworkMode}" FontSize="12"/><TextBlock Text="{Binding NetworkAddress}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/></StackPanel>
                                    <TextBlock Grid.Column="5" Text="{Binding DebugPort, StringFormat=端口 {0}}" Style="{StaticResource OverviewTableCell}"/><Button Grid.Column="6" Height="32" HorizontalAlignment="Left" Tag="{Binding Instance}" Click="Restore_Click" Style="{StaticResource OutlinedAccentButton}"><TextBlock Text="恢复" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrandOrangeBrush}"/></Button>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
