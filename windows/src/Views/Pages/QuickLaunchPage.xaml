<Page x:Class="YTray.Views.Pages.QuickLaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Background="{DynamicResource RegionBrush}">
    <ScrollViewer>
        <StackPanel Margin="28">
            <TextBlock Text="快速配置" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="选择直连或预设 HTTP 代理启动；每个实例仍使用独立用户目录。" Foreground="#888" Margin="0,5,0,24"/>

            <UniformGrid Columns="3" Margin="0,0,0,24">
                <Border Background="#FFF6EE" CornerRadius="14" Padding="18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="🚫" FontSize="24"/>
                        <TextBlock Text="无代理启动" FontWeight="Bold" Margin="0,13,0,5"/>
                        <TextBlock Text="忽略预设代理，以直连方式创建新的独立实例" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
                        <Button x:Name="DirectBtn" Content="无代理启动" Margin="0,13,0,0" Padding="9,6" Click="Direct_Click"
                                Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFF6EE" CornerRadius="14" Padding="18" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="🌐" FontSize="24"/>
                        <TextBlock Text="使用 HTTP 代理" FontWeight="Bold" Margin="0,13,0,5"/>
                        <TextBlock Text="使用托盘中保存的预设代理创建新的独立实例" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
                        <Button x:Name="ProxyBtn" Content="使用代理启动" Margin="0,13,0,0" Padding="9,6" Click="Proxy_Click"
                                Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
                    </StackPanel>
                </Border>
                <Border Background="#FFF6EE" CornerRadius="14" Padding="18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="✨" FontSize="24"/>
                        <TextBlock Text="自定义启动" FontWeight="Bold" Margin="0,13,0,5"/>
                        <TextBlock Text="通过步骤向导配置本次运行，不覆盖默认设置" TextWrapping="Wrap" Foreground="#888" FontSize="11"/>
                        <Button x:Name="WizardBtn" Content="开始配置" Margin="0,13,0,0" Padding="9,6" Click="Wizard_Click"
                                Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Background="White" BorderThickness="1" BorderBrush="#E8E8E8" CornerRadius="10" Padding="16" Margin="0">
                <StackPanel>
                    <TextBlock Text="当前默认配置" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="运行时" Foreground="#888" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RuntimeLabel" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="启动地址" Foreground="#888" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HomeUrlLabel" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="调试端口" Foreground="#888" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DebugPortLabel" Margin="0,0,0,12"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="插件" Foreground="#888"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PluginLabel"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>