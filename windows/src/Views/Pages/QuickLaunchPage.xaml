<Page x:Class="YTray.Views.Pages.QuickLaunchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,21,24,24">
            <DockPanel Margin="0,0,0,18">
                <Border DockPanel.Dock="Right" CornerRadius="12" Padding="9,4" Background="{StaticResource SuccessPaleBrush}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LaunchStatusDot" Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LaunchStatusLabel" Text="准备就绪" FontSize="10.5" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock Text="快速配置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="选择启动方式；每个实例使用独立用户目录。" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.72*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*" MinWidth="215"/>
                </Grid.ColumnDefinitions>

                <!-- Actions are rows rather than three oversized dashboard cards. -->
                <Border Grid.Column="0" Style="{StaticResource SurfaceBorder}">
                    <StackPanel>
                        <DockPanel Margin="16,13,16,10">
                            <TextBlock Text="启动方式" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="选择后立即创建实例" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource HairlineBrush}"/>

                        <Grid Margin="15,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource BrandPaleBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource BrandOrangeBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="无代理启动" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="直连网络，忽略已保存的代理" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="DirectBtn" Grid.Column="2" Content="立即启动" Width="82" Height="30"
                                    Style="{StaticResource YTrayButton}" Click="Direct_Click"/>
                        </Grid>

                        <Border Height="1" Margin="15,0" Background="{StaticResource HairlineBrush}"/>
                        <Grid Margin="15,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource BrandPaleBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource BrandOrangeBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="使用 HTTP 代理" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProxySummaryLabel" Text="使用托盘中保存的预设代理" FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="ProxyBtn" Grid.Column="2" Content="代理启动" Width="82" Height="30"
                                    Style="{StaticResource YTrayPrimaryButton}" Click="Proxy_Click"/>
                        </Grid>

                        <Border Height="1" Margin="15,0" Background="{StaticResource HairlineBrush}"/>
                        <Grid Margin="15,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="自定义启动" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="逐步选择浏览器、参数与插件" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="WizardBtn" Grid.Column="2" Content="开始配置" Width="82" Height="30"
                                    Style="{StaticResource YTrayButton}" Click="Wizard_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SurfaceBorder}" Padding="15,13">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,13">
                                <TextBlock Text="当前默认配置" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextTertiaryBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="31" Height="31" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                    <Image x:Name="RuntimeIcon" Width="23" Height="23" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="运行时" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                                    <TextBlock x:Name="RuntimeLabel" Margin="0,2,0,0" FontSize="11.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="启动地址" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="HomeUrlLabel" Margin="0,2,0,11" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                            <TextBlock Text="调试端口" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="DebugPortLabel" Margin="0,2,0,11" FontSize="11.5"/>
                            <TextBlock Text="默认插件" FontSize="9.5" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="PluginLabel" Margin="0,2,0,0" FontSize="11.5"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="13,11" Background="{StaticResource BrandPaleBrush}" CornerRadius="9">
                        <DockPanel>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource BrandOrangeBrush}"
                                       Margin="0,1,9,0"/>
                            <TextBlock Text="代理地址可在托盘小组件中修改。" TextWrapping="Wrap" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" LineHeight="17"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
