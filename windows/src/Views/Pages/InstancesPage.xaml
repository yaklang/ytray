<Page x:Class="YTray.Views.Pages.InstancesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:YTray.Views"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="InstanceSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="14.5"/>
        </Style>
        <Style x:Key="InstanceSegmentedTab" TargetType="Button" BasedOn="{StaticResource YTrayGhostButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="InstanceCardItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Padding="14,11" CornerRadius="9"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InstanceActionButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Height" Value="29"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="InstanceAccentActionButton" TargetType="Button" BasedOn="{StaticResource OutlinedAccentButton}">
            <Setter Property="Height" Value="29"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="NetworkPillBorder" TargetType="Border" BasedOn="{StaticResource PillBadge}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesProxy}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NetworkPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesProxy}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrandOrangeBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="浏览器实例" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理正在运行的隔离实例与可一键恢复的身份历史" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ActionFeedbackBorder" Visibility="Collapsed" Padding="11,7" Margin="0,0,10,0"
                        CornerRadius="8" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <TextBlock x:Name="ActionFeedbackText" FontSize="11.5"/>
                </Border>
                <Border Padding="12,6" CornerRadius="14" Background="{DynamicResource SuccessPaleBrush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RunningCountLabel" Text="0 运行中" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="12,6" Margin="8,0,12,0" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HistoryCountLabel" Text="0 历史" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Button Content="新建实例" Click="NewInstance_Click" MinWidth="112" Height="38"
                        FontSize="13" Style="{StaticResource YTrayPrimaryButton}"/>
            </StackPanel>
        </Grid>

        <!-- Master-Detail Two-Card Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.56*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

            <!-- Left Master Card: Rich Instance Card Stream -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceBorder}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="AllTab" Content="全部" Tag="all" Click="Tab_Click" Style="{StaticResource InstanceSegmentedTab}"/>
                                    <Button x:Name="RunningTab" Grid.Column="1" Content="运行中" Tag="running" Click="Tab_Click" Style="{StaticResource InstanceSegmentedTab}"/>
                                    <Button x:Name="HistoryTab" Grid.Column="2" Content="历史" Tag="history" Click="Tab_Click" Style="{StaticResource InstanceSegmentedTab}"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Column="2">
                                <TextBox x:Name="SearchBox" Height="36" MinHeight="0" Padding="34,0,10,0" FontSize="12.5" TextChanged="Search_Changed"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="搜索实例名、网页标题或地址…" Margin="35,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"/>
                                <Path Data="M 6.5 1.5 A 5 5 0 1 1 6.49 1.5 M 10.2 10.2 L 14 14" Width="15" Height="15"
                                      Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.4" Fill="Transparent" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14,16,12">
                            <!-- Running Section -->
                            <StackPanel x:Name="RunningSection">
                                <TextBlock x:Name="RunningHeading" Text="运行中（0）" Style="{StaticResource InstanceSectionTitle}" Margin="2,0,0,10"/>
                                <Border x:Name="RunningEmpty" Style="{StaticResource SubtleCardBorder}" MinHeight="74" Margin="0,0,0,8">
                                    <TextBlock Text="暂无运行中的浏览器实例" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Border>
                                <ListBox x:Name="RunningList" SelectionChanged="InstanceSelection_Changed" ItemContainerStyle="{StaticResource InstanceCardItem}"
                                         BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding InstanceIconSource}" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,12,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Border Style="{StaticResource PillBadge}" Background="{DynamicResource SuccessPaleBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="运行中" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource NetworkPillBorder}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NetworkBadgeLabel}" Style="{StaticResource NetworkPillText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource CodeBadgeBorder}" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DebugPortTag}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding PageTitle, Mode=OneWay}" FontWeight="Medium"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding PageUrl, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                        <Run Text="PID "/>
                                                        <Run Text="{Binding ProcessID, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Instance.EngineTargetSummary, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="聚焦" Tag="{Binding Instance}" Click="FocusRow_Click" Style="{StaticResource InstanceActionButton}" Margin="0,0,6,0"/>
                                                    <Button Content="停止" Tag="{Binding Instance}" Click="StopRow_Click" IsEnabled="{Binding CanStop}" Style="{StaticResource YTrayDangerOutlineButton}" Height="29" MinHeight="0" Padding="11,0" FontSize="12"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- History Section -->
                            <StackPanel x:Name="HistorySection" Margin="0,12,0,0">
                                <DockPanel Margin="2,0,0,10">
                                    <TextBlock x:Name="HistoryHeading" Text="历史（0）" Style="{StaticResource InstanceSectionTitle}" VerticalAlignment="Center"/>
                                    <Button Content="清理全部" DockPanel.Dock="Right" Click="ClearAll_Click" Style="{StaticResource YTrayGhostButton}"
                                            FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Height="28" MinHeight="0" Padding="8,0"/>
                                </DockPanel>
                                <Border x:Name="HistoryEmpty" Style="{StaticResource SubtleCardBorder}" MinHeight="70">
                                    <TextBlock Text="暂无历史实例" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Border>
                                <ListBox x:Name="HistoryList" SelectionChanged="InstanceSelection_Changed" ItemContainerStyle="{StaticResource InstanceCardItem}"
                                         BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding InstanceIconSource}" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,12,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LastUsed}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Border Style="{StaticResource NetworkPillBorder}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding NetworkBadgeLabel}" Style="{StaticResource NetworkPillText}"/>
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Margin="0,5,0,0" FontSize="12" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding PageTitle, Mode=OneWay}" FontWeight="Medium"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding PageUrl, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="恢复" Tag="{Binding Instance}" Click="Restore_Click" Style="{StaticResource InstanceAccentActionButton}"/>
                                                    <Button Content="删除" Tag="{Binding Instance}" Click="DeleteHistory_Click" Margin="6,0,0,0" Style="{StaticResource InstanceActionButton}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Detail Inspector Card (Action-First!) -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="20,17">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="实例详情" Style="{StaticResource InstanceSectionTitle}"/>

                    <StackPanel x:Name="DetailEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                        <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Path Data="M 2 2.5 L 14 2.5 L 14 13.5 L 2 13.5 Z M 5 5.5 L 11 5.5 M 5 8 L 11 8 M 5 10.5 L 9 10.5"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.25" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="选择一个实例查看详情" Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="从左侧卡片列表点击任一实例，查看实时缩略图、隔离目录与完整调试信息" Margin="0,6,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer x:Name="DetailContent" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Identity & Engine Connection Card -->
                            <Border Style="{StaticResource SubtleCardBorder}" Padding="12,10" Margin="0,0,0,12" DataContext="{Binding Tag, ElementName=DetailContent}">
                                <StackPanel>
                                    <DockPanel>
                                        <Image Source="{Binding InstanceIconSource}" Width="36" Height="36" Margin="0,0,11,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding IdentityBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DockBadge, StringFormat=Profile {0}}" Foreground="{Binding IdentityForegroundBrush}" FontSize="11.5" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="EngineConnectionStatus" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border x:Name="EngineConnectionActions" Margin="0,10,0,0" Padding="0,9,0,0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                                        <DockPanel>
                                            <Button x:Name="ApplyEngineButton" DockPanel.Dock="Right" Content="应用" Height="31" MinHeight="0" Padding="12,0" Margin="6,0,0,0"
                                                    Style="{StaticResource OutlinedAccentButton}" FontSize="12" Click="ApplyEngine_Click"/>
                                            <views:BrowserEnginePicker x:Name="EnginePicker" Height="31" Padding="10,0,4,0" FontSize="12" AutomationProperties.Name="实例接入应用"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Live Preview -->
                            <Border x:Name="DetailPreviewFrame" Height="156" CornerRadius="9" ClipToBounds="True"
                                    SizeChanged="RoundedPreview_SizeChanged" SnapsToDevicePixels="True"
                                    Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                <Grid x:Name="DetailPreview">
                                    <Image x:Name="DetailThumbnail" Stretch="UniformToFill"/>
                                    <StackPanel x:Name="DetailPreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Viewbox Width="26" Height="22">
                                            <Path Data="M 1.5 2.5 L 14.5 2.5 L 14.5 12.5 L 1.5 12.5 Z M 3.5 10 L 6.2 7.3 L 8.2 9.1 L 10.1 6.9 L 13 10"
                                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.2" Fill="Transparent"/>
                                        </Viewbox>
                                        <TextBlock x:Name="DetailPreviewMessage" Text="等待页面预览" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Action Bar Promoted Directly Below Preview! -->
                            <Grid Margin="0,12,0,0" Height="34">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="FocusDetailButton" Click="FocusDetail_Click" Style="{StaticResource InstanceActionButton}" Height="34">
                                    <StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="M 1.5 2.5 L 14.5 2.5 L 14.5 12.5 L 1.5 12.5 Z M 5 14.5 L 11 14.5 M 8 12.5 L 8 14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/></Viewbox><TextBlock Text="聚焦窗口"/></StackPanel>
                                </Button>
                                <Button Grid.Column="2" x:Name="CaptureDetailButton" Click="CaptureDetail_Click" Style="{StaticResource InstanceActionButton}" Height="34">
                                    <StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="M 1.5 5 L 4.4 5 L 5.6 3.2 L 10.4 3.2 L 11.6 5 L 14.5 5 L 14.5 13 L 1.5 13 Z M 8 6.4 A 2.2 2.2 0 1 0 8 10.8 A 2.2 2.2 0 1 0 8 6.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/></Viewbox><TextBlock Text="截图"/></StackPanel>
                                </Button>
                                <Button Grid.Column="4" x:Name="RevealDetailButton" Click="RevealDetail_Click" Style="{StaticResource InstanceActionButton}" Height="34">
                                    <StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="M 1.5 4 L 6.2 4 L 7.7 5.5 L 14.5 5.5 L 14.5 13.5 L 1.5 13.5 Z M 1.5 5.5 L 1.5 2.5 L 6 2.5 L 7.2 4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/></Viewbox><TextBlock Text="打开目录"/></StackPanel>
                                </Button>
                            </Grid>

                            <Button x:Name="StopDetailButton" Height="34" MinHeight="0" Margin="0,8,0,0" Click="StopDetail_Click"
                                    Style="{StaticResource YTrayDangerOutlineButton}" FontSize="12.5">
                                <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,7,0"><Path Data="M 2 2 L 14 2 L 14 14 L 2 14 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent"/></Viewbox><TextBlock Text="停止实例"/></StackPanel>
                            </Button>
                            <Button x:Name="RestoreDetailButton" Height="34" MinHeight="0" Margin="0,8,0,0" Click="RestoreDetail_Click"
                                    Style="{StaticResource YTrayPrimaryButton}" FontSize="12.5" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,7,0"><Path Data="M 3.3 5.2 L 1 5.2 L 1 2.9 M 1.4 5 C 2.6 2.3 5.9 1.1 8.8 2.1 C 12 3.2 13.7 6.8 12.6 10 C 11.5 13.2 7.9 14.9 4.7 13.8 C 3 13.2 1.7 12 1 10.5" Stroke="White" StrokeThickness="1.3" Fill="Transparent"/></Viewbox><TextBlock Text="恢复实例" Foreground="White"/></StackPanel>
                            </Button>

                            <!-- Metadata Card -->
                            <Border Style="{StaticResource SubtleCardBorder}" Padding="13,8" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="102"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="浏览器" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailRuntime" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                    <TextBlock Grid.Row="1" Text="实例名称" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailName" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                    <TextBlock Grid.Row="2" Text="AppUserModelID" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailAumid" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    <TextBlock Grid.Row="3" Text="用户数据目录" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailProfile" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    <TextBlock Grid.Row="4" Text="浏览器版本" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailVersion" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                    <TextBlock Grid.Row="5" Text="启动网络" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailProxy" Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}" ToolTip="仅显示启动配置；运行中的实际代理以浏览器插件显示为准。"/>
                                    <TextBlock Grid.Row="6" Text="调试端口" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailDebug" Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}" FontFamily="Cascadia Mono, Consolas"/>
                                    <TextBlock Grid.Row="7" Text="插件" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailPlugins" Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
