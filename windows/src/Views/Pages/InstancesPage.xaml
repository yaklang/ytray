<Page x:Class="YTray.Views.Pages.InstancesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="25,20,25,20">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="浏览器实例" Style="{StaticResource PageTitle}"/><TextBlock Text="管理运行中的实例与可恢复历史" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                <Border Padding="12,7" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock x:Name="RunningCountLabel" Text="0 运行中" Foreground="{DynamicResource SuccessBrush}"/></StackPanel></Border>
                <Border Padding="12,7" Margin="8,0,0,0" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"><TextBlock x:Name="HistoryCountLabel" Text="0 历史" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border x:Name="ActionFeedbackBorder" Visibility="Collapsed" Padding="10,7" Margin="0,0,10,0" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"><TextBlock x:Name="ActionFeedbackText" FontSize="10.5"/></Border>
                <Button Content="新建实例" Click="NewInstance_Click" MinWidth="116" Height="40" Style="{StaticResource YTrayPrimaryButton}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" Style="{StaticResource SurfaceBorder}"/>
            <Grid Grid.Column="0" Margin="0">
                <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="17,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="AllTab" Content="全部" Tag="all" Click="Tab_Click" Style="{StaticResource OutlinedAccentButton}"/>
                            <Button x:Name="RunningTab" Grid.Column="1" Content="运行中" Tag="running" Click="Tab_Click"/>
                            <Button x:Name="HistoryTab" Grid.Column="2" Content="历史" Tag="history" Click="Tab_Click"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="2"><TextBox x:Name="SearchBox" Padding="35,6,10,6" TextChanged="Search_Changed"/><TextBlock x:Name="SearchPlaceholder" Text="搜索标题或地址" Margin="36,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"/><Path Data="M 6.5 1.5 A 5 5 0 1 1 6.49 1.5 M 10.2 10.2 L 14 14" Width="16" Height="16" Margin="12,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.4" Fill="Transparent"/></Grid>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="17,3,17,17">
                        <TextBlock x:Name="RunningHeading" Text="运行中（0）" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="RunningEmpty" Text="暂无运行中的浏览器实例" Height="64" TextAlignment="Center" Padding="0,22,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ListBox x:Name="RunningList" SelectionChanged="InstanceSelection_Changed" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" MinHeight="72" Padding="12" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandPaleBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="85"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding RuntimeIconSource}" Width="32" Height="32"/><Border Width="31" Height="31" Margin="10,0,0,0" CornerRadius="5" BorderBrush="{DynamicResource BrandOrangeBrush}" BorderThickness="1"><TextBlock Text="{Binding DockBadge}" Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding PageTitle}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding PageUrl}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock Text="运行中" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding ProcessID}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="4" Text="{Binding DebugAddress}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel x:Name="HistoryHeadingPanel" Margin="0,14,0,10"><TextBlock x:Name="HistoryHeading" Text="历史（0）" Style="{StaticResource SectionTitle}"/><Button Content="清理全部" DockPanel.Dock="Right" Click="ClearAll_Click" Style="{StaticResource YTrayGhostButton}" Foreground="{DynamicResource TextTertiaryBrush}"/></DockPanel>
                        <TextBlock x:Name="HistoryEmpty" Text="暂无历史实例" Height="54" TextAlignment="Center" Padding="0,18,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ListBox x:Name="HistoryList" SelectionChanged="InstanceSelection_Changed" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" MinHeight="65" Padding="12" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandPaleBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding RuntimeIconSource}" Width="28" Height="28"/><Border Width="28" Height="28" Margin="10,0,0,0" CornerRadius="14" Background="{DynamicResource SurfaceMutedBrush}"><TextBlock Text="{Binding DockBadge}" Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"/><TextBlock Text="{Binding PageUrl}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,7,0"/><TextBlock Text="已停止" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="恢复" Tag="{Binding Instance}" Click="Restore_Click" Style="{StaticResource OutlinedAccentButton}"/><Button Content="删除" Tag="{Binding Instance}" Click="DeleteHistory_Click" Margin="7,0,0,0"/></StackPanel>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="25,21">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="155"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="52"/><RowDefinition Height="52"/></Grid.RowDefinitions>
                    <TextBlock Text="实例详情" Style="{StaticResource SectionTitle}"/>
                    <Grid Grid.Row="2" x:Name="DetailPreview" ClipToBounds="True" Background="{DynamicResource SurfaceMutedBrush}">
                        <Image x:Name="DetailThumbnail" Stretch="UniformToFill"/>
                        <StackPanel x:Name="DetailPreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 1.5 2.5 L 14.5 2.5 L 14.5 12.5 L 1.5 12.5 Z M 3.5 10 L 6.2 7.3 L 8.2 9.1 L 10.1 6.9 L 13 10" Width="27" Height="22" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.2" Fill="Transparent"/><TextBlock Text="等待页面预览" Margin="0,7,0,0" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/></StackPanel>
                    </Grid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="浏览器" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailRuntime" Grid.Column="1"/>
                        <TextBlock Grid.Row="1" Text="实例名称" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailName" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Grid.Row="2" Text="AppUserModelID" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailAumid" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="3" Text="用户数据目录" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailProfile" Grid.Row="3" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="4" Text="浏览器版本" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailVersion" Grid.Row="4" Grid.Column="1"/>
                        <TextBlock Grid.Row="5" Text="代理" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailProxy" Grid.Row="5" Grid.Column="1"/>
                        <TextBlock Grid.Row="6" Text="调试端口" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailDebug" Grid.Row="6" Grid.Column="1"/>
                        <TextBlock Grid.Row="7" Text="插件" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailPlugins" Grid.Row="7" Grid.Column="1"/>
                    </Grid>
                    <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="聚焦窗口" Click="FocusDetail_Click"/><Button Grid.Column="2" x:Name="CaptureDetailButton" Content="截图" Click="CaptureDetail_Click"/><Button Grid.Column="4" Content="打开目录" Click="RevealDetail_Click"/>
                    </Grid>
                    <Button Grid.Row="6" x:Name="StopDetailButton" Content="停止实例" Click="StopDetail_Click" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Background="Transparent"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
