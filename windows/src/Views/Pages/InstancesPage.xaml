<Page x:Class="YTray.Views.Pages.InstancesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="InstanceSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="InstanceTableHeader" TargetType="TextBlock" BasedOn="{StaticResource TableHeaderText}">
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="InstanceTableCell" TargetType="TextBlock" BasedOn="{StaticResource TableCellText}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="InstanceRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" MinHeight="66" Padding="12,0"
                                Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="0,0,0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InstanceActionButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="InstanceAccentActionButton" TargetType="Button" BasedOn="{StaticResource OutlinedAccentButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Page.Resources>

    <Grid Margin="25,20,25,20">
        <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="浏览器实例" Style="{StaticResource PageTitle}" FontSize="27"/>
                <TextBlock Text="管理运行中的实例与可恢复历史" Style="{StaticResource PageSubtitle}" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                <Border Padding="13,7" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RunningCountLabel" Text="0 运行中" FontSize="12.5" Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Border Padding="13,7" Margin="9,0,0,0" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <TextBlock x:Name="HistoryCountLabel" Text="0 历史" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border x:Name="ActionFeedbackBorder" Visibility="Collapsed" Padding="11,7" Margin="0,0,10,0"
                        CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <TextBlock x:Name="ActionFeedbackText" FontSize="11.5"/>
                </Border>
                <Button Content="新建实例" Click="NewInstance_Click" MinWidth="116" Height="40"
                        FontSize="13" Style="{StaticResource YTrayPrimaryButton}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.58*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="17,13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="AllTab" Content="全部" Tag="all" Click="Tab_Click" FontSize="12.5" Style="{StaticResource OutlinedAccentButton}"/>
                                <Button x:Name="RunningTab" Grid.Column="1" Content="运行中" Tag="running" Click="Tab_Click" FontSize="12.5"/>
                                <Button x:Name="HistoryTab" Grid.Column="2" Content="历史" Tag="history" Click="Tab_Click" FontSize="12.5"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="2">
                            <TextBox x:Name="SearchBox" Padding="36,6,10,6" FontSize="12.5" TextChanged="Search_Changed"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="搜索标题或地址" Margin="37,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False"/>
                            <Path Data="M 6.5 1.5 A 5 5 0 1 1 6.49 1.5 M 10.2 10.2 L 14 14" Width="16" Height="16"
                                  Margin="12,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="1.4" Fill="Transparent"/>
                        </Grid>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="17,3,17,17">
                            <StackPanel x:Name="RunningSection">
                                <TextBlock x:Name="RunningHeading" Text="运行中（0）" Style="{StaticResource InstanceSectionTitle}" Margin="0,0,0,10"/>
                                <Border x:Name="RunningTable" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="60"/><ColumnDefinition Width="105"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="实例" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="1" Text="页面标题 / 地址" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="2" Text="状态" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="3" Text="PID" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="4" Text="调试端口" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="5" Text="网络" Style="{StaticResource InstanceTableHeader}"/>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" MinHeight="74">
                                            <TextBlock x:Name="RunningEmpty" Text="暂无运行中的浏览器实例" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <ListBox x:Name="RunningList" SelectionChanged="InstanceSelection_Changed" ItemContainerStyle="{StaticResource InstanceRow}"
                                                     BorderThickness="0" Background="Transparent">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="78"/><ColumnDefinition Width="60"/><ColumnDefinition Width="105"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="{Binding InstanceIconSource}" Width="38" Height="38" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" MaxWidth="76" FontSize="12.5" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PageTitle}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding PageUrl}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                                                                <TextBlock Text="运行中" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="3" Text="{Binding ProcessID}" Style="{StaticResource InstanceTableCell}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding DebugAddress}" Style="{StaticResource InstanceTableCell}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding NetworkMode}" FontSize="11.5"/>
                                                                <TextBlock Text="{Binding NetworkAddress}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="HistorySection" Margin="0,16,0,0">
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="HistoryHeading" Text="历史（0）" Style="{StaticResource InstanceSectionTitle}"/>
                                    <Button Content="清理全部" DockPanel.Dock="Right" Click="ClearAll_Click" Style="{StaticResource YTrayGhostButton}"
                                            FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Height="28" MinHeight="0"/>
                                </DockPanel>
                                <Border x:Name="HistoryTable" CornerRadius="5" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="80"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="实例" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="1" Text="最后页面 / 地址" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="2" Text="最后使用时间" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource InstanceTableHeader}"/>
                                                <TextBlock Grid.Column="4" Text="操作" Style="{StaticResource InstanceTableHeader}"/>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" MinHeight="70">
                                            <TextBlock x:Name="HistoryEmpty" Text="暂无历史实例" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <ListBox x:Name="HistoryList" SelectionChanged="InstanceSelection_Changed" ItemContainerStyle="{StaticResource InstanceRow}"
                                                     BorderThickness="0" Background="Transparent">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/><ColumnDefinition Width="116"/><ColumnDefinition Width="80"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Image Source="{Binding InstanceIconSource}" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" MaxWidth="72" FontSize="12" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PageTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding PageUrl}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding LastUsed}" Style="{StaticResource InstanceTableCell}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,7,0"/>
                                                                <TextBlock Text="已停止" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <Button Content="恢复" Tag="{Binding Instance}" Click="Restore_Click" Style="{StaticResource InstanceAccentActionButton}"/>
                                                                <Button Content="删除" Tag="{Binding Instance}" Click="DeleteHistory_Click" Margin="7,0,0,0" Style="{StaticResource InstanceActionButton}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Column="1" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                    <Grid Margin="22,17,22,16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="实例详情" Style="{StaticResource InstanceSectionTitle}"/>

                        <StackPanel x:Name="DetailEmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                            <Border Width="52" Height="52" CornerRadius="10" Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <Viewbox Width="25" Height="25">
                                    <Path Data="M 2 2.5 L 14 2.5 L 14 13.5 L 2 13.5 Z M 5 5.5 L 11 5.5 M 5 8 L 11 8 M 5 10.5 L 9 10.5"
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.25" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="选择一个实例查看详情" Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="从左侧运行中或历史表格选择实例" Margin="0,6,0,0" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer x:Name="DetailContent" Grid.Row="1" Margin="0,15,0,0" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border x:Name="DetailPreviewFrame" Height="155" CornerRadius="7" ClipToBounds="True"
                                        SizeChanged="RoundedPreview_SizeChanged" SnapsToDevicePixels="True"
                                        Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                    <Grid x:Name="DetailPreview">
                                        <Image x:Name="DetailThumbnail" Stretch="UniformToFill"/>
                                        <StackPanel x:Name="DetailPreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox Width="26" Height="22">
                                                <Path Data="M 1.5 2.5 L 14.5 2.5 L 14.5 12.5 L 1.5 12.5 Z M 3.5 10 L 6.2 7.3 L 8.2 9.1 L 10.1 6.9 L 13 10"
                                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.2" Fill="Transparent"/>
                                            </Viewbox>
                                            <TextBlock x:Name="DetailPreviewMessage" Text="等待页面预览" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="浏览器" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailRuntime" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                    <TextBlock Grid.Row="1" Text="实例名称" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailName" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                    <TextBlock Grid.Row="2" Text="AppUserModelID" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailAumid" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    <TextBlock Grid.Row="3" Text="用户数据目录" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailProfile" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                                    <TextBlock Grid.Row="4" Text="浏览器版本" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailVersion" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                    <TextBlock Grid.Row="5" Text="代理" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailProxy" Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                    <TextBlock Grid.Row="6" Text="调试端口" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailDebug" Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                    <TextBlock Grid.Row="7" Text="插件" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DetailPlugins" Grid.Row="7" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                </Grid>

                                <Grid Margin="0,15,0,0" Height="38">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button x:Name="FocusDetailButton" Click="FocusDetail_Click" Style="{StaticResource InstanceActionButton}" Height="38">
                                        <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="M 1.5 2.5 L 14.5 2.5 L 14.5 12.5 L 1.5 12.5 Z M 5 14.5 L 11 14.5 M 8 12.5 L 8 14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/></Viewbox><TextBlock Text="聚焦窗口"/></StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" x:Name="CaptureDetailButton" Click="CaptureDetail_Click" Style="{StaticResource InstanceActionButton}" Height="38">
                                        <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="M 1.5 5 L 4.4 5 L 5.6 3.2 L 10.4 3.2 L 11.6 5 L 14.5 5 L 14.5 13 L 1.5 13 Z M 8 6.4 A 2.2 2.2 0 1 0 8 10.8 A 2.2 2.2 0 1 0 8 6.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/></Viewbox><TextBlock Text="截图"/></StackPanel>
                                    </Button>
                                    <Button Grid.Column="4" x:Name="RevealDetailButton" Click="RevealDetail_Click" Style="{StaticResource InstanceActionButton}" Height="38">
                                        <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="M 1.5 4 L 6.2 4 L 7.7 5.5 L 14.5 5.5 L 14.5 13.5 L 1.5 13.5 Z M 1.5 5.5 L 1.5 2.5 L 6 2.5 L 7.2 4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/></Viewbox><TextBlock Text="打开目录"/></StackPanel>
                                    </Button>
                                </Grid>

                                <Button x:Name="StopDetailButton" Height="38" Margin="0,9,0,0" Click="StopDetail_Click"
                                        Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Background="Transparent" FontSize="12.5">
                                    <StackPanel Orientation="Horizontal"><Viewbox Width="14" Height="14" Margin="0,0,7,0"><Path Data="M 2 2 L 14 2 L 14 14 L 2 14 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/></Viewbox><TextBlock Text="停止实例"/></StackPanel>
                                </Button>
                                <Button x:Name="RestoreDetailButton" Height="38" Margin="0,9,0,0" Click="RestoreDetail_Click"
                                        Style="{StaticResource OutlinedAccentButton}" FontSize="12.5" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal"><Viewbox Width="15" Height="15" Margin="0,0,7,0"><Path Data="M 3.3 5.2 L 1 5.2 L 1 2.9 M 1.4 5 C 2.6 2.3 5.9 1.1 8.8 2.1 C 12 3.2 13.7 6.8 12.6 10 C 11.5 13.2 7.9 14.9 4.7 13.8 C 3 13.2 1.7 12 1 10.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/></Viewbox><TextBlock Text="恢复实例"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
