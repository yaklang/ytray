<Page x:Class="YTray.Views.Pages.InstancesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Background="{DynamicResource RegionBrush}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="28,28,28,16">
            <TextBlock Text="运行与历史" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="运行中显示全部浏览器；停止后保存最后页面标题，并进入历史记录。" Foreground="#888" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="28,0,28,28">
            <StackPanel>
                <TextBlock Text="运行中" FontWeight="Bold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="RunningList" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                <DockPanel>
                                    <Border Width="92" Height="58" CornerRadius="8" Background="#FFF6EE" Margin="0,0,14,0"/>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                            <hc:Badge Text="运行中" Status="Success" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastPageTitle, TargetNullValue=正在读取页面标题}" Foreground="#888" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="#BBB">
                                            <Run Text="PID "/><Run Text="{Binding ProcessID}"/><Run Text=" · Debug 127.0.0.1:"/><Run Text="{Binding DebugPort}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="截图" Padding="8,4" Margin="0,0,4,0" Click="Capture_Click" Tag="{Binding}"/>
                                        <Button Content="目录" Padding="8,4" Margin="0,0,4,0" Click="Reveal_Click" Tag="{Binding}"/>
                                        <Button Content="停止" Padding="8,4" Click="Stop_Click" Tag="{Binding}" Foreground="#E74C3C"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="历史" FontWeight="Bold"/>
                    <Button Content="清理全部" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="8,4" Click="ClearAll_Click" Foreground="#E74C3C"/>
                </DockPanel>
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                <DockPanel>
                                    <Border Width="78" Height="48" CornerRadius="8" Background="#FFF6EE" Margin="0,0,14,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding LastPageTitle, TargetNullValue=未记录页面标题}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#888" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="▶ 打开" Padding="8,4" Margin="0,0,4,0" Click="Restore_Click" Tag="{Binding}" Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
                                        <Button Content="删除" Padding="8,4" Click="DeleteHistory_Click" Tag="{Binding}" Foreground="#E74C3C"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Page>