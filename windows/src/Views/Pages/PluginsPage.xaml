<Page x:Class="YTray.Views.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="25,20,25,22">
        <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="54"/><RowDefinition Height="13"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="本地插件" Style="{StaticResource PageTitle}" FontSize="27"/><TextBlock Text="管理已解压的 Chromium 插件目录与启动加载权限" Style="{StaticResource PageSubtitle}" FontSize="13" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse x:Name="PluginCountDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock x:Name="PluginCountLabel" Text="0 个插件" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
            <Button Grid.Column="1" Click="Add_Click" Height="40" MinWidth="142" Style="{StaticResource YTrayPrimaryButton}" VerticalAlignment="Top" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal"><Path Data="M 8 2 L 8 14 M 2 8 L 14 8" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><TextBlock Text="添加插件目录…" Margin="8,0,0,0"/></StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="20" CornerRadius="10" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.2"><TextBlock Text="i" FontFamily="Georgia" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="目录根部必须包含 manifest.json" Margin="14,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="ExtensionUpdateBadge" Margin="14,0,0,0" Padding="8,3" CornerRadius="9" Background="{DynamicResource BrandPaleBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="Yakit 插件有新版本" FontSize="10.5" Foreground="{DynamicResource BrandOrangeBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ExtensionStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <ProgressBar x:Name="ExtensionProgressBar" Width="130" Height="6" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="ExtensionRefreshBtn" Content="检查更新" Click="ExtensionRefresh_Click" Height="32" FontSize="11.5" Margin="0,0,8,0" Padding="12,0"/>
                    <Button x:Name="ExtensionInstallBtn" Click="ExtensionInstall_Click" Height="32" FontSize="11.5" MinWidth="118" Padding="12,0" Style="{StaticResource YTrayPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.72*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceBorder}" CornerRadius="5,0,0,5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <TextBlock Text="名称" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="1" Text="版本" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="2" Text="目录" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="3" Text="启动权限" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="4" Text="操作" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="PluginEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="34" Height="34" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.3" Fill="Transparent"/><TextBlock Text="尚未添加本地插件" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <ListBox x:Name="PluginList" SelectionChanged="PluginSelection_Changed" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><Border x:Name="Row" MinHeight="80" Padding="17,0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><Border x:Name="Accent" HorizontalAlignment="Left" Width="3" Background="{DynamicResource BrandOrangeBrush}" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandPaleBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter TargetName="Accent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="142"/><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="32" Height="32">
                                        <Border CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                            <Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="19" Height="19" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent"/>
                                        </Border>
                                        <Image Source="{Binding IconSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Plugin.Name}" Margin="11,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="v"/><Run Text="{Binding Plugin.Version}"/><Run Text=" · Manifest V"/><Run Text="{Binding Plugin.ManifestVersion}"/></TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Plugin.Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Plugin.Path}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <CheckBox Grid.Column="3" Content="启动时可用" FontSize="11.5" IsChecked="{Binding Plugin.Enabled}" Click="Enabled_Click" Tag="{Binding Plugin}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                    <Button Tag="{Binding Plugin}" Click="OpenFolder_Click" Style="{StaticResource YTrayGhostButton}" Foreground="{DynamicResource BrandOrangeBrush}" Padding="0,4" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="M 1.5 4.5 L 6.5 4.5 L 8 6 L 14.5 6 L 13.5 13.5 L 1.5 13.5 Z" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/><TextBlock Text="打开目录" FontSize="11.5" Margin="7,0,0,0"/></StackPanel></Button>
                                    <Button Tag="{Binding Plugin}" Click="Remove_Click" Style="{StaticResource YTrayGhostButton}" Foreground="{DynamicResource DangerBrush}" Padding="0,4" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="M 2.5 4.5 L 13.5 4.5 M 6 2.5 L 10 2.5 M 4.5 4.5 L 5.2 14 L 10.8 14 L 11.5 4.5" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/><TextBlock Text="删除" FontSize="11.5" Margin="7,0,0,0"/></StackPanel></Button>
                                </StackPanel>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SurfaceBorder}" CornerRadius="0,5,5,0" BorderThickness="1" Margin="-1,0,0,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                        <TextBlock Text="插件详情" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Grid.Row="1" Margin="20,20,20,18">
                    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="DetailContent">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="86"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="1"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="1"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="2" Orientation="Horizontal"><Grid Width="66" Height="66"><Border CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"><Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="36" Height="36" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent"/></Border><Image x:Name="DetailIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid><StackPanel Margin="22,7,0,0"><TextBlock x:Name="DetailName" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DetailVersion" Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
                        <StackPanel Grid.Row="4"><TextBlock Text="目录" FontSize="12.5" FontWeight="SemiBold"/><TextBlock x:Name="DetailPath" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <Border Grid.Row="6" Background="{DynamicResource HairlineBrush}"/>
                        <StackPanel Grid.Row="8"><TextBlock Text="状态" FontSize="12.5" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse x:Name="DetailStateDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock x:Name="DetailState" FontSize="12.5"/></StackPanel><TextBlock Text="启动时可用" Margin="0,8,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <Border Grid.Row="10" Background="{DynamicResource HairlineBrush}"/>
                        <StackPanel Grid.Row="12"><TextBlock Text="说明" FontSize="12.5" FontWeight="SemiBold"/><TextBlock Text="可在概述或自定义启动中选择。选中后，新浏览器实例会通过 Chromium 启动参数加载此插件。" Margin="0,9,0,0" FontSize="11.5" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <Grid Grid.Row="14"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                            <Button Click="OpenSelectedFolder_Click"><StackPanel Orientation="Horizontal"><Path Data="M 1.5 4.5 L 6.5 4.5 L 8 6 L 14.5 6 L 13.5 13.5 L 1.5 13.5 Z" Width="15" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/><TextBlock Text="打开目录" Margin="8,0,0,0"/></StackPanel></Button>
                            <Button Grid.Column="2" Click="RemoveSelected_Click" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Background="Transparent"><StackPanel Orientation="Horizontal"><Path Data="M 2.5 4.5 L 13.5 4.5 M 6 2.5 L 10 2.5 M 4.5 4.5 L 5.2 14 L 10.8 14 L 11.5 4.5" Width="15" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/><TextBlock Text="移除插件" Margin="8,0,0,0"/></StackPanel></Button>
                        </Grid>
                    </Grid>
                    <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="42" Height="42" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.15" Fill="Transparent"/>
                        <TextBlock Text="选择一个插件查看详情" Margin="0,14,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
