<Page x:Class="YTray.Views.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="PluginLoadSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2" HorizontalAlignment="Left" Fill="{DynamicResource TextTertiaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource BrandOrangeBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Fill" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="25,20,25,22">
        <Grid.RowDefinitions><RowDefinition Height="94"/><RowDefinition Height="54"/><RowDefinition Height="13"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="本地插件" Style="{StaticResource PageTitle}" FontSize="27"/><TextBlock Text="启用的插件会默认加载到所有新建的 Chromium 实例" Style="{StaticResource PageSubtitle}" FontSize="13" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse x:Name="PluginCountDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock x:Name="PluginCountLabel" Text="0 个插件" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
            <Button Grid.Column="1" Click="Add_Click" Height="40" MinWidth="142" Style="{StaticResource YTrayPrimaryButton}" VerticalAlignment="Top" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal"><Path Data="M 8 2 L 8 14 M 2 8 L 14 8" Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/><TextBlock Text="添加插件目录…" Margin="8,0,0,0"/></StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="20" Height="20" CornerRadius="10" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.2"><TextBlock Text="i" FontFamily="Georgia" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="目录根部必须包含 manifest.json" Margin="14,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="ExtensionUpdateBadge" Margin="14,0,0,0" Padding="8,3" CornerRadius="9" Background="{DynamicResource BrandPaleBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="Yakit 插件有新版本" FontSize="10.5" Foreground="{DynamicResource BrandOrangeBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ExtensionStatusText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <ProgressBar x:Name="ExtensionProgressBar" Width="130" Height="6" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="ExtensionRefreshBtn" Content="检查更新" Click="ExtensionRefresh_Click" Height="32" FontSize="11.5" Margin="0,0,8,0" Padding="12,0"/>
                    <Button x:Name="ExtensionInstallBtn" Click="ExtensionInstall_Click" Height="32" FontSize="11.5" MinWidth="118" Padding="12,0" Style="{StaticResource YTrayPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.72*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceBorder}" CornerRadius="5,0,0,5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                            <TextBlock Text="名称" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="1" Text="版本" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="2" Text="默认加载" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="PluginEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="34" Height="34" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.3" Fill="Transparent"/><TextBlock Text="尚未添加本地插件" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <ListBox x:Name="PluginList" SelectionChanged="PluginSelection_Changed" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><Border x:Name="Row" MinHeight="80" Padding="17,0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><Border x:Name="Accent" HorizontalAlignment="Left" Width="3" Background="{DynamicResource BrandOrangeBrush}" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandPaleBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/><Setter TargetName="Accent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32">
                                        <Border CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                            <Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="19" Height="19" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent"/>
                                        </Border>
                                        <Image Source="{Binding IconSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Plugin.Name}" Margin="0,0,10,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Plugin.Name}"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding VersionLabel}" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionLabel}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ToggleButton Grid.Column="2" IsChecked="{Binding Plugin.Enabled}" Click="Enabled_Click" Tag="{Binding Plugin}" Style="{StaticResource PluginLoadSwitch}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="切换新实例默认加载"/>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SurfaceBorder}" CornerRadius="0,5,5,0" BorderThickness="1" Margin="-1,0,0,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                        <TextBlock Text="插件详情" Style="{StaticResource SectionTitle}" FontSize="15" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Grid.Row="1" Margin="20,14,20,14">
                    <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="DetailContent">
                        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="12"/><RowDefinition Height="32"/><RowDefinition Height="10"/><RowDefinition Height="1"/><RowDefinition Height="10"/><RowDefinition Height="30"/><RowDefinition Height="10"/><RowDefinition Height="1"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="8"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="56" Height="56"><Border CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"><Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="31" Height="31" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent"/></Border><Image x:Name="DetailIcon" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="DetailName" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DetailVersion" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="目录" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="OpenSelectedFolder_Click" Height="30" Margin="-7,0,0,0" Padding="7,0" Style="{StaticResource YTrayGhostButton}" HorizontalContentAlignment="Stretch" Cursor="Hand"><TextBlock x:Name="DetailPath" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrandOrangeBrush}"/></Button>
                        </Grid>
                        <Border Grid.Row="4" Background="{DynamicResource HairlineBrush}"/>
                        <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="状态" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="DetailStateDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock x:Name="DetailState" FontSize="12"/></StackPanel>
                        </Grid>
                        <Border Grid.Row="8" Background="{DynamicResource HairlineBrush}"/>
                        <StackPanel Grid.Row="10"><TextBlock Text="说明" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="启用后，所有新实例默认加载此插件；自定义启动仍可对本次实例临时调整。" Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <Grid Grid.Row="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="DetailOpenFolderButton" Click="OpenSelectedFolder_Click" Height="40"><StackPanel Orientation="Horizontal"><Path Data="M 1.5 4.5 L 6.5 4.5 L 8 6 L 14.5 6 L 13.5 13.5 L 1.5 13.5 Z" Width="15" Height="15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/><TextBlock Text="打开目录" Margin="8,0,0,0"/></StackPanel></Button>
                            <Button x:Name="DetailRemoveButton" Grid.Column="2" Click="RemoveSelected_Click" Height="40" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Background="Transparent"><StackPanel Orientation="Horizontal"><Path Data="M 2.5 4.5 L 13.5 4.5 M 6 2.5 L 10 2.5 M 4.5 4.5 L 5.2 14 L 10.8 14 L 11.5 4.5" Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.2" Fill="Transparent"/><TextBlock Text="移除插件" Margin="8,0,0,0"/></StackPanel></Button>
                        </Grid>
                    </Grid>
                    <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="42" Height="42" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.15" Fill="Transparent"/>
                        <TextBlock Text="选择一个插件查看详情" Margin="0,14,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
