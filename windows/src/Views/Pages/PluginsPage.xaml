<Page x:Class="YTray.Views.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="本地插件" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="启用的扩展将在新实例中自动加载；工具栏固定设置于下次启动实例时生效" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Padding="12,6" Margin="0,0,12,0" CornerRadius="14" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PluginCountDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PluginCountLabel" Text="0 个插件" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Button Click="Add_Click" Height="38" MinWidth="162" Style="{StaticResource YTrayPrimaryButton}" ToolTip="支持多选；选择浏览器扩展根目录时会自动扫描">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7 1.5 L 7 12.5 M 1.5 7 L 12.5 7" Width="13" Height="13" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock Text="添加或扫描插件…" Margin="8,0,0,0" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Two-Card Master-Detail (Collapses Detail Column When Empty!) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition x:Name="DetailGapColumn" Width="16"/>
                <ColumnDefinition x:Name="DetailCardColumn" Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Plugin List Card -->
            <Border Style="{StaticResource SurfaceBorder}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="156"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="插件名称" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="版本与协议" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="默认加载" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="固定到工具栏" Style="{StaticResource TableHeaderText}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="PluginEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Center">
                                <Viewbox Width="25" Height="25">
                                    <Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z"
                                          Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.35" Fill="Transparent"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="尚未添加本地浏览器插件" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="导入已解压的 Chrome 扩展目录（含 manifest.json），新建隔离实例时可自动挂载运行" Margin="0,6,0,16" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <Button Click="Add_Click" Content="选择本地插件目录…" Height="36" MinHeight="0" Padding="18,0" HorizontalAlignment="Center" Style="{StaticResource OutlinedAccentButton}"/>
                        </StackPanel>

                        <ListBox x:Name="PluginList" SelectionChanged="PluginSelection_Changed" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <Border x:Name="Row" MinHeight="70" Padding="18,0" Background="Transparent"
                                                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <Border x:Name="Accent" HorizontalAlignment="Left" Width="3" Background="{DynamicResource BrandOrangeBrush}" Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                                        <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="156"/>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="108"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid Width="34" Height="34" HorizontalAlignment="Left">
                                                <Border CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                                    <Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z"
                                                          Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent"/>
                                                </Border>
                                                <Image Source="{Binding IconSource}" Margin="3" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Plugin.Name}" Margin="0,0,12,0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Plugin.Name}"/>
                                        </Grid>
                                        <Border Grid.Column="1" Style="{StaticResource CodeBadgeBorder}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding VersionLabel}" FontFamily="Cascadia Mono, Consolas, Segoe UI" TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <ToggleButton Grid.Column="2" IsChecked="{Binding Plugin.Enabled}" Click="Enabled_Click" Tag="{Binding Plugin}" Style="{StaticResource YTrayToggleSwitch}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="切换新实例默认加载"/>
                                        <ToggleButton Grid.Column="3" IsChecked="{Binding Plugin.PinToToolbar}" Click="PinToToolbar_Click" Tag="{Binding Plugin}" Style="{StaticResource YTrayToggleSwitch}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="固定到工具栏；下次启动实例生效"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Plugin Detail Card -->
            <Border x:Name="DetailCardBorder" Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="20,18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="插件详情" Style="{StaticResource SectionTitle}"/>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid x:Name="DetailContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource SubtleCardBorder}" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Width="48" Height="48">
                                        <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                            <Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z"
                                                  Width="24" Height="24" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent"/>
                                        </Border>
                                        <Image x:Name="DetailIcon" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailName" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailVersion" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource SubtleCardBorder}" Padding="14,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="状态" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="DetailStateDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="DetailState" FontSize="12.5" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="目录" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Click="OpenSelectedFolder_Click" Height="28" MinHeight="0" Margin="-6,0,0,0" Padding="6,0" Style="{StaticResource YTrayGhostButton}" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <TextBlock x:Name="DetailPath" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="4">
                                <TextBlock Text="行为说明" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="开启「默认加载」后，新建浏览器实例将自动挂载此扩展；「固定到工具栏」会在下次启动实例时写入浏览器偏好。" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="DetailOpenFolderButton" Click="OpenSelectedFolder_Click" Height="38" MinHeight="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1.5 4.5 L 6.5 4.5 L 8 6 L 14.5 6 L 13.5 13.5 L 1.5 13.5 Z" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/>
                                        <TextBlock Text="打开目录" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DetailRemoveButton" Grid.Column="2" Click="RemoveSelected_Click" Height="38" MinHeight="0" Style="{StaticResource YTrayDangerOutlineButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 2.5 4.5 L 13.5 4.5 M 6 2.5 L 10 2.5 M 4.5 4.5 L 5.2 14 L 10.8 14 L 11.5 4.5" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/>
                                        <TextBlock Text="移除插件" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230">
                            <Border Width="50" Height="50" CornerRadius="13" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <Viewbox Width="23" Height="23">
                                    <Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z"
                                          Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.25" Fill="Transparent"/>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="选择一个插件查看详情" Margin="0,14,0,0" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="在左侧列表点击任一扩展可查看目录与加载状态" Margin="0,5,0,0" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
