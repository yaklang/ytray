<Page x:Class="YTray.Views.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Background="{DynamicResource RegionBrush}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="28,28,28,16">
            <TextBlock Text="插件管理" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Chrome 命令行只能加载已解压插件目录；请选择根部包含 manifest.json 的文件夹。" Foreground="#888" Margin="0,5,0,0"/>
        </StackPanel>
        <Button DockPanel.Dock="Top" Content="添加本地插件目录…" Padding="12,8" HorizontalAlignment="Left" Margin="28,0,28,16"
                Click="Add_Click" Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
        <ListBox x:Name="PluginList" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" Margin="28,0,28,28">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="14,10"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Border Width="40" Height="40" CornerRadius="8" Background="#FFF6EE" Margin="0,0,14,0">
                            <TextBlock Text="🧩" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                            <TextBlock FontSize="11" Foreground="#888">
                                <Run Text="v"/><Run Text="{Binding Version}"/><Run Text=" · Manifest V"/><Run Text="{Binding ManifestVersion}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#BBB" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="可用" IsChecked="{Binding Enabled}" Margin="0,0,12,0"/>
                            <Button Content="🗑" Click="Remove_Click" Tag="{Binding}" Foreground="#E74C3C" Background="Transparent" BorderThickness="0" Width="28" Height="28"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Page>