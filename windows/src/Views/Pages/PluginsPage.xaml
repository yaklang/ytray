<Page x:Class="YTray.Views.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="25,20,25,20">
        <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="54"/><RowDefinition Height="13"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="本地插件" Style="{StaticResource PageTitle}"/><TextBlock Text="管理已解压的 Chromium 插件目录与启动加载权限" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock x:Name="PluginCountLabel" Text="0 个插件" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
            <Button Grid.Column="1" Content="添加插件目录…" Click="Add_Click" Height="40" MinWidth="132" Style="{StaticResource YTrayPrimaryButton}" VerticalAlignment="Top" Margin="0,18,0,0"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Padding="16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="20" Height="20" CornerRadius="10" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1.2"><TextBlock Text="i" FontFamily="Georgia" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="目录根部必须包含 manifest.json" Margin="14,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1.02*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceBorder}" CornerRadius="5,0,0,5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="39"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="名称" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="1" Text="版本" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="2" Text="目录" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="3" Text="启动权限" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="4" Text="操作" Style="{StaticResource TableHeaderText}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <StackPanel x:Name="PluginEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="34" Height="34" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.3" Fill="Transparent"/><TextBlock Text="尚未添加本地插件" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <ListBox x:Name="PluginList" SelectionChanged="PluginSelection_Changed" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" MinHeight="78" Padding="17,0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandPaleBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="24" Height="24" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent"/><TextBlock Text="{Binding Name}" Margin="13,0,0,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="v"/><Run Text="{Binding Version}"/><Run Text=" · Manifest V"/><Run Text="{Binding ManifestVersion}"/></TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding Path}" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="38" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <CheckBox Grid.Column="3" Content="启动时可用" IsChecked="{Binding Enabled}" Click="Enabled_Click" Tag="{Binding}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="4" VerticalAlignment="Center"><Button Content="打开目录" Tag="{Binding}" Click="OpenFolder_Click" Style="{StaticResource YTrayGhostButton}" Foreground="{DynamicResource BrandOrangeBrush}"/><Button Content="删除" Tag="{Binding}" Click="Remove_Click" Style="{StaticResource YTrayGhostButton}" Foreground="{DynamicResource DangerBrush}"/></StackPanel>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SurfaceBorder}" CornerRadius="0,5,5,0" BorderThickness="1,1,1,1" Margin="-1,0,0,0">
                <Grid Margin="20,17">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="86"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="1"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="1"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
                    <TextBlock Text="插件详情" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal"><Border Width="66" Height="66" CornerRadius="7" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"><Path Data="M 6 1 L 10 1 L 10 5 C 13 3 15 5 15 7.5 C 15 10 13 12 10 10 L 10 15 L 6 15 L 6 11 C 4 13 1 11 1 8.5 C 1 6 4 4 6 6 Z" Width="36" Height="36" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3" Fill="Transparent"/></Border><StackPanel Margin="22,8,0,0"><TextBlock x:Name="DetailName" Text="—" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DetailVersion" Text="—" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
                    <StackPanel Grid.Row="4"><TextBlock Text="目录" FontWeight="SemiBold"/><TextBlock x:Name="DetailPath" Text="—" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    <Border Grid.Row="6" Background="{DynamicResource HairlineBrush}"/>
                    <StackPanel Grid.Row="8"><TextBlock Text="状态" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse x:Name="DetailStateDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,9,0"/><TextBlock x:Name="DetailState" Text="—"/></StackPanel><TextBlock Text="启动时可用" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    <Border Grid.Row="10" Background="{DynamicResource HairlineBrush}"/>
                    <StackPanel Grid.Row="12"><TextBlock Text="说明" FontWeight="SemiBold"/><TextBlock Text="可在自定义启动中选择。启用后，启动浏览器时此插件将随 Chromium 标志自动加载。" Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                    <Grid Grid.Row="14"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Button Content="打开目录" Click="OpenSelectedFolder_Click"/><Button Grid.Column="2" Content="移除插件" Click="RemoveSelected_Click" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerBrush}" Background="Transparent"/></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
