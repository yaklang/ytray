<Page x:Class="YTray.Views.Pages.PluginsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="26,23,26,17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="插件管理" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理已解压的 Chromium 插件目录，并选择是否允许启动时加载。"
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="添加插件目录…" Click="Add_Click"
                    Style="{StaticResource YTrayPrimaryButton}" VerticalAlignment="Center"/>
        </Grid>

        <Border Margin="26,0,26,26" Style="{StaticResource SurfaceBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="15,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="本地插件" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}">
                            <TextBlock x:Name="PluginCountLabel" Text="0" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="目录根部必须包含 manifest.json" FontSize="9.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource HairlineBrush}"/>

                <Grid>
                    <Border x:Name="PluginEmpty" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="尚未添加本地插件" Margin="0,10,0,3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="选择一个包含 manifest.json 的已解压插件目录。" FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="PluginList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="15,11">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="35" Height="35" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="v"/><Run Text="{Binding Version}"/><Run Text="  ·  Manifest V"/><Run Text="{Binding ManifestVersion}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Path}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox Content="启动时可用" IsChecked="{Binding Enabled}" Margin="0,0,13,0"
                                                      Click="Enabled_Click" Tag="{Binding}"/>
                                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" ToolTip="删除插件"
                                                    Click="Remove_Click" Tag="{Binding}" Style="{StaticResource YTrayDangerIconButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</Page>
