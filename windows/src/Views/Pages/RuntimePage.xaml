<Page x:Class="YTray.Views.Pages.RuntimePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="25,20,25,20">
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="126"/><RowDefinition Height="13"/><RowDefinition Height="*"/><RowDefinition Height="13"/><RowDefinition Height="143"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="浏览器来源" Style="{StaticResource PageTitle}"/><TextBlock Text="发现系统浏览器、管理本地路径与安装隔离运行时" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,5,0,0">
                <Border x:Name="DefaultFeedbackBorder" Visibility="Collapsed" Padding="10,8" Margin="0,0,9,0" CornerRadius="5" Background="{DynamicResource SuccessPaleBrush}"><TextBlock x:Name="DefaultFeedbackText" Foreground="{DynamicResource SuccessBrush}"/></Border>
                <Button Content="重新扫描本机" Margin="0,0,9,0" Click="Rescan_Click"/>
                <Button Content="添加本地浏览器…" Click="Choose_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Padding="19,15">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="13"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Chrome for Testing" Style="{StaticResource SectionTitle}"/><TextBlock Text="独立安装，不影响系统 Chrome" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"/></StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="14"/><ColumnDefinition Width="320"/><ColumnDefinition Width="14"/><ColumnDefinition Width="110"/><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="RefreshManifestBtn" Content="刷新版本" Click="RefreshManifest_Click"/>
                    <ComboBox x:Name="VersionCombo" Grid.Column="2" Height="38" SelectionChanged="VersionCombo_SelectionChanged">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="11.5"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="InstallBtn" Grid.Column="4" Content="安装此版本" Click="Install_Click" Style="{StaticResource YTrayPrimaryButton}"/>
                    <TextBlock x:Name="ManifestStatus" Grid.Column="5" Margin="13,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <Grid x:Name="InstallProgressPanel" Grid.Column="6" Visibility="Collapsed" Margin="15,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstallStatus" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="InstallPercentLabel" Grid.Column="1" FontSize="10.5" Foreground="{DynamicResource BrandOrangeBrush}" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="InstallProgressBar" Grid.Row="2" Grid.ColumnSpan="2"/>
                        <TextBlock x:Name="InstallBytesLabel" Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SurfaceBorder}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="41"/><RowDefinition Height="37"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="14,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="可用浏览器" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RuntimeCountLabel" Text="0" Margin="11,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><TextBlock x:Name="DefaultRuntimeLabel" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid>
                <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1">
                    <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="115"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="172"/></Grid.ColumnDefinitions>
                        <TextBlock Text="浏览器" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="1" Text="来源" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="2" Text="版本" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="3" Text="架构" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="4" Text="可执行文件" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="5" Text="状态" Style="{StaticResource TableHeaderText}"/><TextBlock Grid.Column="6" Text="操作" Style="{StaticResource TableHeaderText}"/>
                    </Grid>
                </Border>
                <ListBox x:Name="RuntimeList" Grid.Row="2" SelectionChanged="RuntimeSelection_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" MinHeight="66" Padding="14,0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandPaleBrush}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="115"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="172"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding IconSource}" Width="32" Height="32"/><TextBlock Text="{Binding Runtime.DisplayTitle}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SourceTitle}" Style="{StaticResource TableCellText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Runtime.VersionLabel}" Style="{StaticResource TableCellText}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Runtime.Architecture}" Style="{StaticResource TableCellText}"/>
                        <TextBlock Grid.Column="4" Text="{Binding Runtime.ExecutablePath}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="36"/>
                        <Border Grid.Column="5" Visibility="{Binding DefaultVisibility}" Style="{StaticResource PillBadge}" Background="{DynamicResource SuccessPaleBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="默认" FontSize="9.5" Foreground="{DynamicResource SuccessBrush}"/></Border>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="打开目录" Tag="{Binding Runtime}" Click="OpenFolder_Click" Margin="0,0,7,0"/><Button Tag="{Binding Runtime}" Click="SetDefault_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource YTrayButton}"><Setter Property="Content" Value="设为默认"/><Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Content" Value="当前默认"/><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource SurfaceBorder}" Padding="17,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="1"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="浏览器:" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailBrowser" Grid.Column="1"/>
                    <TextBlock Grid.Row="1" Text="来源:" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailSource" Grid.Row="1" Grid.Column="1"/>
                    <TextBlock Grid.Row="2" Text="版本:" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailVersion" Grid.Row="2" Grid.Column="1"/>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource HairlineBrush}"/>
                <Grid Grid.Column="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><TextBlock Text="可执行文件:" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="DetailPath" Grid.Column="1" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="⌑" Click="OpenSelectedFolder_Click" Style="{StaticResource YTrayIconButton}"/></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="命令行示例:" Foreground="{DynamicResource TextSecondaryBrush}"/><Border Grid.Column="1" Padding="11,8" CornerRadius="5" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"><TextBlock x:Name="DetailCommand" FontFamily="Cascadia Mono, Consolas" FontSize="10" TextWrapping="Wrap"/></Border></Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
