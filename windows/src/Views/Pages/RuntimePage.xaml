<Page x:Class="YTray.Views.Pages.RuntimePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="26,23,26,17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="浏览器来源" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="使用系统浏览器、本地浏览器，或安装隔离的 Chrome for Testing。"
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border x:Name="DefaultFeedbackBorder" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center"
                    Padding="10,7" CornerRadius="9" Background="{DynamicResource SuccessPaleBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBrush}"
                               FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DefaultFeedbackText" Foreground="{DynamicResource SuccessBrush}"
                               FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border DockPanel.Dock="Top" Margin="26,0,26,13" Style="{StaticResource SurfaceBorder}" Padding="15">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Chrome for Testing" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="独立安装，不影响系统中的 Chrome。" FontSize="9.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="重新扫描本机" Margin="0,0,7,0" Click="Rescan_Click" Style="{StaticResource YTrayButton}"/>
                        <Button Content="添加本地浏览器…" Click="Choose_Click" Style="{StaticResource YTrayButton}"/>
                    </StackPanel>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="252"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RefreshManifestBtn" Content="刷新版本" Click="RefreshManifest_Click" Style="{StaticResource YTrayButton}"/>
                    <ComboBox x:Name="VersionCombo" Grid.Column="2" Height="38"
                              SelectionChanged="VersionCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Version, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="InstallBtn" Grid.Column="4" Content="安装此版本" MinWidth="96"
                            Click="Install_Click" Style="{StaticResource YTrayPrimaryButton}"/>
                    <TextBlock x:Name="ManifestStatus" Grid.Column="5" Margin="11,0,0,0" FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Border x:Name="InstallProgressPanel" Visibility="Collapsed" Margin="0,13,0,0" Padding="12,10"
                        CornerRadius="9" Background="{DynamicResource SurfaceMutedBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstallStatus" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="InstallPercentLabel" Grid.Column="1" FontSize="10.5"
                                   Foreground="{DynamicResource BrandOrangeBrush}" FontWeight="SemiBold" Margin="12,0,0,0"/>
                        <ProgressBar x:Name="InstallProgressBar" Grid.Row="2" Value="0" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="InstallBytesLabel" Grid.Row="2" Grid.Column="1" FontSize="9.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Margin="26,0,26,26" Style="{StaticResource SurfaceBorder}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="15,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="可用浏览器" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}">
                            <TextBlock x:Name="RuntimeCountLabel" Text="0" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DefaultRuntimeLabel" Grid.Column="1" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource HairlineBrush}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RuntimeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="RuntimeRowBorder" Background="Transparent" Padding="15,12"
                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="49"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceMutedBrush}"
                                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                            <Image Source="{Binding IconSource, Mode=OneWay}" Width="29" Height="29"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Runtime.DisplayTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="12.5"/>
                                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="6" Background="{DynamicResource SurfaceMutedBrush}"
                                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding SourceTitle, Mode=OneWay}" FontSize="8.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                                <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="6" Background="{DynamicResource SuccessPaleBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsDefault, Mode=OneWay}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="默认" FontSize="8.5" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="版本 "/><Run Text="{Binding Runtime.VersionLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Runtime.Architecture, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Runtime.ExecutablePath, Mode=OneWay}" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       FontSize="9" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Tag="{Binding Runtime, Mode=OneWay}" Click="OpenFolder_Click"
                                                Style="{StaticResource YTrayIconButton}" Width="34" Height="34"
                                                VerticalAlignment="Center" ToolTip="打开所在文件夹">
                                            <Viewbox Width="17" Height="17">
                                                <Path Data="M 1.5 4.5 L 6.1 4.5 L 7.7 6.2 L 14.5 6.2 L 14.5 13.5 L 1.5 13.5 Z M 1.5 4.5 L 1.5 2.5 L 6.4 2.5 L 8 4.5"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.25" StrokeLineJoin="Round" Fill="Transparent"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Grid.Column="4" Tag="{Binding Runtime, Mode=OneWay}" Click="SetDefault_Click" MinWidth="82"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource YTrayButton}">
                                                    <Setter Property="Content" Value="设为默认"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault, Mode=OneWay}" Value="True">
                                                            <Setter Property="Content" Value="当前默认"/>
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="RuntimeRowBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RuntimeRowBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Page>
