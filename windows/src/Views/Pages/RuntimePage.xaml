<Page x:Class="YTray.Views.Pages.RuntimePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="RuntimeSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="FontSize" Value="14.5"/>
        </Style>
        <Style x:Key="RuntimeActionButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="RuntimeDetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RuntimeDetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="DetailsGapRow" Height="0"/>
            <RowDefinition x:Name="DetailsRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="浏览器来源" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="发现本机系统浏览器、管理本地自定义路径与一键安装隔离版 Chrome for Testing" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="DefaultFeedbackBorder" Visibility="Collapsed" Padding="11,7" Margin="0,0,10,0"
                        CornerRadius="8" Background="{DynamicResource SuccessPaleBrush}">
                    <TextBlock x:Name="DefaultFeedbackText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                </Border>
                <Button Content="重新扫描本机" Margin="0,0,9,0" Click="Rescan_Click" Height="36" FontSize="12.5"/>
                <Button Content="添加本地浏览器…" Click="Choose_Click" Height="36" FontSize="12.5"/>
            </StackPanel>
        </Grid>

        <!-- Chrome for Testing Installer Card -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                <DockPanel>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource BrandPaleBrush}" Margin="0,0,11,0" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Path Data="M 8 1.5 L 8 10.5 M 4.8 7.5 L 8 10.7 L 11.2 7.5 M 2.5 13.5 L 13.5 13.5"
                                  Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.5" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chrome for Testing 隔离运行时" Style="{StaticResource RuntimeSectionTitle}"/>
                        <TextBlock Text="官方免安装测试版本，独立存放于 YTray 目录，原生支持命令行加载本地未打包扩展" Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="296"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="114"/><ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RefreshManifestBtn" Content="刷新版本" Click="RefreshManifest_Click" Height="38" FontSize="12.5"/>
                    <ComboBox x:Name="VersionCombo" Grid.Column="2" Height="38" MaxDropDownHeight="260"
                              AutomationProperties.AutomationId="RuntimeVersionCombo"
                              PreviewMouseLeftButtonDown="VersionCombo_PreviewMouseLeftButtonDown"
                              SelectionChanged="VersionCombo_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="32">
                                    <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="12.5"
                                               VerticalAlignment="Center" TextOptions.TextFormattingMode="Display"/>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="InstallBtn" Grid.Column="4" Content="安装此版本" Click="Install_Click"
                            Height="38" FontSize="12.5" Style="{StaticResource YTrayPrimaryButton}"/>
                    <TextBlock x:Name="ManifestStatus" Grid.Column="5" Margin="12,0,8,0" VerticalAlignment="Center"
                               FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>

                    <Grid x:Name="InstallProgressPanel" Grid.Column="6" Visibility="Collapsed" Margin="6,2,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="InstallStatus" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="InstallBytesLabel" Grid.Column="1" Margin="10,0,0,0" FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="InstallProgressBar" Grid.Row="2" Grid.ColumnSpan="2" Height="6" VerticalAlignment="Top"/>
                        <TextBlock x:Name="InstallPercentLabel" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Available Runtimes Card Stream (Replaces 7-Column Spreadsheet!) -->
        <Border Grid.Row="3" Style="{StaticResource SurfaceBorder}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="已就绪的浏览器" Style="{StaticResource RuntimeSectionTitle}"/>
                            <Border Margin="9,0,0,0" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}">
                                <TextBlock x:Name="RuntimeCountLabel" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DefaultRuntimeLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="RuntimeEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="未发现可用浏览器" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="请点击右上角「重新扫描本机」或上方安装 Chrome for Testing" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>

                    <ListBox x:Name="RuntimeList" SelectionChanged="RuntimeSelection_Changed" BorderThickness="0" Background="Transparent"
                             Padding="18,14,18,8" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RuntimeRow_PreviewMouseLeftButtonDown"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" Padding="16,13" CornerRadius="10"
                                                    Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Image Source="{Binding IconSource}" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,16,0">
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Runtime.DisplayTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Border Visibility="{Binding DefaultVisibility}" Style="{StaticResource PillBadge}" Background="{DynamicResource SuccessPaleBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="当前默认" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                                            </Border>
                                            <Border Visibility="{Binding InvalidVisibility}" Style="{StaticResource PillBadge}" Background="{DynamicResource DangerPaleBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="路径失效" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceTitle}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource CodeBadgeBorder}" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                                                <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="v"/><Run Text="{Binding Runtime.VersionLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Runtime.Architecture, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Runtime.ExecutablePath}" Margin="0,5,0,0"
                                                   FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Runtime.ExecutablePath}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="以此启动" Tag="{Binding Runtime}" Click="LaunchRuntime_Click" IsEnabled="{Binding IsAvailable}"
                                                Style="{StaticResource OutlinedAccentButton}" Height="30" MinHeight="0" Padding="12,0" FontSize="12" Margin="0,0,8,0"/>
                                        <Button Tag="{Binding Runtime}" Click="SetDefault_Click" IsEnabled="{Binding CanSetDefault}" Margin="0,0,6,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource RuntimeActionButton}">
                                                    <Setter Property="Content" Value="设为默认"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsDefault}" Value="True"><Setter Property="Content" Value="已默认"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Tag="{Binding Runtime}" Click="OpenFolder_Click"
                                                Style="{StaticResource YTrayIconButton}" ToolTip="打开浏览器所在文件夹"
                                                AutomationProperties.Name="打开浏览器所在文件夹">
                                            <Viewbox Width="15" Height="15"><Path Data="M 1.5 4 L 6.2 4 L 7.7 5.5 L 14.5 5.5 L 14.5 13.5 L 1.5 13.5 Z M 1.5 5.5 L 1.5 2.5 L 6 2.5 L 7.2 4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/></Viewbox>
                                        </Button>
                                        <Button Tag="{Binding Runtime}" Click="Remove_Click" Margin="4,0,0,0"
                                                Style="{StaticResource YTrayDangerIconButton}" ToolTip="{Binding RemoveTooltip}"
                                                Visibility="{Binding RemovableVisibility}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Dedicated Profile Root Footer Strip -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="18,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="新实例数据根目录：" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="ProfileRootButton" Grid.Column="1" Click="ChooseProfileRoot_Click" Margin="6,0,0,0"
                                Height="28" MinHeight="0" Padding="8,0" HorizontalAlignment="Left"
                                Style="{StaticResource YTrayGhostButton}" AutomationProperties.Name="修改新实例数据位置">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Data="M 1.5 4 L 6.2 4 L 7.7 5.5 L 14.5 5.5 L 14.5 13.5 L 1.5 13.5 Z M 1.5 5.5 L 1.5 2.5 L 6 2.5 L 7.2 4" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.25" Fill="Transparent"/></Viewbox>
                                <TextBlock x:Name="ProfileRootText" MaxWidth="520" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ResetProfileRootButton" Grid.Column="2" Content="恢复默认目录" Click="ResetProfileRoot_Click"
                                Height="28" MinHeight="0" Padding="10,0"
                                Style="{StaticResource YTrayGhostButton}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Selected Runtime Command Inspector -->
        <Border x:Name="RuntimeDetails" Grid.Row="5" Style="{StaticResource SurfaceBorder}" Padding="18,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="1"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="浏览器" Style="{StaticResource RuntimeDetailLabel}"/><TextBlock x:Name="DetailBrowser" Grid.Column="1" Style="{StaticResource RuntimeDetailValue}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="来源" Style="{StaticResource RuntimeDetailLabel}"/><TextBlock x:Name="DetailSource" Grid.Row="1" Grid.Column="1" Style="{StaticResource RuntimeDetailValue}"/>
                    <TextBlock Grid.Row="2" Text="版本" Style="{StaticResource RuntimeDetailLabel}"/><TextBlock x:Name="DetailVersion" Grid.Row="2" Grid.Column="1" Style="{StaticResource RuntimeDetailValue}"/>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource HairlineBrush}"/>
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                        <TextBlock Text="可执行文件" Style="{StaticResource RuntimeDetailLabel}"/>
                        <TextBlock x:Name="DetailPath" Grid.Column="1" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                        <Button Grid.Column="2" Click="OpenSelectedFolder_Click" Style="{StaticResource YTrayIconButton}" ToolTip="打开所在文件夹">
                            <Viewbox Width="15" Height="15"><Path Data="M 1.5 4 L 6.2 4 L 7.7 5.5 L 14.5 5.5 L 14.5 13.5 L 1.5 13.5 Z M 1.5 5.5 L 1.5 2.5 L 6 2.5 L 7.2 4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" Fill="Transparent"/></Viewbox>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="命令行示例" Style="{StaticResource RuntimeDetailLabel}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <Border Grid.Column="1" Style="{StaticResource SubtleCardBorder}" Padding="12,8">
                            <TextBlock x:Name="DetailCommand" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
