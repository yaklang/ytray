<Page x:Class="YTray.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="26,21,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
                <StackPanel>
                    <TextBlock Text="启动设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="统一外观、默认启动参数与浏览器网络行为。" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource SuccessBrush}" FontSize="10.5"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="保存设置" Click="Save_Click" Style="{StaticResource YTrayPrimaryButton}" MinWidth="88"/>
                </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="290"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.12*" MinWidth="330"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SurfaceBorder}" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,11">
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource BrandPaleBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="应用外观" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="切换会立即应用到全部窗口" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="主题" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="System"/>
                                <ComboBoxItem Content="浅色" Tag="Light"/>
                                <ComboBoxItem Content="深色" Tag="Dark"/>
                            </ComboBox>
                            <TextBlock x:Name="ThemePreviewLabel" Margin="1,8,0,0" FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SurfaceBorder}" Padding="14">
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="浏览器网络行为" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="WebRTCCheck" Content="限制 WebRTC 非代理 UDP 与本地 IP 暴露" Margin="0,0,0,10"/>
                            <CheckBox x:Name="NotificationsCheck" Content="关闭浏览器通知" Margin="0,0,0,10"/>
                            <CheckBox x:Name="CertCheck" Content="忽略证书错误" Margin="0,0,0,5"/>
                            <TextBlock Text="适合本地代理与调试环境；公开上网时请谨慎使用。" FontSize="9.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="25,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SurfaceBorder}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="默认启动" Style="{StaticResource SectionTitle}" Margin="0,0,0,11"/>
                            <TextBlock Text="启动地址" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                            <TextBox x:Name="HomeUrlBox"/>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="调试端口" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DebugPortBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="端口策略" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <Border Height="34" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}"
                                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="10,0">
                                        <TextBlock Text="占用时自动递增" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource SurfaceBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="9"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="附加 Chrome 参数" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="每行一个 --flag" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                           FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </DockPanel>
                            <TextBox x:Name="FlagsBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="False" MinHeight="76"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap"
                                     VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left"
                                     Padding="11,9" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <TextBlock Grid.Row="4" Text="实例隔离、调试端口、代理和插件参数由 YTray 管理，不能在这里覆盖。"
                                       FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="1,0,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
        </Grid>
    </Grid>
</Page>
