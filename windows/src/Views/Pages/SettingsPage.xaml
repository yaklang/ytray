<Page x:Class="YTray.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      Background="{DynamicResource RegionBrush}">
    <ScrollViewer>
        <StackPanel Margin="28">
            <TextBlock Text="启动设置" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="配置默认启动参数、浏览器精简与附加 Chrome 参数。" Foreground="#888" Margin="0,5,0,24"/>

            <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="启动" FontWeight="Bold" Margin="0,0,0,12"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="启动地址" Width="100" VerticalAlignment="Center"/>
                        <hc:TextBox x:Name="HomeUrlBox" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="调试端口" Width="100" VerticalAlignment="Center"/>
                        <hc:TextBox x:Name="DebugPortBox" DockPanel.Dock="Right" Width="120" hc:InfoElement.Placeholder="9222"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="浏览器精简与网络" FontWeight="Bold" Margin="0,0,0,12"/>
                    <StackPanel Margin="0,0,0,8">
                        <CheckBox x:Name="WebRTCCheck" Content="限制 WebRTC 非代理 UDP 与本地 IP 暴露" Margin="0,4"/>
                        <CheckBox x:Name="NotificationsCheck" Content="关闭浏览器通知" Margin="0,4"/>
                        <CheckBox x:Name="CertCheck" Content="忽略证书错误（默认开启，适合本地网络调试）" Margin="0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="#E8E8E8" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="附加参数" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBox x:Name="FlagsBox" AcceptsReturn="True" Height="130" FontFamily="Consolas" TextWrapping="Wrap"
                             Background="#FAFAFA" BorderBrush="#E0E0E0"/>
                    <TextBlock Text="每行一个 --flag。实例隔离、调试端口和插件参数由 YTray 管理，不能在这里覆盖。"
                               FontSize="11" Foreground="#888" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="保存默认设置" Padding="14,8" Click="Save_Click" Background="#F28B44" Foreground="White" BorderBrush="#F28B44" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</Page>