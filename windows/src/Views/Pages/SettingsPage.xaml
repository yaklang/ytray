<Page x:Class="YTray.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="ThemeOptionButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Height" Value="60"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        </Style>
        <Style x:Key="DockSideSegmentButton" TargetType="Button" BasedOn="{StaticResource YTrayGhostButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1"/>
        </Style>
        <Style x:Key="SettingRowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="SettingRowSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingRowIconBadge" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,20,26,26">
            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="系统与实例偏好" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="统一管理开机驻留、桌面悬浮条、界面主题与隔离浏览器默认行为（开关即时生效）" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="SaveStatusBorder" Visibility="Collapsed" Margin="0,0,10,0" Padding="12,7" CornerRadius="8" Background="{DynamicResource SuccessPaleBrush}">
                        <TextBlock x:Name="SaveStatus" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                    <Button Content="重置默认" Click="Reset_Click" MinWidth="88" Height="36" MinHeight="0" FontSize="12.5"/>
                    <Button Content="保存设置" Click="Save_Click" MinWidth="108" Height="36" MinHeight="0" FontSize="12.5" Margin="9,0,0,0" Style="{StaticResource YTrayPrimaryButton}"/>
                </StackPanel>
            </Grid>

            <!-- Two-Column Main Grid -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                <!-- Left Column: System & Tray + Appearance + Launch Parameters -->
                <StackPanel>
                    <!-- Card 1: System & Desktop Tray -->
                    <Border Style="{StaticResource SurfaceBorder}" Padding="20,16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="系统与桌面驻留" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>

                            <!-- Row 1: Launch at Login -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingRowIconBadge}" Background="{DynamicResource BrandPaleBrush}" BorderThickness="0">
                                    <Path Data="M 8 1.5 L 8 8 M 3.5 3.8 A 5.8 5.8 0 1 0 12.5 3.8" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.5" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="开机自动启动" Style="{StaticResource SettingRowTitle}"/>
                                    <TextBlock x:Name="StartupStatusDetail" Text="登录 Windows 后静默进入系统托盘，不自动拉起浏览器实例。" Style="{StaticResource SettingRowSubtitle}"/>
                                </StackPanel>
                                <ToggleButton x:Name="StartupSwitch" Grid.Column="2" Style="{StaticResource YTrayToggleSwitch}" Click="StartupSwitch_Click" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="46,13,0,13"/>

                            <!-- Row 2: Edge Dock -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingRowIconBadge}">
                                    <Path Data="M 2.5 2.5 L 13.5 2.5 L 13.5 13.5 L 2.5 13.5 Z M 11 5 L 11 11" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="屏幕边缘悬浮条" Style="{StaticResource SettingRowTitle}"/>
                                    <TextBlock Text="贴靠屏幕边缘，悬停或点击快速展开小组件面板。" Style="{StaticResource SettingRowSubtitle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="1" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="DockLeftButton" Content="左缘" Tag="Left" Click="DockSide_Click" Style="{StaticResource DockSideSegmentButton}"/>
                                            <Button x:Name="DockRightButton" Content="右缘" Tag="Right" Click="DockSide_Click" Style="{StaticResource DockSideSegmentButton}"/>
                                        </StackPanel>
                                    </Border>
                                    <ToggleButton x:Name="EdgeDockSwitch" Style="{StaticResource YTrayToggleSwitch}" Click="EdgeDockSwitch_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="46,13,0,13"/>

                            <!-- Row 3: Automatic Updates -->
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingRowIconBadge}">
                                    <Path Data="M 2.5 8 A 5.5 5.5 0 0 1 12.2 4.5 M 12.5 2 L 12.5 5 L 9.5 5 M 13.5 8 A 5.5 5.5 0 0 1 3.8 11.5 M 3.5 14 L 3.5 11 L 6.5 11" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="自动检测应用与插件更新" Style="{StaticResource SettingRowTitle}"/>
                                    <TextBlock Text="后台静默检查新版本并在标题栏提示，不会自动重启浏览器。" Style="{StaticResource SettingRowSubtitle}"/>
                                </StackPanel>
                                <ToggleButton x:Name="AutoUpdateSwitch" Grid.Column="2" Style="{StaticResource YTrayToggleSwitch}" Click="AutoUpdateSwitch_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Visual Theme -->
                    <Border Style="{StaticResource SurfaceBorder}" Padding="20,16" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock x:Name="ThemePreviewLabel" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="界面外观主题" Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="SystemThemeChoice" Tag="System" Click="ThemeChoice_Click" Style="{StaticResource ThemeOptionButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                                            <Ellipse x:Name="SystemThemeCheck" Width="8" Height="8" Fill="{DynamicResource BrandOrangeBrush}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Path Data="M 1.5 2.5 L 14.5 2.5 L 14.5 11 L 1.5 11 Z M 5.5 13.5 L 10.5 13.5 M 8 11 L 8 13.5" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent"/>
                                            <TextBlock Text="跟随系统" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="LightThemeChoice" Grid.Column="2" Tag="Light" Click="ThemeChoice_Click" Style="{StaticResource ThemeOptionButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                                            <Ellipse x:Name="LightThemeCheck" Width="8" Height="8" Fill="{DynamicResource BrandOrangeBrush}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Path Data="M 8 4.7 A 3.3 3.3 0 1 1 7.99 4.7 M 8 0.8 L 8 2.2 M 8 13.8 L 8 15.2 M 0.8 8 L 2.2 8 M 13.8 8 L 15.2 8" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent"/>
                                            <TextBlock Text="浅色模式" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Button x:Name="DarkThemeChoice" Grid.Column="4" Tag="Dark" Click="ThemeChoice_Click" Style="{StaticResource ThemeOptionButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                                            <Ellipse x:Name="DarkThemeCheck" Width="8" Height="8" Fill="{DynamicResource BrandOrangeBrush}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Path Data="M 12.7 12.4 C 8.3 13.9 3.5 11.2 2.7 6.7 C 2.3 4.2 3.2 2 4.9 0.8 C 4.4 5.1 7.5 9.2 11.8 9.2 C 12.7 9.2 13.5 9 14.2 8.6" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent"/>
                                            <TextBlock Text="深色模式" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Default Launch Parameters & Chrome Flags -->
                    <Border Style="{StaticResource SurfaceBorder}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="默认启动参数与命令行 Flags" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="默认起始地址" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="HomeUrlBox" Height="36" MinHeight="0" Padding="11,0" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="自动避让" FontSize="10.5" Foreground="{DynamicResource BrandOrangeBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="基准调试端口" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DockPanel>
                                    <TextBox x:Name="DebugPortBox" Height="36" MinHeight="0" Padding="11,0" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,2,0,6">
                                <Button DockPanel.Dock="Right" Content="填入推荐参数" Click="RestoreFlags_Click" Style="{StaticResource YTrayGhostButton}" Height="24" MinHeight="0" Padding="8,0" FontSize="11" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                <TextBlock Text="附加 Chrome 命令行参数（每行一个）" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="FlagsBox" Height="116" AcceptsReturn="True" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" TextAlignment="Left"
                                     Padding="11,8" Background="{DynamicResource SurfaceMutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Browser Default Isolation & Security Switches -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="20,16" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Border DockPanel.Dock="Right" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center">
                                <TextBlock Text="全局默认" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="隔离实例默认行为" Style="{StaticResource SectionTitle}"/>
                        </DockPanel>

                        <!-- Switch 1 -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="允许 Yakit 自动确认配对" Style="{StaticResource SettingRowTitle}"/>
                                <TextBlock Text="多个引擎时先选择接入目标。仅自动批准当前 YTray 启动或恢复的实例。" Style="{StaticResource SettingRowSubtitle}"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoConnectYakitCheck" Grid.Column="1" Style="{StaticResource YTraySwitchBox}" Click="BehaviorSwitch_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,13"/>

                        <!-- Switch 2 -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="独立身份主题色（A / B / C / D）" Style="{StaticResource SettingRowTitle}"/>
                                <TextBlock Text="为每个新建 Profile 自动注入高辨识度浏览器顶栏色彩，一眼区分多账号身份。" Style="{StaticResource SettingRowSubtitle}"/>
                            </StackPanel>
                            <CheckBox x:Name="ColorizeCheck" Grid.Column="1" Style="{StaticResource YTraySwitchBox}" Click="BehaviorSwitch_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,13"/>

                        <!-- Switch 3 -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="限制 WebRTC 非代理 UDP 泄漏" Style="{StaticResource SettingRowTitle}"/>
                                <TextBlock Text="防止挂代理测试时通过 WebRTC 暴露真实内网或出口 IP 地址。" Style="{StaticResource SettingRowSubtitle}"/>
                            </StackPanel>
                            <CheckBox x:Name="WebRTCCheck" Grid.Column="1" Style="{StaticResource YTraySwitchBox}" Click="BehaviorSwitch_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,13"/>

                        <!-- Switch 4 -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="忽略 HTTPS 证书校验错误" Style="{StaticResource SettingRowTitle}"/>
                                <TextBlock Text="自动放行自签名证书与本地抓包中间人证书，避免反复点击高级确认。" Style="{StaticResource SettingRowSubtitle}"/>
                            </StackPanel>
                            <CheckBox x:Name="CertCheck" Grid.Column="1" Style="{StaticResource YTraySwitchBox}" Click="BehaviorSwitch_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,13"/>

                        <!-- Switch 5 -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="屏蔽浏览器桌面通知弹窗" Style="{StaticResource SettingRowTitle}"/>
                                <TextBlock Text="禁止被测站点请求或弹出系统级通知，保持测试环境干净。" Style="{StaticResource SettingRowSubtitle}"/>
                            </StackPanel>
                            <CheckBox x:Name="NotificationsCheck" Grid.Column="1" Style="{StaticResource YTraySwitchBox}" Click="BehaviorSwitch_Click" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,13"/>

                        <!-- Switch 6 -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="启用测试模式（--test-type）" Style="{StaticResource SettingRowTitle}"/>
                                <TextBlock Text="隐藏 Chrome 顶部「不受支持的命令行标记」警告横幅。" Style="{StaticResource SettingRowSubtitle}"/>
                            </StackPanel>
                            <CheckBox x:Name="TestTypeCheck" Grid.Column="1" Style="{StaticResource YTraySwitchBox}" Click="BehaviorSwitch_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
