<Page x:Class="YTray.Views.Pages.SystemControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="ControlCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="ControlButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="16,0"/><Setter Property="FontSize" Value="13"/>
        </Style>
    </Page.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,22">
            <TextBlock Text="电脑控制" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="开启一次，即可通过 MCP 观察和操作这台电脑。" FontSize="13" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ControlCard}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,10,0"/><TextBlock x:Name="StatusText" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                <TextBlock x:Name="StatusDetailText" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="19,9,0,0"/>
                <WrapPanel Margin="0,22,0,0">
                    <Button x:Name="ToggleControlButton" Content="授权开启" Click="Toggle_Click" Style="{StaticResource ControlButton}" Background="{DynamicResource BrandOrangeBrush}" Foreground="White" Margin="0,0,10,6"/>
                    <Button x:Name="CopyConfigButton" Content="复制电脑控制配置" Click="CopyConfig_Click" Style="{StaticResource ControlButton}" Margin="0,0,10,6"/>
                    <Button x:Name="ToolsButton" Content="查看 MCP 工具" Click="Tools_Click" Style="{StaticResource ControlButton}" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock x:Name="FeedbackText" FontSize="12" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource ControlCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="本机应用" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="查看窗口的原生控件布局和最近失败的步骤。" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="分析应用" Style="{StaticResource ControlButton}" Click="InspectApps_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ControlCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="执行流水线" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="查看顶部状态卡片和实际 MCP 调用记录。" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PreviewPipelineButton" Content="预览顶部卡片" Style="{StaticResource ControlButton}" Click="PreviewPipeline_Click" Margin="0,0,7,0"/>
                            <Button Content="查看 Trace" Style="{StaticResource ControlButton}" Click="Trace_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ControlCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="已允许的能力" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="全部应用 · 截图与控件读取 · 点击 · 输入 · 按键 · 滚动" FontSize="13" Margin="0,11,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="无需选择应用或设置有效期，保持总开关开启即可随时使用。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6" Padding="12,10" Margin="0,18,0,0">
                            <TextBlock x:Name="EndpointText" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ControlCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="控制权限" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PermissionText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="RepairButton" Grid.Column="1" Click="Repair_Click" Style="{StaticResource ControlButton}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="修复控制权限"/></StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Text="电脑控制使用当前登录用户的真实桌面。可随时从这里、小组件或托盘关闭。" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,16,2,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
