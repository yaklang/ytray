<Page x:Class="YTray.Views.Pages.SystemControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="ControlCard" TargetType="Border" BasedOn="{StaticResource SurfaceBorder}">
            <Setter Property="Padding" Value="20,17"/>
        </Style>
        <Style x:Key="ControlButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="ControlPrimaryButton" TargetType="Button" BasedOn="{StaticResource YTrayPrimaryButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ControlDangerButton" TargetType="Button" BasedOn="{StaticResource YTrayDangerOutlineButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CapabilityChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="CapabilityChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,20,26,20">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="电脑控制工作台" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="授权本机 AI Agent 观察 Windows 原生 UIA 控件树、桌面画面并执行可视化自动化操作" Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border x:Name="ElevationBadge" Grid.Column="1" VerticalAlignment="Center" CornerRadius="12" Padding="11,5"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ElevationDot" Width="7" Height="7" Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ElevationBadgeText" Text="标准用户会话" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Master Hero Card -->
            <Border Style="{StaticResource ControlCard}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="HeroIconBadge" Width="46" Height="46" CornerRadius="12" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Path x:Name="HeroIconPath" Data="M 1 2 L 15 2 L 15 11 L 1 11 Z M 8 11 L 8 15 M 4 15 L 12 15"
                              Width="21" Height="21" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.55" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource CodeBadgeBorder}" Padding="10,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="MCP  " FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrandOrangeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EndpointText" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock x:Name="StatusDetailText" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="ToggleControlButton" Content="授权开启" Click="Toggle_Click" Style="{StaticResource ControlPrimaryButton}" Margin="0,0,9,0"/>
                            <Button x:Name="CopyConfigButton" Content="复制电脑控制配置" Click="CopyConfig_Click" Style="{StaticResource OutlinedAccentButton}" Height="36" MinHeight="0" Padding="15,0" FontSize="12.5" Margin="0,0,9,0"/>
                            <Button x:Name="ToolsButton" Content="查看 MCP 工具" Click="Tools_Click" Style="{StaticResource ControlButton}"/>
                        </WrapPanel>

                        <Border x:Name="FeedbackBorder" Visibility="Collapsed" Margin="0,10,0,0" Padding="11,7" CornerRadius="7" Background="{DynamicResource SuccessPaleBrush}">
                            <TextBlock x:Name="FeedbackText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <Border x:Name="ErrorBorder" Visibility="Collapsed" Margin="0,10,0,0" Padding="11,7" CornerRadius="7" Background="{DynamicResource DangerPaleBrush}">
                            <TextBlock x:Name="ErrorText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2-Column Observability & Diagnostic Studio Cards -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Left Studio Card: UIA Application Inspector -->
                <Border Style="{StaticResource ControlCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Path Data="M 2 4 L 8 1.5 L 14 4 L 8 6.5 Z M 2 8 L 8 10.5 L 14 8 M 2 11.8 L 8 14.3 L 14 11.8"
                                      Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.35" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="本机应用分析 (Inspector)" FontSize="14.5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Top">
                                <TextBlock Text="UIA 控件树" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,14">
                            <TextBlock Text="可视化勘察任意桌面窗口的 UI Automation 控件层级、屏幕像素包围盒、截图叠加与最近失败断点。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18.5"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource CodeBadgeBorder}" Margin="0,0,6,0"><TextBlock Text="控件画布缩放" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                                <Border Style="{StaticResource CodeBadgeBorder}" Margin="0,0,6,0"><TextBlock Text="目标窗口高亮" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                                <Border Style="{StaticResource CodeBadgeBorder}"><TextBlock Text="失败步骤复盘" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                            </WrapPanel>
                        </StackPanel>

                        <Button Grid.Row="2" Style="{StaticResource OutlinedAccentButton}" Height="36" MinHeight="0" Padding="16,0" FontSize="12.5" Click="InspectApps_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="M 2 4 L 8 1.5 L 14 4 L 8 6.5 Z M 2 8.5 L 8 11 L 14 8.5 M 2 12 L 8 14.5 L 14 12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="打开本机应用分析"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Studio Card: Execution Pipeline & Trace Viewer -->
                <Border Grid.Column="2" Style="{StaticResource ControlCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Path Data="M 1.5 8 L 4.5 8 L 6.5 3 L 9.5 13 L 11.5 8 L 14.5 8"
                                      Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.45" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="执行流水线与 Trace 回放" FontSize="14.5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Top">
                                <TextBlock Text="调用审计" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,10,0,14">
                            <TextBlock Text="实时预览屏幕顶部非阻塞操作状态条，或按任务回放历史 MCP 调用链、子阶段耗时瀑布图与 JSON 载荷。"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18.5"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource CodeBadgeBorder}" Margin="0,0,6,0"><TextBlock Text="跨会话任务聚合" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                                <Border Style="{StaticResource CodeBadgeBorder}" Margin="0,0,6,0"><TextBlock Text="阶段瀑布耗时" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                                <Border Style="{StaticResource CodeBadgeBorder}"><TextBlock Text="原始请求/响应" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Style="{StaticResource OutlinedAccentButton}" Height="36" MinHeight="0" Padding="16,0" FontSize="12.5" Click="Trace_Click" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Path Data="M 1.5 8 L 4.5 8 L 6.5 3 L 9.5 13 L 11.5 8 L 14.5 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                    <TextBlock Text="查看 Trace 回放"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PreviewPipelineButton" Content="预览顶部卡片" Style="{StaticResource ControlButton}" Click="PreviewPipeline_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom 2-Column Capabilities & UAC Permission Row -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Authorized Capabilities Matrix -->
                <Border Style="{StaticResource ControlCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}" VerticalAlignment="Center">
                                <TextBlock Text="本机回环保护" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="已允许的能力矩阵" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel>
                            <Border Style="{StaticResource CapabilityChip}"><TextBlock Text="桌面窗口与应用发现" Style="{StaticResource CapabilityChipText}"/></Border>
                            <Border Style="{StaticResource CapabilityChip}"><TextBlock Text="原生 UIA 控件树读取" Style="{StaticResource CapabilityChipText}"/></Border>
                            <Border Style="{StaticResource CapabilityChip}"><TextBlock Text="窗口渲染与主屏截图" Style="{StaticResource CapabilityChipText}"/></Border>
                            <Border Style="{StaticResource CapabilityChip}"><TextBlock Text="元素与像素坐标点击" Style="{StaticResource CapabilityChipText}"/></Border>
                            <Border Style="{StaticResource CapabilityChip}"><TextBlock Text="Unicode 文本与快捷键" Style="{StaticResource CapabilityChipText}"/></Border>
                            <Border Style="{StaticResource CapabilityChip}"><TextBlock Text="画面复核与滚轮控制" Style="{StaticResource CapabilityChipText}"/></Border>
                        </WrapPanel>
                        <TextBlock Text="保持总开关开启即可随时响应可信客户端；在页面、托盘小组件或右键菜单关闭后旧凭据立即失效。"
                                   FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Privilege & Desktop Isolation Repair -->
                <Border Grid.Column="2" Style="{StaticResource ControlCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="控制权限与 UAC 隔离修复" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" x:Name="PermissionText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,14" TextWrapping="Wrap" LineHeight="18.5"/>
                        <Button Grid.Row="2" x:Name="RepairButton" Click="Repair_Click" Style="{StaticResource ControlButton}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="M 8 1.5 L 13.5 3.8 L 13.5 8.2 C 13.5 11.4 11.1 13.8 8 14.8 C 4.9 13.8 2.5 11.4 2.5 8.2 L 2.5 3.8 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="修复控制权限"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
