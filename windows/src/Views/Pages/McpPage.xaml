<Page x:Class="YTray.Views.Pages.McpPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="McpSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="24"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Grid Background="Transparent"><Border x:Name="Track" Height="20" CornerRadius="10" Background="{DynamicResource TextTertiaryBrush}"/>
                    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SuccessBrush}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="McpButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="13,0"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style x:Key="McpDetails" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton Style="{x:Null}" Width="Auto" Height="Auto" MinHeight="34" HorizontalAlignment="Stretch"
                                  Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="5" Padding="10,7">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <TextBlock Grid.Column="1" Text="⌄" Margin="10,0,0,0" Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="Details" Visibility="Collapsed" ContentSource="Content"/>
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20">
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="MCP" Style="{StaticResource PageTitle}"/><TextBlock Text="两个独立服务：管理 YTray，或操作整台电脑。" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                <Button x:Name="CopyBothButton" Grid.Column="1" Content="复制两个 MCP 配置" Click="CopyBoth_Click" Style="{StaticResource McpButton}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
            <Border Style="{StaticResource SurfaceBorder}" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="YTray MCP" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="管理浏览器运行时、打开实例、聚焦窗口与停止实例。" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <ToggleButton x:Name="ServiceToggle" Grid.Column="1" Style="{StaticResource McpSwitch}" Click="ServiceToggle_Changed" VerticalAlignment="Top" Margin="16,0,0,0" AutomationProperties.Name="YTray MCP 开关"/>
                    </Grid>
                    <TextBlock x:Name="ServiceStatusDetail" Margin="0,12,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="EndpointText" FontFamily="Consolas" FontSize="12" Margin="0,8,0,14" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button x:Name="CopyConfigButton" Content="复制 YTray 配置" Click="CopyConfig_Click" Style="{StaticResource McpButton}"/>
                        <Button x:Name="CopyEndpointButton" Content="复制地址" Click="CopyEndpoint_Click" Style="{StaticResource McpButton}"/>
                        <CheckBox x:Name="AutoStartToggle" Content="随 YTray 自动启动" Click="AutoStartToggle_Changed" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </WrapPanel>
                    <Expander Header="工具与连接配置" Style="{StaticResource McpDetails}" Margin="0,14,0,0" FontSize="12">
                        <StackPanel Margin="0,12,0,0"><TextBlock Text="list_browser_runtimes · list_browser_instances · open_browser_instance · focus_browser_instance · stop_browser_instance" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="ConfigTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" Padding="10" Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource HairlineBrush}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceBorder}" Padding="20">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="电脑控制 MCP" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="发现应用和窗口、截图、点击、输入、按键与滚动。" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                        <ToggleButton x:Name="ComputerToggle" Grid.Column="1" Style="{StaticResource McpSwitch}" Click="ComputerToggle_Click" VerticalAlignment="Top" Margin="16,0,0,0" AutomationProperties.Name="电脑控制 MCP 开关"/>
                    </Grid>
                    <TextBlock x:Name="ComputerStatusText" Margin="0,12,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ComputerEndpointText" FontFamily="Consolas" FontSize="12" Margin="0,8,0,14" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button x:Name="CopyComputerButton" Content="复制电脑控制配置" Click="CopyComputer_Click" Style="{StaticResource McpButton}"/>
                        <Button Content="工具与参数" Click="ComputerTools_Click" Style="{StaticResource McpButton}"/>
                        <Button Content="高级" Click="ComputerSettings_Click" Style="{StaticResource McpButton}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ConnectionHint" Margin="0,14,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CopyFeedback" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource BrandOrangeBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
