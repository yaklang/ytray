<Page x:Class="YTray.Views.Pages.McpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="McpButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Height" Value="33"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="McpAccentButton" TargetType="Button" BasedOn="{StaticResource OutlinedAccentButton}">
            <Setter Property="Height" Value="33"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="McpInlineCopyButton" TargetType="Button" BasedOn="{StaticResource YTrayGhostButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOrangeBrush}"/>
        </Style>
        <Style x:Key="McpToolChip" TargetType="Border" BasedOn="{StaticResource CodeBadgeBorder}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>
        <Style x:Key="McpToolChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="McpDetails" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{x:Null}" Width="Auto" Height="Auto" MinHeight="34" HorizontalAlignment="Stretch" Cursor="Hand"
                                          Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bar" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="7" Padding="12,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                <Path x:Name="Chevron" Grid.Column="1" Data="M 1 2 L 5 6 L 9 2" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Details" Visibility="Collapsed" ContentSource="Content"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,20,26,22">
            <!-- Page Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MCP 网关服务" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                        <Border x:Name="ActiveSummaryBadge" Margin="12,2,0,0" CornerRadius="12" Padding="10,3"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ActiveSummaryDot" Width="7" Height="7" Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ActiveSummaryText" Text="0 / 3 项服务运行中" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="向 Claude Desktop、Cursor 等本机 AI 客户端暴露隔离浏览器编排、共享网页操作与桌面级电脑控制能力"
                               Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border x:Name="CopyFeedbackBorder" Visibility="Collapsed" Margin="0,0,10,0" Padding="11,6"
                            CornerRadius="8" Background="{DynamicResource BrandPaleBrush}" BorderBrush="{DynamicResource BrandOrangeBrush}" BorderThickness="1">
                        <TextBlock x:Name="CopyFeedback" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrandOrangeBrush}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button x:Name="CopyBothButton" Click="CopyBoth_Click" Style="{StaticResource OutlinedAccentButton}" Height="38" MinHeight="0" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Path Data="M 5 2 L 13 2 L 13 10 L 5 10 Z M 3 6 L 3 14 L 11 14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                            <TextBlock Text="复制两个 MCP 配置"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Hero Card: YTray Orchestration MCP -->
            <Border Style="{StaticResource SurfaceBorder}" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Path Data="M 3 2.5 L 13 2.5 L 13 6.5 L 3 6.5 Z M 3 9.5 L 13 9.5 L 13 13.5 L 3 13.5 Z M 5 4.5 L 5.1 4.5 M 5 11.5 L 5.1 11.5"
                                  Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.5" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="YTray 实例编排 MCP" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border x:Name="ServiceStateBadge" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ServiceStateBadgeText" Text="未开启" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="列出可用浏览器与运行实例，一键创建独立身份环境、恢复历史会话、聚焦窗口与停止实例。"
                                       Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                            <Border CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}" Padding="10,5" Margin="0,0,14,0" VerticalAlignment="Center">
                                <CheckBox x:Name="AutoStartToggle" Content="随 YTray 自动启动" Click="AutoStartToggle_Changed" FontSize="11.5" VerticalAlignment="Center"/>
                            </Border>
                            <ToggleButton x:Name="ServiceToggle" Style="{StaticResource YTrayToggleSwitch}" Click="ServiceToggle_Changed" VerticalAlignment="Center" AutomationProperties.Name="YTray MCP 开关"/>
                        </StackPanel>
                    </Grid>

                    <!-- Capability Tool Chips -->
                    <WrapPanel Margin="0,12,0,2">
                        <Border Style="{StaticResource McpToolChip}"><TextBlock Text="list_browser_runtimes" Style="{StaticResource McpToolChipText}"/></Border>
                        <Border Style="{StaticResource McpToolChip}"><TextBlock Text="list_browser_instances" Style="{StaticResource McpToolChipText}"/></Border>
                        <Border Style="{StaticResource McpToolChip}"><TextBlock Text="open_browser_instance" Style="{StaticResource McpToolChipText}"/></Border>
                        <Border Style="{StaticResource McpToolChip}"><TextBlock Text="focus_browser_instance" Style="{StaticResource McpToolChipText}"/></Border>
                        <Border Style="{StaticResource McpToolChip}"><TextBlock Text="stop_browser_instance" Style="{StaticResource McpToolChipText}"/></Border>
                    </WrapPanel>

                    <!-- Endpoint & Quick Copy Slot -->
                    <Border Style="{StaticResource SubtleCardBorder}" Padding="12,8" Margin="0,8,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border CornerRadius="5" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="HTTP" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrandOrangeBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="EndpointText" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" x:Name="ServiceStatusDetail" Margin="12,0,12,0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="CopyEndpointButton" Content="复制地址" Click="CopyEndpoint_Click" Style="{StaticResource McpInlineCopyButton}" Margin="0,0,4,0"/>
                                <Button x:Name="CopyConfigButton" Content="复制 YTray 配置" Click="CopyConfig_Click" Style="{StaticResource McpAccentButton}" Height="28" Padding="11,0" FontSize="11.5"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander Header="展开查看客户端 JSON 配置模板" Style="{StaticResource McpDetails}" FontSize="12" FontWeight="Medium">
                        <TextBox x:Name="ConfigTextBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,8,0,0" Padding="12,10"
                                 VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                 Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource HairlineBrush}"/>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- 2-Column Authenticated Gateways: Computer Control MCP & Browser Page Control MCP -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- Left Card: Computer Control MCP -->
                <Border Style="{StaticResource SurfaceBorder}" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="ComputerIconBadge" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Path Data="M 1 2 L 15 2 L 15 11 L 1 11 Z M 8 11 L 8 15 M 4 15 L 12 15"
                                      Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.45" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="电脑控制 MCP" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Bearer 鉴权" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="读取原生窗口与 UIA 控件树、屏幕截图、光标点击、文本输入与滚轮滚动。"
                                           Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18"/>
                            </StackPanel>
                            <ToggleButton x:Name="ComputerToggle" Grid.Column="2" Style="{StaticResource YTrayToggleSwitch}" Click="ComputerToggle_Click" VerticalAlignment="Top" Margin="12,2,0,0" AutomationProperties.Name="电脑控制 MCP 开关"/>
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="get_window_state" Style="{StaticResource McpToolChipText}"/></Border>
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="click" Style="{StaticResource McpToolChipText}"/></Border>
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="type_text" Style="{StaticResource McpToolChipText}"/></Border>
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="press_key" Style="{StaticResource McpToolChipText}"/></Border>
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="+11 项" Style="{StaticResource McpToolChipText}"/></Border>
                        </WrapPanel>

                        <Border Grid.Row="3" Style="{StaticResource SubtleCardBorder}" Padding="12,9" Margin="0,10,0,12">
                            <StackPanel>
                                <TextBlock x:Name="ComputerEndpointText" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ComputerStatusText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Grid.Row="4">
                            <Button x:Name="CopyComputerButton" Content="复制电脑控制配置" Click="CopyComputer_Click" Style="{StaticResource McpAccentButton}" Margin="0,0,8,0"/>
                            <Button Content="工具与参数" Click="ComputerTools_Click" Style="{StaticResource McpButton}" Margin="0,0,8,0"/>
                            <Button Content="高级设置" Click="ComputerSettings_Click" Style="{StaticResource McpButton}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Right Card: Browser Page Control MCP -->
                <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Path Data="M 8 1 A 7 7 0 1 1 7.99 1 M 1 8 L 15 8 M 8 1 C 4.5 4.5 4.5 11.5 8 15 M 8 1 C 11.5 4.5 11.5 11.5 8 15"
                                      Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.45" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="浏览器页面控制 MCP" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Bearer 鉴权" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="在已授权共享的标签页与托管实例内执行网页打开、DOM 快照读取、点击与表单填写。"
                                           Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18"/>
                            </StackPanel>
                            <ToggleButton x:Name="BrowserToggle" Grid.Column="2" Style="{StaticResource YTrayToggleSwitch}" Click="BrowserToggle_Click" VerticalAlignment="Top" Margin="12,2,0,0" AutomationProperties.Name="浏览器控制 MCP 开关"/>
                        </Grid>

                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="browser_open" Style="{StaticResource McpToolChipText}"/></Border>
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="browser_snapshot" Style="{StaticResource McpToolChipText}"/></Border>
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="browser_click" Style="{StaticResource McpToolChipText}"/></Border>
                            <Border Style="{StaticResource McpToolChip}"><TextBlock Text="browser_type" Style="{StaticResource McpToolChipText}"/></Border>
                        </WrapPanel>

                        <Border Grid.Row="3" Style="{StaticResource SubtleCardBorder}" Padding="12,9" Margin="0,10,0,12">
                            <StackPanel>
                                <TextBlock x:Name="BrowserEndpointText" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="BrowserStatusText" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel Grid.Row="4">
                            <Button x:Name="CopyBrowserButton" Content="复制浏览器控制配置" Click="CopyBrowser_Click" Style="{StaticResource McpAccentButton}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Security Callout Footer -->
            <Border Style="{StaticResource SubtleCardBorder}" Padding="14,10" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="14" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Path Data="M 8 1.5 L 13.5 3.8 L 13.5 8.2 C 13.5 11.4 11.1 13.8 8 14.8 C 4.9 13.8 2.5 11.4 2.5 8.2 L 2.5 3.8 Z"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.35" Fill="Transparent" StrokeLineJoin="Round"/>
                    </Viewbox>
                    <TextBlock x:Name="ConnectionHint" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
