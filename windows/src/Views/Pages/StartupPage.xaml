<Page x:Class="YTray.Views.Pages.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="开机启动" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="登录 Windows 后自动将 YTray 静默驻留到系统托盘，随时待命而不打扰桌面"
                       Style="{StaticResource PageSubtitle}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Hero Card -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Padding="24,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,24,0">
                    <TextBlock x:Name="StatusTitle" Text="已开启" FontSize="18.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusDetail" Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" LineHeight="19"/>
                </StackPanel>
                <Button x:Name="ToggleButton" Grid.Column="2" MinWidth="136" Height="40" Padding="18,0" Click="Toggle_Click"
                        Style="{StaticResource YTrayPrimaryButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Two Feature Cards -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceBorder}" Padding="22,20">
                <StackPanel>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Path Data="M 8 1.5 L 13.5 3.8 L 13.5 8.2 C 13.5 11.4 11.1 13.8 8 14.8 C 4.9 13.8 2.5 11.4 2.5 8.2 L 2.5 3.8 Z"
                              Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round"/>
                    </Border>
                    <TextBlock Text="默认开启，始终由你掌控" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="安装版首次启动时会写入当前用户注册表启动项并明确告知状态。关闭前需要二次确认，防止清理或误触导致服务掉线。"
                               Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Padding="22,20">
                <StackPanel>
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Path Data="M 2 3 L 14 3 L 14 13 L 2 13 Z M 2 6 L 14 6"
                              Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" Fill="Transparent" StrokeLineJoin="Round"/>
                    </Border>
                    <TextBlock Text="静默入驻托盘，不自动拉起浏览器" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="登录系统时仅后台启动 YTray 托盘与已启用的本机 MCP 网关，不会弹出窗口或自动恢复任何浏览器实例。"
                               Margin="0,8,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
