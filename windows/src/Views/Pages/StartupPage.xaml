<Page x:Class="YTray.Views.Pages.StartupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="30,25,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="开机启动" Style="{StaticResource PageTitle}" FontSize="28"/>
            <TextBlock Text="让 YTray 在你登录系统后自动进入托盘，不自动打开浏览器实例。"
                       Style="{StaticResource PageSubtitle}" FontSize="13" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Padding="24,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource BrandPaleBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,24,0">
                    <TextBlock x:Name="StatusTitle" Text="已开启" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusDetail" Margin="0,7,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"/>
                </StackPanel>
                <Button x:Name="ToggleButton" Grid.Column="2" Width="138" Height="42" Click="Toggle_Click"
                        Style="{StaticResource YTrayPrimaryButton}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SurfaceBorder}" Padding="24,22">
            <StackPanel>
                <TextBlock Text="默认开启，但始终由你掌控" Style="{StaticResource SectionTitle}" FontSize="16"/>
                <TextBlock Text="YTray 首次启动时会尝试开启，并明确告诉你结果。关闭操作需要再次确认，防止误触。"
                           Margin="0,9,0,20" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="不会自动启动浏览器" Style="{StaticResource SectionTitle}" FontSize="16"/>
                <TextBlock Text="此设置只让 YTray 驻留系统托盘。代理、插件和浏览器实例仍需由你点击启动。"
                           Margin="0,9,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
