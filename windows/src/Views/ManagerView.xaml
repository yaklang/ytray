<Window x:Class="YTray.Views.ManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YTray" Width="980" Height="560" MinWidth="860" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="9,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Padding="11,0" CornerRadius="8" Background="Transparent">
                            <Grid>
                                <Border x:Name="Accent" Width="3" Height="18" CornerRadius="2"
                                        Background="{DynamicResource BrandOrangeBrush}" HorizontalAlignment="Left"
                                        Margin="-11,0,0,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrandOrangeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
        </Style>
        <Style x:Key="ThemeChoiceButton" TargetType="Button" BasedOn="{StaticResource YTrayGhostButton}">
            <Setter Property="Width" Value="184"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Geometry x:Key="ThemeSystemIcon">M 1.5 2.5 L 14.5 2.5 L 14.5 11 L 1.5 11 Z M 5.5 13.5 L 10.5 13.5 M 8 11 L 8 13.5</Geometry>
        <Geometry x:Key="ThemeLightIcon">M 8 4.7 A 3.3 3.3 0 1 1 7.99 4.7 Z M 8 0.8 L 8 2.2 M 8 13.8 L 8 15.2 M 0.8 8 L 2.2 8 M 13.8 8 L 15.2 8 M 2.9 2.9 L 3.9 3.9 M 12.1 12.1 L 13.1 13.1 M 13.1 2.9 L 12.1 3.9 M 3.9 12.1 L 2.9 13.1</Geometry>
        <Geometry x:Key="ThemeDarkIcon">M 12.7 12.4 C 8.3 13.9 3.5 11.2 2.7 6.7 C 2.3 4.2 3.2 2 4.9 0.8 C 4.4 5.1 7.5 9.2 11.8 9.2 C 12.7 9.2 13.5 9 14.2 8.6 C 14 10.2 13.5 11.4 12.7 12.4 Z</Geometry>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
            Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
                        <Border Width="19" Height="19" CornerRadius="6" Background="{DynamicResource BrandOrangeBrush}">
                            <TextBlock Text="Y" Foreground="White" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="YTray" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="  /  浏览器实例工作台" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeButton" Style="{StaticResource WindowControlButton}" Width="42"
                                Click="ThemeButton_Click" ToolTip="外观主题">
                            <Viewbox Width="17" Height="17">
                                <Path x:Name="ThemeButtonIcon" Data="{StaticResource ThemeSystemIcon}" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource WindowControlButton}" Click="Minimize_Click" ToolTip="最小化">
                            <Path Data="M 0 0 L 10 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Click="Maximize_Click" ToolTip="最大化">
                            <Path x:Name="MaximizeIcon" Data="M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="关闭">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" StrokeStartLineCap="Square" StrokeEndLineCap="Square"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                    <Popup x:Name="ThemePopup" Grid.Column="1" PlacementTarget="{Binding ElementName=ThemeButton}"
                           Placement="Bottom" HorizontalOffset="-151" VerticalOffset="5"
                           AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="196" Padding="6" CornerRadius="11"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.22"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="外观主题" Margin="10,6,10,5" FontSize="10"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <Button x:Name="SystemThemeButton" Tag="System" Click="ThemeChoice_Click" Style="{StaticResource ThemeChoiceButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Data="{StaticResource ThemeSystemIcon}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="跟随系统" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="随 Windows 自动切换" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}"/></StackPanel>
                                        <Path x:Name="SystemThemeCheck" Grid.Column="2" Data="M 1 5 L 4 8 L 10 1" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="LightThemeButton" Tag="Light" Click="ThemeChoice_Click" Style="{StaticResource ThemeChoiceButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Data="{StaticResource ThemeLightIcon}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox>
                                        <TextBlock Grid.Column="1" Text="浅色" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <Path x:Name="LightThemeCheck" Grid.Column="2" Data="M 1 5 L 4 8 L 10 1" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="DarkThemeButton" Tag="Dark" Click="ThemeChoice_Click" Style="{StaticResource ThemeChoiceButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Data="{StaticResource ThemeDarkIcon}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Viewbox>
                                        <TextBlock Grid.Column="1" Text="深色" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <Path x:Name="DarkThemeCheck" Grid.Column="2" Data="M 1 5 L 4 8 L 10 1" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="194"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="17,18,15,13">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource BrandOrangeBrush}">
                                    <TextBlock Text="Y" Foreground="White" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="YTray" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="多实例浏览器控制台" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="11,0,11,11">
                            <Border Padding="10,9" CornerRadius="8" Background="{DynamicResource SurfaceMutedBrush}"
                                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Ellipse x:Name="RunningDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="SidebarStatus" Text="0 个实例运行中" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource NavListBoxItem}" SelectionMode="Single">
                            <ListBoxItem x:Name="NavQuick" Tag="quick" IsSelected="True" Selected="Nav_Selected">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource NavIcon}"/><TextBlock Text="快速配置" Style="{StaticResource NavText}"/></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="NavRuntimes" Tag="runtimes" Selected="Nav_Selected">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource NavIcon}"/><TextBlock Text="浏览器来源" Style="{StaticResource NavText}"/></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="NavSettings" Tag="settings" Selected="Nav_Selected">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="启动设置" Style="{StaticResource NavText}"/></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="NavInstances" Tag="instances" Selected="Nav_Selected">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock Text="运行与历史" Style="{StaticResource NavText}"/></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="NavPlugins" Tag="plugins" Selected="Nav_Selected">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xECAA;" Style="{StaticResource NavIcon}"/><TextBlock Text="插件管理" Style="{StaticResource NavText}"/></StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
                       Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0"
                       BorderBrush="Transparent" Padding="0" FocusVisualStyle="{x:Null}">
                    <Frame.Template>
                        <!-- WPF's stock Frame template paints a system-coloured border around
                             PART_FrameCP. In a dark custom window that becomes a bright L-shaped
                             line. The manager already owns its title/sidebar separators, so the
                             navigation host must be visually neutral. -->
                        <ControlTemplate TargetType="{x:Type Frame}">
                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <AdornerDecorator>
                                    <ContentPresenter x:Name="PART_FrameCP"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                                </AdornerDecorator>
                            </Border>
                        </ControlTemplate>
                    </Frame.Template>
                </Frame>
            </Grid>
        </Grid>
    </Border>
</Window>
