<Window x:Class="YTray.Views.ManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="YTray" Width="1280" Height="804" MinWidth="1060" MinHeight="680"
        Icon="pack://application:,,,/Assets/Icons/ytray-app.ico"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="UpdateCardBorderBrush" Color="{DynamicResource BrandOrangeColor}" Opacity="0.34"/>

        <Style x:Key="NavGroupHeaderItem" TargetType="ListBoxItem">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="18,14,14,5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGroupHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
        </Style>

        <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Padding="13,0,11,0" CornerRadius="8" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Accent" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{DynamicResource BrandOrangeBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-13,0,0,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrandOrangeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIconPath" TargetType="Path">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
            <Setter Property="StrokeThickness" Value="1.45"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        </Style>

        <Style x:Key="ThemeChoiceButton" TargetType="Button" BasedOn="{StaticResource YTrayGhostButton}">
            <Setter Property="Width" Value="192"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="UpdateVersionButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="9,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Available">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource UpdatePaleBrush}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource UpdateTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="ThemeSystemIcon">M 1.5 2.5 L 14.5 2.5 L 14.5 11 L 1.5 11 Z M 5.5 13.5 L 10.5 13.5 M 8 11 L 8 13.5</Geometry>
        <Geometry x:Key="ThemeLightIcon">M 8 4.7 A 3.3 3.3 0 1 1 7.99 4.7 Z M 8 0.8 L 8 2.2 M 8 13.8 L 8 15.2 M 0.8 8 L 2.2 8 M 13.8 8 L 15.2 8 M 2.9 2.9 L 3.9 3.9 M 12.1 12.1 L 13.1 13.1 M 13.1 2.9 L 12.1 3.9 M 3.9 12.1 L 2.9 13.1</Geometry>
        <Geometry x:Key="ThemeDarkIcon">M 12.7 12.4 C 8.3 13.9 3.5 11.2 2.7 6.7 C 2.3 4.2 3.2 2 4.9 0.8 C 4.4 5.1 7.5 9.2 11.8 9.2 C 12.7 9.2 13.5 9 14.2 8.6 C 14 10.2 13.5 11.4 12.7 12.4 Z</Geometry>
        <Geometry x:Key="LogsIconGeometry">M 3 1.5 L 10.5 1.5 L 14 5 L 14 14.5 L 3 14.5 Z M 10.5 1.5 L 10.5 5 L 14 5 M 5.5 8 L 11.5 8 M 5.5 11 L 11.5 11</Geometry>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
            Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- Top Window Chrome -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/Icons/ytray-app.ico" Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="YTray" Margin="10,0,0,0" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="· 多身份工作台" Margin="8,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="VersionButton" Click="VersionButton_Click" Style="{StaticResource UpdateVersionButton}"
                                Tag="Current" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="YTray 版本与更新">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="VersionButtonText" Text="v0.0.0" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                                <Ellipse x:Name="VersionUpdateDot" Width="6" Height="6" Margin="6,0,0,0"
                                         Fill="{DynamicResource BrandOrangeBrush}" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeButton" Style="{StaticResource YTrayIconButton}" Width="34" Height="32" Margin="0,0,6,0"
                                VerticalAlignment="Center" Click="ThemeButton_Click" ToolTip="外观主题">
                            <Viewbox Width="16" Height="16">
                                <Path x:Name="ThemeButtonIcon" Data="{StaticResource ThemeSystemIcon}" Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Button>
                        <Border Width="1" Height="16" Background="{DynamicResource HairlineBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource WindowControlButton}" Width="46" Height="47" Click="Minimize_Click" ToolTip="最小化">
                            <Path Data="M 0 0 L 10 0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Width="46" Height="47" Click="Maximize_Click" ToolTip="最大化">
                            <Path x:Name="MaximizeIcon" Data="M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.15" Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource WindowCloseButton}" Width="46" Height="47" Click="Close_Click" ToolTip="关闭">
                            <Path Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <Popup x:Name="ThemePopup" Grid.Column="1" PlacementTarget="{Binding ElementName=ThemeButton}"
                           Placement="Bottom" HorizontalOffset="-166" VerticalOffset="6" AllowsTransparency="True"
                           PopupAnimation="Fade" StaysOpen="False" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="206" Padding="6" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.24"/></Border.Effect>
                            <StackPanel>
                                <TextBlock Text="外观主题" Margin="10,6,10,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <Button x:Name="SystemThemeButton" Tag="System" Click="ThemeChoice_Click" Style="{StaticResource ThemeChoiceButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Data="{StaticResource ThemeSystemIcon}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/></Viewbox>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="跟随系统" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="随 Windows 自动切换" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/></StackPanel>
                                        <Path x:Name="SystemThemeCheck" Grid.Column="2" Data="M 1 5 L 4 8 L 10 1" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="LightThemeButton" Tag="Light" Click="ThemeChoice_Click" Style="{StaticResource ThemeChoiceButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Data="{StaticResource ThemeLightIcon}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/></Viewbox>
                                        <TextBlock Grid.Column="1" Text="浅色模式" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <Path x:Name="LightThemeCheck" Grid.Column="2" Data="M 1 5 L 4 8 L 10 1" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="DarkThemeButton" Tag="Dark" Click="ThemeChoice_Click" Style="{StaticResource ThemeChoiceButton}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Left"><Path Data="{StaticResource ThemeDarkIcon}" Fill="Transparent" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/></Viewbox>
                                        <TextBlock Grid.Column="1" Text="深色模式" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <Path x:Name="DarkThemeCheck" Grid.Column="2" Data="M 1 5 L 4 8 L 10 1" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="UpdatePopup" PlacementTarget="{Binding ElementName=VersionButton}"
                           Placement="Bottom" VerticalOffset="6" AllowsTransparency="True"
                           PopupAnimation="Fade" StaysOpen="False" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Width="428" MaxHeight="650" CornerRadius="12" ClipToBounds="True"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.24"/></Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Margin="16,0,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="版本与更新中心" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Border Height="2" CornerRadius="1" Background="{DynamicResource BrandOrangeBrush}" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="自动检测更新" Margin="0,0,9,0" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="UpdateAutoCheck" Click="UpdateAutoCheck_Click"
                                                          Style="{StaticResource YTrayToggleSwitch}" AutomationProperties.Name="自动检测更新"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Margin="14,12,14,0" CornerRadius="9" ClipToBounds="True"
                                        BorderBrush="{DynamicResource UpdateCardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                        <Border Background="{DynamicResource BrandPaleBrush}">
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Image Source="pack://application:,,,/Assets/Icons/ytray-app.ico" Width="27" Height="27" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="UpdatePopupTitle" Text="YTray" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                                        <Border x:Name="UpdatePopupBadge" Margin="7,0,0,0" Padding="6,1" CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" Visibility="Collapsed">
                                                            <TextBlock Text="新版本" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="UpdatePopupStatus" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button x:Name="UpdateActionButton" Grid.Column="2" Content="检查更新" Click="UpdateAction_Click"
                                                        Style="{StaticResource YTrayGhostButton}" Foreground="{DynamicResource BrandOrangeBrush}" FontWeight="SemiBold" Height="30" Padding="10,0"/>
                                            </Grid>
                                        </Border>
                                        <TextBox x:Name="UpdatePopupNotes" Grid.Row="1" MaxHeight="150" MinHeight="70" Margin="12,10"
                                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                 BorderThickness="0" Padding="0" Background="Transparent" FontSize="11.5" TextBlock.LineHeight="19"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Border Grid.Row="2" Margin="12,0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="UpdatePopupLastCheck" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                <Button x:Name="UpdateReleaseNotesButton" Grid.Column="1" Content="完整说明" Click="OpenReleaseNotes_Click" Style="{StaticResource YTrayGhostButton}" Padding="8,0" Height="28"/>
                                                <Button x:Name="UpdateDownloadButton" Grid.Column="2" Content="手动下载" Click="DownloadUpdate_Click" Style="{StaticResource YTrayGhostButton}" Padding="8,0" Height="28"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Margin="14,10,14,14" CornerRadius="9" ClipToBounds="True"
                                        BorderBrush="{DynamicResource UpdateCardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/></Grid.RowDefinitions>
                                        <Border Background="{DynamicResource BrandPaleBrush}">
                                            <Grid Margin="12,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="27" Height="27" CornerRadius="8" Background="{DynamicResource BrandOrangeBrush}">
                                                    <TextBlock Text="Y" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="ExtensionPopupTitle" Text="Yakit Browser Agent" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                                        <Border x:Name="ExtensionPopupBadge" Margin="7,0,0,0" Padding="6,1" CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" Visibility="Collapsed">
                                                            <TextBlock Text="新版本" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="ExtensionPopupVersion" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button x:Name="ExtensionActionButton" Grid.Column="2" Content="检查更新" Click="ExtensionAction_Click"
                                                        Style="{StaticResource YTrayGhostButton}" Foreground="{DynamicResource BrandOrangeBrush}" FontWeight="SemiBold" Height="30" Padding="10,0"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="ExtensionPopupNotes" Grid.Row="1" MinHeight="60" Margin="12,10" FontSize="11.5" LineHeight="19"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <Border Grid.Row="2" Margin="12,0" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ExtensionPopupStatus" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar x:Name="ExtensionPopupProgress" Grid.Column="1" Width="100" Height="5" Visibility="Collapsed" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Main Workspace: Grouped Sidebar + Content Frame -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                    <ListBox x:Name="NavList" Margin="0,4,0,10" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource NavListBoxItem}" SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Style="{StaticResource NavGroupHeaderItem}">
                            <TextBlock Text="工作台" Style="{StaticResource NavGroupHeaderText}"/>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavQuick" Tag="overview" IsSelected="True" Selected="Nav_Selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 1 8.5 L 8 1.5 L 15 8.5 M 3.2 7 L 3.2 14.5 L 7 14.5 L 7 10 L 9 10 L 9 14.5 L 12.8 14.5 L 12.8 7" Style="{StaticResource NavIconPath}"/>
                                <TextBlock Text="概览" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavInstances" Tag="instances" Selected="Nav_Selected">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 2 2.5 L 14 2.5 L 14 13.5 L 2 13.5 Z M 2 6 L 14 6 M 5.2 4.2 L 5.3 4.2" Style="{StaticResource NavIconPath}"/>
                                    <TextBlock Text="实例" Style="{StaticResource NavText}"/>
                                </StackPanel>
                                <Border x:Name="NavInstancesBadge" Grid.Column="1" Visibility="Collapsed"
                                        CornerRadius="9" Padding="7,1" VerticalAlignment="Center"
                                        Background="{DynamicResource SuccessPaleBrush}">
                                    <TextBlock x:Name="NavInstancesBadgeText" Text="0" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavGroupHeaderItem}">
                            <TextBlock Text="浏览器环境" Style="{StaticResource NavGroupHeaderText}"/>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavEnvironment" Tag="environments" Selected="Nav_Selected">
                            <StackPanel Orientation="Horizontal"><Path Data="M 2.5 4 L 13.5 4 M 6 2 L 6 6 M 2.5 8 L 13.5 8 M 10 6 L 10 10 M 2.5 12 L 13.5 12 M 7 10 L 7 14" Style="{StaticResource NavIconPath}"/><TextBlock Text="环境模板" Style="{StaticResource NavText}"/></StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavRuntimes" Tag="runtimes" Selected="Nav_Selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8 1 A 7 7 0 1 1 7.99 1 M 1 8 L 15 8 M 8 1 C 4.5 4.5 4.5 11.5 8 15 M 8 1 C 11.5 4.5 11.5 11.5 8 15" Style="{StaticResource NavIconPath}"/>
                                <TextBlock Text="浏览器" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavLaunch" Tag="launch" Selected="Nav_Selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2 5 C 3.6 2.4 6.8 1.5 9.5 2.8 M 9 0.8 L 10 3 L 7.6 3.5 M 14 11 C 12.4 13.6 9.2 14.5 6.5 13.2 M 7 15.2 L 6 13 L 8.4 12.5 M 2 11 C 0.9 9.1 0.9 6.9 2 5 M 14 5 C 15.1 6.9 15.1 9.1 14 11" Style="{StaticResource NavIconPath}"/>
                                <TextBlock Text="网络与代理" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavPlugins" Tag="plugins" Selected="Nav_Selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2 2 L 8 2 L 8 8 L 2 8 Z M 8 2 L 14 2 L 14 8 L 8 8 M 2 8 L 8 8 L 8 14 L 2 14" Style="{StaticResource NavIconPath}"/>
                                <TextBlock Text="插件" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Style="{StaticResource NavGroupHeaderItem}">
                            <TextBlock Text="智能与系统" Style="{StaticResource NavGroupHeaderText}"/>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavMcp" Tag="mcp" Selected="Nav_Selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 3 2.5 L 13 2.5 L 13 6.5 L 3 6.5 Z M 3 9.5 L 13 9.5 L 13 13.5 L 3 13.5 Z M 5 4.5 L 5.1 4.5 M 5 11.5 L 5.1 11.5" Style="{StaticResource NavIconPath}"/>
                                <TextBlock Text="MCP" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavSystem" Tag="system" Selected="Nav_Selected">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 1 2 L 15 2 L 15 11 L 1 11 Z M 8 11 L 8 15 M 4 15 L 12 15" Style="{StaticResource NavIconPath}"/>
                                    <TextBlock Text="电脑控制" Style="{StaticResource NavText}"/>
                                </StackPanel>
                                <Ellipse x:Name="NavSystemDot" Grid.Column="1" Width="7" Height="7"
                                         Fill="{DynamicResource SuccessBrush}" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </Grid>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavStartup" Tag="startup" Selected="Nav_Selected" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8 1 L 8 8 M 3.1 3.4 A 6.2 6.2 0 1 0 12.9 3.4" Style="{StaticResource NavIconPath}"/>
                                <TextBlock Text="开机启动" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavSettings" Tag="settings" Selected="Nav_Selected">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 8 5 A 3 3 0 1 1 7.99 5 M 6.5 1 L 9.5 1 L 10 3 L 11.7 4 L 13.6 3.4 L 15 6 L 13.5 7.3 L 13.5 8.7 L 15 10 L 13.6 12.6 L 11.7 12 L 10 13 L 9.5 15 L 6.5 15 L 6 13 L 4.3 12 L 2.4 12.6 L 1 10 L 2.5 8.7 L 2.5 7.3 L 1 6 L 2.4 3.4 L 4.3 4 L 6 3 Z" Style="{StaticResource NavIconPath}"/>
                                <TextBlock Text="设置" Style="{StaticResource NavText}"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"
                       Background="{DynamicResource AppBackgroundBrush}" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}">
                    <Frame.Template>
                        <ControlTemplate TargetType="{x:Type Frame}">
                            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <AdornerDecorator><ContentPresenter x:Name="PART_FrameCP" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></AdornerDecorator>
                            </Border>
                        </ControlTemplate>
                    </Frame.Template>
                </Frame>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0,14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="10" Padding="8,2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RunningDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusEnvironment" Text="运行环境正常" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StatusRuntime" Text="暂无浏览器" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Border Width="1" Height="13" Background="{DynamicResource HairlineBrush}" Margin="13,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusBrowserCount" Text="可用浏览器: 0" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <Border Width="1" Height="13" Background="{DynamicResource HairlineBrush}" Margin="13,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusPluginCount" Text="插件: 0 个" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource CodeBadgeBorder}" Margin="0,0,10,0">
                            <TextBlock x:Name="StatusProxy" Text="HTTP 代理 127.0.0.1:8083" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="StatusDebug" Text="调试基址 127.0.0.1" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Width="1" Height="13" Background="{DynamicResource HairlineBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button x:Name="StatusLogsButton" Style="{StaticResource YTrayIconButton}" Width="28" Height="28"
                                Click="StatusLogs_Click" ToolTip="打开诊断日志" Margin="0,0,3,0"
                                AutomationProperties.Name="打开诊断日志" VerticalAlignment="Center">
                            <Path Data="{StaticResource LogsIconGeometry}"
                                  Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource YTrayIconButton}" Width="28" Height="28" Click="StatusSettings_Click" ToolTip="打开设置" VerticalAlignment="Center">
                            <Path Data="M 8 5 A 3 3 0 1 1 7.99 5 M 6.5 1 L 9.5 1 L 10 3 L 11.7 4 L 13.6 3.4 L 15 6 L 13.5 7.3 L 13.5 8.7 L 15 10 L 13.6 12.6 L 11.7 12 L 10 13 L 9.5 15 L 6.5 15 L 6 13 L 4.3 12 L 2.4 12.6 L 1 10 L 2.5 8.7 L 2.5 7.3 L 1 6 L 2.4 3.4 L 4.3 4 L 6 3 Z"
                                  Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
