<Window x:Class="YTray.Views.WidgetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="YTray" Width="414" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- The widget owns a small dark material system instead of inheriting
             HandyControl/native WPF templates intended for full-size windows. -->
        <LinearGradientBrush x:Key="WidgetSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{DynamicResource FloatingTopColor}" Offset="0"/>
            <GradientStop Color="{DynamicResource FloatingBottomColor}" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="WidgetRaisedBrush" Color="{DynamicResource FloatingRaisedColor}"/>
        <SolidColorBrush x:Key="WidgetDeepBrush" Color="{DynamicResource FloatingDeepColor}"/>
        <SolidColorBrush x:Key="WidgetInputBrush" Color="{DynamicResource FloatingInputColor}"/>
        <SolidColorBrush x:Key="WidgetHoverBrush" Color="{DynamicResource FloatingHoverColor}"/>
        <SolidColorBrush x:Key="WidgetBorderBrush" Color="{DynamicResource FloatingBorderColor}"/>
        <SolidColorBrush x:Key="WidgetHairlineBrush" Color="{DynamicResource FloatingHairlineColor}"/>
        <SolidColorBrush x:Key="WidgetTextPrimaryBrush" Color="{DynamicResource FloatingTextPrimaryColor}"/>
        <SolidColorBrush x:Key="WidgetTextSecondaryBrush" Color="{DynamicResource FloatingTextSecondaryColor}"/>
        <SolidColorBrush x:Key="WidgetTextTertiaryBrush" Color="{DynamicResource FloatingTextTertiaryColor}"/>
        <SolidColorBrush x:Key="WidgetOrangePaleBrush" Color="{DynamicResource FloatingOrangePaleColor}"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="Foreground" Value="{StaticResource WidgetTextPrimaryBrush}"/>
        </Style>

        <Style x:Key="WidgetSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource WidgetTextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WidgetCountBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{StaticResource WidgetRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WidgetHairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,1"/>
        </Style>

        <Style x:Key="WidgetButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="{StaticResource WidgetRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WidgetBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource WidgetTextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.68"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource WidgetHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource WidgetBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetPrimaryButton" TargetType="Button" BasedOn="{StaticResource WidgetButton}">
            <Setter Property="Background" Value="{StaticResource BrandOrangeBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrandOrangeHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrandOrangeHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetGhostButton" TargetType="Button" BasedOn="{StaticResource WidgetButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="WidgetIconButton" TargetType="Button" BasedOn="{StaticResource WidgetGhostButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="WidgetDangerIconButton" TargetType="Button" BasedOn="{StaticResource WidgetIconButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style x:Key="WidgetTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="{StaticResource WidgetInputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource WidgetBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource WidgetTextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrandOrangeBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource BrandOrangeBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputChrome" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputChrome" Property="BorderBrush" Value="{StaticResource BrandOrangeBrush}"/>
                                <Setter TargetName="InputChrome" Property="Background" Value="{StaticResource WidgetHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputChrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetEmbeddedTextBox" TargetType="TextBox" BasedOn="{StaticResource WidgetTextBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,0"/>
        </Style>

        <Style x:Key="WidgetComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource WidgetTextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{Binding}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource WidgetHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource WidgetOrangePaleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource WidgetTextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource WidgetTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource WidgetComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          Background="Transparent" BorderThickness="0"
                                          Foreground="{StaticResource WidgetTextPrimaryBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleChrome" CornerRadius="6" Background="{TemplateBinding Background}">
                                            <Grid Margin="10,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Foreground="{StaticResource WidgetTextPrimaryBrush}"
                                                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Path Grid.Column="1" Data="M 1 2 L 5 6 L 9 2" Stroke="{StaticResource WidgetTextSecondaryBrush}"
                                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource WidgetHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource WidgetHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Margin="0,5,0,0" Padding="5" MinWidth="92" CornerRadius="9"
                                        Background="{StaticResource WidgetRaisedBrush}" BorderBrush="{StaticResource WidgetBorderBrush}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#99000000" BlurRadius="16" ShadowDepth="3"/>
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Margin="10" CornerRadius="18"
            Background="{StaticResource WidgetSurfaceBrush}"
            BorderBrush="{StaticResource WidgetBorderBrush}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="EntranceTransform"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="#B0000000" BlurRadius="28" ShadowDepth="5" Opacity="0.72"/>
        </Border.Effect>

        <Grid>
            <Border Height="2" VerticalAlignment="Top" Margin="18,0" CornerRadius="0,0,2,2"
                    Background="{StaticResource BrandOrangeBrush}" Opacity="0.82"/>
            <StackPanel Margin="16,15,16,16">
                <!-- Product identity and current runtime. -->
                <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource WidgetOrangePaleBrush}"
                            BorderBrush="#66F2823D" BorderThickness="1" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource BrandOrangeBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="1,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="浏览器实例" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DefaultRuntimeLabel" FontSize="10" Foreground="{StaticResource WidgetTextSecondaryBrush}"
                                   Text="正在读取默认浏览器…" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WidgetIconButton}" Click="OpenManager_Click"
                                ToolTip="打开全部管理" Margin="0,0,2,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource WidgetTextSecondaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource WidgetIconButton}" Click="Close_Click" ToolTip="关闭">
                            <TextBlock Text="×" FontFamily="Segoe UI" FontSize="16"
                                       Foreground="{StaticResource WidgetTextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Proxy is the primary work surface, not a generic form card. -->
                <Border Background="{StaticResource WidgetDeepBrush}" CornerRadius="13" Padding="12" Margin="0,0,0,12"
                        BorderBrush="#5CF2823D" BorderThickness="1">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="预设代理" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="7" Background="{StaticResource WidgetRaisedBrush}">
                                    <TextBlock Text="本地调试" FontSize="9" Foreground="{StaticResource WidgetTextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ProxyStatus" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       FontSize="9.5" Foreground="{StaticResource WidgetTextSecondaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                        </DockPanel>

                        <TextBlock Text="代理地址" FontSize="9.5" Foreground="{StaticResource WidgetTextTertiaryBrush}" Margin="1,0,0,4"/>
                        <Border Height="36" CornerRadius="8" Background="{StaticResource WidgetInputBrush}"
                                BorderBrush="{StaticResource WidgetBorderBrush}" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SchemeCombo" Grid.Column="0" Style="{StaticResource WidgetComboBox}">
                                    <sys:String>HTTP</sys:String>
                                    <sys:String>HTTPS</sys:String>
                                </ComboBox>
                                <Border Grid.Column="1" Width="1" Margin="0,7" Background="{StaticResource WidgetHairlineBrush}"/>
                                <TextBox x:Name="HostBox" Grid.Column="2" Style="{StaticResource WidgetEmbeddedTextBox}"/>
                                <Border Grid.Column="3" Width="1" Margin="0,7" Background="{StaticResource WidgetHairlineBrush}"/>
                                <TextBox x:Name="PortBox" Grid.Column="4" Style="{StaticResource WidgetEmbeddedTextBox}" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="备注" FontSize="9.5" Foreground="{StaticResource WidgetTextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="RemarkBox" Grid.Column="1" Style="{StaticResource WidgetTextBox}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CheckBtn" Width="72" Margin="0,0,7,0" Click="Check_Click"
                                    Style="{StaticResource WidgetButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="检测" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SaveBtn" Width="72" Click="Save_Click" Style="{StaticResource WidgetPrimaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="保存" VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Running instances. -->
                        <DockPanel Margin="1,0,1,7">
                            <Border DockPanel.Dock="Right" Style="{StaticResource WidgetCountBadge}">
                                <TextBlock x:Name="RunningCountLabel" Text="0" FontSize="9.5" Foreground="{StaticResource WidgetTextSecondaryBrush}"/>
                            </Border>
                            <TextBlock x:Name="InstanceActionStatus" DockPanel.Dock="Right" Margin="0,0,8,0" MaxWidth="205"
                                       FontSize="9" Foreground="{StaticResource WidgetTextSecondaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="运行中" Style="{StaticResource WidgetSectionTitle}"/>
                            </StackPanel>
                        </DockPanel>

                        <Border x:Name="RunningEmpty" Background="{StaticResource WidgetRaisedBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource WidgetHairlineBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="39"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource WidgetOrangePaleBrush}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource BrandOrangeBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="暂无运行中实例" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="启动后可在这里聚焦、截图或停止" FontSize="9.5" Foreground="{StaticResource WidgetTextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Height="28" Padding="10,0"
                                        Style="{StaticResource WidgetGhostButton}" Click="OpenManager_Click">
                                    <TextBlock Text="配置" Foreground="{StaticResource WidgetTextSecondaryBrush}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="RunningList" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource WidgetRaisedBrush}" CornerRadius="10" Padding="9" Margin="0,0,0,6"
                                            BorderBrush="{StaticResource WidgetHairlineBrush}" BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Width="66" Height="44" CornerRadius="7" Background="{StaticResource WidgetOrangePaleBrush}" Margin="0,0,9,0"
                                                    ClipToBounds="True" MouseEnter="Thumbnail_MouseEnter" MouseLeave="Thumbnail_MouseLeave"
                                                    Tag="{Binding}">
                                                <Grid>
                                                    <Image Source="{Binding ThumbnailSource, Mode=OneWay}" Stretch="UniformToFill"/>
                                                    <Border Background="{StaticResource WidgetDeepBrush}" ToolTip="{Binding PreviewMessage, Mode=OneWay}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasThumbnail, Mode=OneWay}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Viewbox Width="18" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path Data="M 1.5 2.5 L 14.5 2.5 L 14.5 12.5 L 1.5 12.5 Z M 3.5 10 L 6.2 7.3 L 8.2 9.1 L 10.1 6.9 L 13 10"
                                                                  Stroke="{StaticResource WidgetTextTertiaryBrush}" StrokeThickness="1.25"
                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Viewbox>
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                                                            MinWidth="17" Height="17" Padding="3,0" CornerRadius="6"
                                                            Background="{DynamicResource BrandOrangeBrush}">
                                                        <TextBlock Text="{Binding DockBadge, Mode=OneWay}" Foreground="White" FontSize="8.5" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Button ToolTip="聚焦窗口" Click="Focus_Click" Tag="{Binding Instance}" Style="{StaticResource WidgetIconButton}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Data="M 1 8 C 4.2 3.7 11.8 3.7 15 8 C 11.8 12.3 4.2 12.3 1 8 Z M 8 5.6 A 2.4 2.4 0 1 0 8 10.4 A 2.4 2.4 0 1 0 8 5.6"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"/>
                                                    </Viewbox>
                                                </Button>
                                                <Button ToolTip="{Binding CaptureToolTip, Mode=OneWay}" IsEnabled="{Binding CanCapture, Mode=OneWay}"
                                                        Click="Capture_Click" Tag="{Binding Instance}" Style="{StaticResource WidgetIconButton}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Path Data="M 1.5 5 L 4.4 5 L 5.6 3.2 L 10.4 3.2 L 11.6 5 L 14.5 5 L 14.5 13 L 1.5 13 Z M 8 6.4 A 2.2 2.2 0 1 0 8 10.8 A 2.2 2.2 0 1 0 8 6.4"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.25" StrokeLineJoin="Round" Fill="Transparent"/>
                                                    </Viewbox>
                                                </Button>
                                                <Button ToolTip="{Binding StopToolTip, Mode=OneWay}" IsEnabled="{Binding CanStop, Mode=OneWay}"
                                                        Click="Stop_Click" Tag="{Binding Instance}" Style="{StaticResource WidgetDangerIconButton}">
                                                    <Viewbox Width="16" Height="16">
                                                        <Grid Width="16" Height="16">
                                                            <Ellipse Margin="1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.25"/>
                                                            <Rectangle Width="5.2" Height="5.2" RadiusX="0.8" RadiusY="0.8"
                                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        </Grid>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastPageTitle, Mode=OneWay, TargetNullValue=正在读取页面标题}" FontSize="9.5"
                                                           Foreground="{StaticResource WidgetTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastPageURL, Mode=OneWay, TargetNullValue=正在连接页面}" FontSize="8.5"
                                                           Foreground="{StaticResource WidgetTextTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="8.5" Foreground="{StaticResource WidgetTextTertiaryBrush}">
                                                    <Run Text="PID "/><Run Text="{Binding ProcessID, Mode=OneWay}"/><Run Text=" · Debug :"/><Run Text="{Binding DebugPort, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- History. -->
                        <DockPanel Margin="1,0,1,7">
                            <Border DockPanel.Dock="Right" Style="{StaticResource WidgetCountBadge}">
                                <TextBlock x:Name="HistoryCountLabel" Text="0" FontSize="9.5" Foreground="{StaticResource WidgetTextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="历史" Style="{StaticResource WidgetSectionTitle}"/>
                        </DockPanel>

                        <Border x:Name="HistoryEmpty" Height="40" Background="{StaticResource WidgetDeepBrush}" CornerRadius="9"
                                BorderBrush="{StaticResource WidgetHairlineBrush}" BorderThickness="1" Margin="0,0,0,11">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource WidgetTextTertiaryBrush}" Margin="0,0,7,0"/>
                                <TextBlock Text="启动过的实例会保留在这里" FontSize="10" Foreground="{StaticResource WidgetTextTertiaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="HistoryList" Margin="0,0,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource WidgetRaisedBrush}" CornerRadius="10" Padding="9" Margin="0,0,0,6"
                                            BorderBrush="{StaticResource WidgetHairlineBrush}" BorderThickness="1">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Button Height="28" Padding="10,0" Margin="0,0,3,0"
                                                        Click="Restore_Click" Tag="{Binding}" Style="{StaticResource WidgetPrimaryButton}">
                                                    <TextBlock Text="打开" Foreground="White"/>
                                                </Button>
                                                <Button ToolTip="删除" Click="DeleteHistory_Click" Tag="{Binding}"
                                                        Style="{StaticResource WidgetDangerIconButton}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DangerBrush}"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LastPageTitle, Mode=OneWay, TargetNullValue=未记录页面标题}" FontWeight="SemiBold" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="9.5" Foreground="{StaticResource WidgetTextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Margin="0,1,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="1.32*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DirectBtn" Grid.Column="0" Click="DirectLaunch_Click" Style="{StaticResource WidgetButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="无代理启动" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProxyBtn" Grid.Column="2" Click="ProxyLaunch_Click" Style="{StaticResource WidgetPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="使用 HTTP 代理启动" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
