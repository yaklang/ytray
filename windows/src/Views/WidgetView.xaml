<Window x:Class="YTray.Views.WidgetView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="YTray" Width="390" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Border Background="White" CornerRadius="18" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="20" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel Margin="14">
            <!-- Header -->
            <DockPanel Margin="0,0,0,9">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="浏览器实例" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="DefaultRuntimeLabel" FontSize="10" Foreground="#888" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="CloseBtn" Content="✕" Width="24" Height="24" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Click="Close_Click" Background="Transparent" BorderThickness="0" FontSize="11"/>
            </DockPanel>

            <!-- Preset Proxy -->
            <Border Background="#FAFAFA" CornerRadius="11" Padding="10" Margin="0,0,0,9" BorderBrush="#F0F0F0" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,7">
                        <TextBlock Text="预设代理" FontSize="12" FontWeight="Bold" DockPanel.Dock="Left"/>
                        <TextBlock Text="用于高频本地网络调试" FontSize="9" Foreground="#AAA" Margin="6,0,0,0"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <ComboBox x:Name="SchemeCombo" Width="70" Margin="0,0,6,0"/>
                        <hc:TextBox x:Name="HostBox" hc:InfoElement.Placeholder="Host，例如 127.0.0.1" MinWidth="120" Margin="0,0,6,0"/>
                        <hc:TextBox x:Name="PortBox" Width="60" hc:InfoElement.Placeholder="端口"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="备注" FontSize="10" Width="42"/>
                        <hc:TextBox x:Name="RemarkBox" MinWidth="200" hc:InfoElement.Placeholder="可选，例如 Yak MITM"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckBtn" Content="检测" Padding="8,4" Margin="0,0,7,0" Click="Check_Click" Style="{StaticResource ButtonDefault}"/>
                        <Button x:Name="SaveBtn" Content="保存" Padding="8,4" Click="Save_Click"
                                Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
                        <TextBlock x:Name="ProxyStatus" FontSize="9" Foreground="#888" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Running -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="▼" FontSize="8" FontWeight="Bold"/>
                <TextBlock Text="运行中" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                <TextBlock x:Name="RunningCountLabel" FontSize="10" Foreground="#888" Margin="5,0,0,0"/>
            </DockPanel>
            <ItemsControl x:Name="RunningList" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FAFAFA" CornerRadius="9" Padding="9" Margin="0,0,0,3" Height="68" BorderBrush="#F0F0F0" BorderThickness="1">
                            <DockPanel>
                                <Border Width="76" Height="48" CornerRadius="7" Background="#FFF6EE" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                        <hc:Badge Text="运行中" Status="Success" Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastPageTitle}" FontSize="10" Foreground="#888" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="9" Foreground="#BBB">
                                        <Run Text="PID "/><Run Text="{Binding ProcessID}"/>
                                        <Run Text=" · 调试 :"/><Run Text="{Binding DebugPort}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="⤢" Width="24" Height="24" Margin="0,0,3,0" Click="Focus_Click" Tag="{Binding}" Style="{StaticResource ButtonDefault}" Background="Transparent" BorderThickness="0"/>
                                    <Button Content="📷" Width="24" Height="24" Margin="0,0,3,0" Click="Capture_Click" Tag="{Binding}" Style="{StaticResource ButtonDefault}" Background="Transparent" BorderThickness="0"/>
                                    <Button Content="⏹" Width="24" Height="24" Click="Stop_Click" Tag="{Binding}" Foreground="#E74C3C" Background="Transparent" BorderThickness="0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- History -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="▼" FontSize="8" FontWeight="Bold"/>
                <TextBlock Text="历史" FontSize="12" FontWeight="Bold" Margin="5,0,0,0"/>
                <TextBlock x:Name="HistoryCountLabel" FontSize="10" Foreground="#888" Margin="5,0,0,0"/>
            </DockPanel>
            <ItemsControl x:Name="HistoryList" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FAFAFA" CornerRadius="9" Padding="9" Margin="0,0,0,3" Height="54" BorderBrush="#F0F0F0" BorderThickness="1">
                            <DockPanel>
                                <Border Width="58" Height="36" CornerRadius="7" Background="#FFF6EE" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LastPageTitle, TargetNullValue=未记录页面标题}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10" Foreground="#888" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name}"/><Run Text=" · "/><Run Text="{Binding RuntimeName}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="▶ 打开" Padding="8,4" Margin="0,0,3,0" Click="Restore_Click" Tag="{Binding}"
                                            Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
                                    <Button Content="🗑" Width="24" Height="24" Click="DeleteHistory_Click" Tag="{Binding}" Foreground="#E74C3C" Background="Transparent" BorderThickness="0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Launch buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button x:Name="DirectBtn" Content="无代理启动" Padding="9,4" Margin="0,0,6,0" Click="DirectLaunch_Click" Style="{StaticResource ButtonDefault}"/>
                <Button x:Name="ProxyBtn" Content="使用HTTP代理启动" Padding="9,4" Click="ProxyLaunch_Click"
                        Background="#F28B44" Foreground="White" BorderBrush="#F28B44"/>
            </StackPanel>
            <Button Content="⚙ 全部管理" Click="OpenManager_Click" Height="32" HorizontalContentAlignment="Left" Padding="11,0" Style="{StaticResource ButtonDefault}"/>
        </StackPanel>
    </Border>
</Window>