<Window x:Class="YTray.Views.ThumbnailPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="页面预览" Width="320" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" IsHitTestVisible="False"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="8" CornerRadius="11" Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.28"/>
        </Border.Effect>
        <Grid Margin="7">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
            <Border CornerRadius="7" Background="#17181A" ClipToBounds="True">
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock x:Name="PreviewTitle" Grid.Row="1" VerticalAlignment="Center" Margin="3,2,3,0"
                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
