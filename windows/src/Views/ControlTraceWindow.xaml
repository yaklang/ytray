<Window x:Class="YTray.Views.ControlTraceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTray · 电脑控制 Trace 回放" Width="1120" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="TracePanel" TargetType="Border" BasedOn="{StaticResource SurfaceBorder}">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
        <Style x:Key="TraceNavButton" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="TraceTabButton" TargetType="Button" BasedOn="{StaticResource YTrayGhostButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="TraceTimeSegment" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TimeBar" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TimeBar" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TraceExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{x:Null}" HorizontalAlignment="Stretch" Cursor="Hand"
                                          Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bar" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                <Path x:Name="Chevron" Grid.Column="1" Data="M 1 2 L 5 6 L 9 2" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Details" Visibility="Collapsed" ContentSource="Content"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TraceFieldRow">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TraceStageRow">
            <Border Padding="8,6" Margin="0,0,0,4" CornerRadius="6" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <Ellipse x:Name="StageDot" DockPanel.Dock="Left" Width="7" Height="7" Margin="2,0,9,0"
                                 Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StageName" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"/>
                    </DockPanel>
                    <Grid Grid.Column="1" Height="7" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Before}"/><ColumnDefinition Width="{Binding Span}"/><ColumnDefinition Width="{Binding After}"/></Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="3" CornerRadius="3.5" Background="{DynamicResource SurfaceMutedBrush}"/>
                        <Border x:Name="StageBar" Grid.Column="1" CornerRadius="3.5" Background="{DynamicResource SuccessBrush}" MinWidth="4"/>
                    </Grid>
                    <TextBlock x:Name="StageTime" Grid.Column="2" Text="{Binding Time}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Unavailable}" Value="True">
                    <Setter TargetName="StageDot" Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                    <Setter TargetName="StageBar" Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter TargetName="StageDot" Property="Fill" Value="{DynamicResource BrandOrangeBrush}"/>
                    <Setter TargetName="StageBar" Property="Background" Value="{DynamicResource BrandOrangeBrush}"/>
                    <Setter TargetName="StageTime" Property="Text" Value="进行中"/>
                    <Setter TargetName="StageTime" Property="Foreground" Value="{DynamicResource BrandOrangeBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="StageDot" Property="Fill" Value="{DynamicResource DangerBrush}"/>
                    <Setter TargetName="StageBar" Property="Background" Value="{DynamicResource DangerBrush}"/>
                    <Setter TargetName="StageName" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter TargetName="StageTime" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TraceRunItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="1" CornerRadius="9" Padding="11,9" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TraceRunRow">
            <Grid ToolTip="{Binding Name}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="RunBadge" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="8"
                        Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <Path x:Name="RunGlyph" Data="M 1.5 8 L 4 8 L 5.8 3.5 L 8.5 12.5 L 10.3 8 L 12.8 8"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.35" Fill="Transparent"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="7" Height="7" VerticalAlignment="Center" Margin="2,0,0,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Completed}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Failed}" Value="True"><Setter Property="Fill" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Running}" Value="True"><Setter Property="Fill" Value="{DynamicResource BrandOrangeBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="RunGlyph" Property="Stroke" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Running}" Value="True">
                    <Setter TargetName="RunGlyph" Property="Stroke" Value="{DynamicResource BrandOrangeBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TimelineItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,18,22,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Studio Header -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Path Data="M 1.5 8 L 4.5 8 L 6.5 3 L 9.5 13 L 11.5 8 L 14.5 8"
                      Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.65" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="电脑控制 Trace 回放" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="跨会话聚合 Agent 任务步骤、校验子阶段耗时瀑布图与原始 MCP 请求/响应载荷"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Main Split View -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Left Column: Task & Session Runs -->
            <Border Style="{StaticResource TracePanel}" Padding="12,13">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,2,11">
                        <Border DockPanel.Dock="Right" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}">
                            <TextBlock x:Name="RunCountText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock Text="任务与会话列表" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="RunEmptyHint" Text="暂无历史任务记录" Visibility="Collapsed"
                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ListBox x:Name="RunList" SelectionChanged="Run_Selected" ItemTemplate="{StaticResource TraceRunRow}"
                                 ItemContainerStyle="{StaticResource TraceRunItem}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Column: Step Pipeline, Call Summary & Payload Inspector -->
            <Border Grid.Column="2" Style="{StaticResource TracePanel}" Padding="16,15">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="340">
                        <Border Width="52" Height="52" CornerRadius="13" Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <Viewbox Width="24" Height="24">
                                <Path Data="M 1.5 8 L 4.5 8 L 6.5 3 L 9.5 13 L 11.5 8 L 14.5 8"
                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.45" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Viewbox>
                        </Border>
                        <TextBlock x:Name="EmptyText" Text="等待 MCP 调用" Margin="0,14,0,0" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="当 AI 客户端通过电脑控制 MCP 执行观察窗口、点击或输入时，完整调用流水线与耗时将实时呈现在此处"
                                   Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid x:Name="CallDetails" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <!-- 1. Pipeline Step Strip / Gantt Timing Track -->
                        <Border Style="{StaticResource SubtleCardBorder}" Padding="12,9,12,11" Margin="0,0,0,12" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel Margin="1,0,0,8">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Border CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="2" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="StepModeButton" Content="步骤链路" Style="{StaticResource TraceTabButton}" Click="StepMode_Click" Height="24" Padding="10,0" FontSize="11.5"/>
                                                <Button x:Name="TimeModeButton" Content="时间甘特" Style="{StaticResource TraceTabButton}" Click="TimeMode_Click" Height="24" Padding="10,0" FontSize="11.5"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel x:Name="StepNavigation" Orientation="Horizontal">
                                            <Button x:Name="EarlierStepsButton" Style="{StaticResource TraceNavButton}" Click="EarlierSteps_Click"
                                                    ToolTip="查看较早步骤" AutomationProperties.Name="查看较早步骤" IsEnabled="False" Margin="0,0,5,0">
                                                <Path Data="M 7,0 L 2,5 L 7,10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Button>
                                            <Button x:Name="LaterStepsButton" Style="{StaticResource TraceNavButton}" Click="LaterSteps_Click"
                                                    ToolTip="查看较新步骤" AutomationProperties.Name="查看较新步骤" IsEnabled="False">
                                                <Path Data="M 2,0 L 7,5 L 2,10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="任务执行流水线" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <ListBox x:Name="CallList" Grid.Row="1" SelectionChanged="Call_Selected" PreviewMouseWheel="Timeline_MouseWheel"
                                         ScrollViewer.ScrollChanged="Timeline_ScrollChanged" AutomationProperties.Name="任务流水线" BorderThickness="0"
                                         Background="Transparent" ItemContainerStyle="{StaticResource TimelineItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="StepCard" MinWidth="112" MaxWidth="212" CornerRadius="8" Padding="9,6"
                                                        Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                                        SnapsToDevicePixels="True" ToolTip="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Border x:Name="StepNumber" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="6" MinWidth="22"
                                                                Height="22" Padding="5,0" Margin="0,0,7,0">
                                                            <TextBlock x:Name="StepIndex" Text="{Binding Position}" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock x:Name="StepLabel" Text="{Binding Label}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="152"/>
                                                    </StackPanel>
                                                </Border>
                                                <Path x:Name="Connector" Data="M 0,4 H 11 M 11,4 L 7.5,1 M 11,4 L 7.5,7"
                                                      Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Margin="7,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasNext}" Value="False"><Setter TargetName="Connector" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Completed}" Value="True">
                                                    <Setter TargetName="StepNumber" Property="Background" Value="{DynamicResource SuccessPaleBrush}"/>
                                                    <Setter TargetName="StepIndex" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                                    <Setter TargetName="StepNumber" Property="Background" Value="{DynamicResource DangerPaleBrush}"/>
                                                    <Setter TargetName="StepIndex" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Running}" Value="True">
                                                    <Setter TargetName="StepNumber" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                                    <Setter TargetName="StepIndex" Property="Foreground" Value="{DynamicResource BrandOrangeBrush}"/>
                                                </DataTrigger>
                                                <Trigger SourceName="StepCard" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="StepCard" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="StepCard" Property="Background" Value="{DynamicResource BrandPaleBrush}"/>
                                                    <Setter TargetName="StepCard" Property="BorderBrush" Value="{DynamicResource BrandOrangeBrush}"/>
                                                    <Setter TargetName="StepLabel" Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel x:Name="TimePanel" Grid.Row="1" Visibility="Collapsed">
                                    <Border CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="4,5">
                                        <Canvas x:Name="TimeTrack" Height="17" SizeChanged="TimeTrack_SizeChanged" ClipToBounds="True"
                                                AutomationProperties.Name="调用时长概览"/>
                                    </Border>
                                    <DockPanel Margin="2,5,2,0">
                                        <TextBlock x:Name="TimeSpanText" DockPanel.Dock="Right" FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="任务起点 (+0 ms)" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. Selected Call Summary Card -->
                        <Border Grid.Row="1" Style="{StaticResource SubtleCardBorder}" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Border Style="{StaticResource CodeBadgeBorder}" Background="{DynamicResource SurfaceRaisedBrush}" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="CallDurationText" FontSize="11.5" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border x:Name="CallStatusBadge" Background="{DynamicResource SurfaceMutedBrush}" Padding="10,4" CornerRadius="10" VerticalAlignment="Center">
                                            <TextBlock x:Name="CallStatusText" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
                                            <Border Style="{StaticResource PillBadge}" Background="{DynamicResource BrandPaleBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="CallPositionText" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource CodeBadgeBorder}" Background="{DynamicResource SurfaceRaisedBrush}" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="ToolNameText" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                            <TextBlock x:Name="CallMetadataText" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="ActionTitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border x:Name="CallErrorPanel" Background="{DynamicResource DangerPaleBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="7" Padding="11,7" Margin="0,6,0,0">
                                    <TextBlock x:Name="CallErrorText" MaxHeight="62" FontSize="12" FontWeight="Medium" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 3. Tabbed Inspector: Readable Summary / Raw Request / Raw Response -->
                        <Border Grid.Row="2" CornerRadius="10" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                Background="{DynamicResource SurfaceRaisedBrush}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                                        Background="{DynamicResource SurfaceRaisedBrush}" Padding="12,8">
                                    <DockPanel>
                                        <Button x:Name="CopyPayloadButton" DockPanel.Dock="Right" Content="复制 JSON" Click="CopyPayload_Click"
                                                Visibility="Collapsed" Style="{StaticResource YTrayGhostButton}" Height="26" MinHeight="0" Padding="10,0"
                                                FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                        <Border HorizontalAlignment="Left" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="DetailsButton" Content="结构化详情" Click="Details_Click" Style="{StaticResource TraceTabButton}" Margin="0,0,2,0"/>
                                                <Button x:Name="RequestButton" Content="原始请求 JSON" Click="Request_Click" Style="{StaticResource TraceTabButton}" Margin="0,0,2,0"/>
                                                <Button x:Name="ResponseButton" Content="原始响应 JSON" Click="Response_Click" Style="{StaticResource TraceTabButton}"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer x:Name="ReadableDetails" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="14,12,14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource SubtleCardBorder}" Padding="13,11,13,5">
                                                <StackPanel>
                                                    <TextBlock Text="输入调用参数" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                                    <ItemsControl x:Name="InputFields" ItemTemplate="{StaticResource TraceFieldRow}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource SubtleCardBorder}" Padding="13,11,13,5">
                                                <StackPanel>
                                                    <TextBlock Text="观测与执行结果" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                                    <ItemsControl x:Name="ResultFields" ItemTemplate="{StaticResource TraceFieldRow}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border x:Name="StagePanel" Style="{StaticResource SubtleCardBorder}" Padding="13,11,13,9" Margin="0,12,0,0">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock DockPanel.Dock="Right" Text="阶段耗时" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    <TextBlock Text="子阶段耗时瀑布图" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </DockPanel>
                                                <ItemsControl x:Name="StageList" ItemTemplate="{StaticResource TraceStageRow}"/>
                                            </StackPanel>
                                        </Border>

                                        <Expander x:Name="ReturnedTextPanel" Header="展开查看返回给模型的文本快照" Style="{StaticResource TraceExpander}" Margin="0,10,0,2" FontSize="12" FontWeight="Medium">
                                            <TextBox x:Name="ReturnedText" TextWrapping="Wrap" IsReadOnly="True" Padding="12,10"
                                                     VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                                     FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="11.5"
                                                     Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource HairlineBrush}" Margin="0,6,0,0"/>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>

                                <TextBox x:Name="PayloadText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Visibility="Collapsed"
                                         VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                                         Padding="14,12" BorderThickness="0" Background="{DynamicResource SurfaceMutedBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
