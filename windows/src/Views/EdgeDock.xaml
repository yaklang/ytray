<Window x:Class="YTray.Views.EdgeDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTrayEdge" Width="30" Height="112"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Grid x:Name="RootGrid" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
          MouseLeftButtonDown="OnMouseLeftDown" MouseLeftButtonUp="OnMouseLeftUp"
          MouseMove="OnMouseMove" MouseRightButtonUp="OnMouseRightUp">
        <!-- 橙色贴边标签条 -->
        <Border x:Name="TabStrip" Width="10" Height="76" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#F28B44" Opacity="0.85">
            <Border.Effect>
                <DropShadowEffect Color="#F28B44" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
        </Border>
        <!-- 三个圆点 -->
        <StackPanel x:Name="DotsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Ellipse Width="3" Height="3" Fill="White" Margin="0,4"/>
            <Ellipse Width="3" Height="3" Fill="White" Margin="0,4"/>
            <Ellipse Width="3" Height="3" Fill="White" Margin="0,4"/>
        </StackPanel>
    </Grid>
</Window>