<Window x:Class="YTray.Views.EdgeDock"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTrayEdge" Width="28" Height="108"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Grid x:Name="RootGrid"
          MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
          MouseLeftButtonDown="OnMouseLeftDown" MouseLeftButtonUp="OnMouseLeftUp"
          MouseMove="OnMouseMove" MouseRightButtonUp="OnMouseRightUp">
        <Border x:Name="TabStrip" Width="9" Height="72" CornerRadius="5"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="{StaticResource BrandOrangeBrush}" Opacity="0.9">
            <Border.Effect>
                <DropShadowEffect Color="#55F2823D" BlurRadius="7" ShadowDepth="0" Opacity="0.55"/>
            </Border.Effect>
            <StackPanel x:Name="DotsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                <Ellipse Width="3" Height="3" Fill="White" Margin="0,2"/>
                <Ellipse Width="3" Height="3" Fill="White" Margin="0,2"/>
                <Ellipse Width="3" Height="3" Fill="White" Margin="0,2"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
