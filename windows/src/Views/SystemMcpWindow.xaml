<Window x:Class="YTray.Views.SystemMcpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTray · MCP 接入与函数" Width="920" Height="680" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="McpAction" TargetType="Button" BasedOn="{StaticResource YTrayButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="McpPrimaryAction" TargetType="Button" BasedOn="{StaticResource YTrayPrimaryButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="McpCopyChipButton" TargetType="Button" BasedOn="{StaticResource YTrayGhostButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrandOrangeBrush}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout" Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Studio Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource BrandPaleBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Path Data="M 3 2.5 L 13 2.5 L 13 6.5 L 3 6.5 Z M 3 9.5 L 13 9.5 L 13 13.5 L 3 13.5 Z M 5 4.5 L 5.1 4.5 M 5 11.5 L 5.1 11.5"
                      Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource BrandOrangeBrush}" StrokeThickness="1.5" Fill="Transparent"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="电脑控制 MCP 接入与函数目录" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="HeaderSubtitle" Text="查阅当前电脑控制服务暴露的标准工具、中文能力说明与 JSON Schema 输入约束"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Compact Connection & Endpoint Bar -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceBorder}" Background="{DynamicResource SurfaceRaisedBrush}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource CodeBadgeBorder}" Padding="9,3" VerticalAlignment="Center">
                            <TextBlock x:Name="EndpointText" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock x:Name="ConnectionHint" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="电脑控制设置" Click="Settings_Click" Style="{StaticResource McpAction}" Margin="0,0,8,0"/>
                    <Button x:Name="CopyConfigButton" Content="复制电脑控制配置" Click="CopyConfig_Click" Style="{StaticResource McpPrimaryAction}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Master-Detail Tool Reference -->
        <Grid x:Name="ToolColumns" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" MinWidth="190"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Tool Catalog -->
            <Border Style="{StaticResource SurfaceBorder}" Background="{DynamicResource SurfaceRaisedBrush}" Padding="8,12,8,8" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="8,0,8,10">
                        <Border DockPanel.Dock="Right" Style="{StaticResource PillBadge}" Background="{DynamicResource SurfaceMutedBrush}">
                            <TextBlock x:Name="ToolCountText" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <TextBlock x:Name="ToolListTitle" Text="可用工具" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="ToolList" Grid.Row="1" SelectionChanged="Tool_Selected"
                             Background="{DynamicResource SurfaceRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderThickness="0" ItemContainerStyle="{DynamicResource YTrayControlListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding CategoryTag}" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Column: Function Signature & JSON Schema Viewer -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}" Background="{DynamicResource SurfaceRaisedBrush}" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="CopyToolNameButton" DockPanel.Dock="Right" Content="复制函数名" Click="CopyToolName_Click"
                                    Style="{StaticResource McpCopyChipButton}" VerticalAlignment="Center"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ToolTitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Style="{StaticResource PillBadge}" Background="{DynamicResource BrandPaleBrush}" VerticalAlignment="Center">
                                    <TextBlock x:Name="ToolNameText" FontSize="11.5" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource BrandOrangeBrush}"/>
                                </Border>
                            </WrapPanel>
                        </DockPanel>
                        <TextBlock x:Name="ToolSummaryText" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19"/>
                    </StackPanel>

                    <Border Grid.Row="1" x:Name="SchemaHintBorder" Style="{StaticResource SubtleCardBorder}" Padding="11,7" Margin="0,10,0,0">
                        <TextBlock x:Name="SchemaHintText" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <DockPanel Grid.Row="2" Margin="0,12,0,6">
                        <Button x:Name="CopySchemaButton" DockPanel.Dock="Right" Content="复制 Schema" Click="CopySchema_Click" Style="{StaticResource McpCopyChipButton}"/>
                        <TextBlock Text="JSON Schema 输入参数定义" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBox Grid.Row="3" x:Name="SchemaTextBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                             VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                             Padding="13,10" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource HairlineBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="FooterHint" Grid.Row="3" Text="安全提示：连接配置内含本机会话访问凭据，请仅导入可信 MCP 客户端；关闭电脑控制总开关后旧凭据立即失效。"
                   FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="2,12,2,0"/>
    </Grid>
</Window>
