<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF owns the process DPI mode through app.manifest, including native input coordinates. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>YTray</AssemblyName>
    <RootNamespace>YTray</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>Assets\Icons\ytray-app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <YTrayVersion Condition="'$(YTrayVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\VERSION').Trim())</YTrayVersion>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <WinSparkleArchitecture Condition="'$(PlatformTarget)' == 'x86'">Win32</WinSparkleArchitecture>
    <WinSparkleArchitecture Condition="'$(WinSparkleArchitecture)' == ''">x64</WinSparkleArchitecture>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Resource Include="Assets\Icons\*.ico" />
    <EmbeddedResource Include="Assets\BundledExtension\yakit-browser-agent.zip" Condition="Exists('Assets\BundledExtension\yakit-browser-agent.zip')" />
    <EmbeddedResource Include="Assets\BundledExtension\bundled-extension.json" Condition="Exists('Assets\BundledExtension\bundled-extension.json')" />
    <EmbeddedResource Include="..\resources\cua-driver\runtime-manifest.json" LogicalName="YTray.CuaDriverManifest" />
    <EmbeddedResource Include="..\resources\cua-driver\tools-0.38.0.json" LogicalName="YTray.CuaDriverTools" />
    <EmbeddedResource Include="..\resources\dotnet\Runtime-LICENSE.txt" LogicalName="YTray.DotNetRuntimeLicense" />
    <EmbeddedResource Include="..\resources\dotnet\Desktop-LICENSE.txt" LogicalName="YTray.DotNetDesktopLicense" />
    <EmbeddedResource Include="..\resources\dotnet\THIRD-PARTY-NOTICES.txt" LogicalName="YTray.DotNetThirdPartyNotices" />
    <EmbeddedResource Include="..\.dependencies\cua-driver-0.38.0\driver.zip" Condition="Exists('..\.dependencies\cua-driver-0.38.0\driver.zip')" LogicalName="YTray.CuaDriverArchive" />
    <EmbeddedResource Include="..\.dependencies\WinSparkle-0.9.4\$(WinSparkleArchitecture)\Release\WinSparkle.dll" LogicalName="YTray.WinSparkle" />
    <EmbeddedResource Include="..\.dependencies\WinSparkle-0.9.4\COPYING" LogicalName="YTray.WinSparkleLicense" />
    <EmbeddedResource Include="..\.dependencies\WinSparkle-0.9.4\COPYING.expat" LogicalName="YTray.ExpatLicense" />
    <EmbeddedResource Include="..\..\resources\updates\ed25519-public-key.txt" LogicalName="YTray.UpdatePublicKey" />
  </ItemGroup>
  <Target Name="GenerateYTrayVersionAttribute" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_YTrayVersionAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute"><_Parameter1>$(YTrayVersion)</_Parameter1></_YTrayVersionAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" OutputFile="$(IntermediateOutputPath)YTrayVersion.g.cs" AssemblyAttributes="@(_YTrayVersionAttribute)"><Output TaskParameter="OutputFile" ItemName="Compile" /></WriteCodeFragment>
  </Target>
</Project>
