<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <BaseOutputPath>bin/$(PlatformTarget)/</BaseOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DefaultItemExcludes>$(DefaultItemExcludes);ControlFixture/**;ControlWorkerFixture/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="..\src\YTray.csproj" />
    <Content Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\VERSION" Link="repository-version.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
