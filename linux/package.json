{
  "name": "ytray-linux",
  "productName": "YTray",
  "version": "0.2.7",
  "description": "多身份浏览器实例工作台（Linux / Electron）",
  "main": "./out/main/index.js",
  "desktopName": "ytray.desktop",
  "author": "Yaklang",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder --linux AppImage",
    "package:dir": "npm run build && electron-builder --linux dir",
    "smoke:ui": "npm run build && YTRAY_SMOKE_UI=./dist/ui-smoke.png electron --no-sandbox .",
    "sync-version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "ws": "^8.22.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
